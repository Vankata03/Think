    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Think запазва картички с мисли и тапети в библиотеката ти със снимки."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think saves quote cards and wallpapers to your photo library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Think speichert Zitatkarten und Hintergrundbilder in deiner Fotobibliothek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Think guarda tarjetas con citas y fondos de pantalla en tu galería de fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Think enregistre des cartes de citations et des fonds d'écran dans ta photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Think salva le schede con le citazioni e gli sfondi nella tua galleria fotografica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Think salva cartões com citações e papéis de parede na sua galeria de fotos."
          }
        }
      }
    }
  },
  "version": "1.0"
