    "%@ of deliberate thinking with Think — one honest question a day." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ съзнателно мислене с Think — по един честен въпрос на ден."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bewusstes Nachdenken mit Think – eine ehrliche Frage pro Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Disfruta de la reflexión consciente con Think: una pregunta sincera al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de réflexion délibérée avec Think — une question sincère par jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Il pensiero consapevole con Think: una domanda sincera al giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pense de forma consciente com o Think — uma pergunta sincera por dia."
          }
        }
      }
    },
