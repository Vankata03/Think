    },
    "Tap + and choose Custom. Name it Deep Work." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосни + и избери Персонализиран. Назови го „Дълбока работа“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „+“ und wähle „Benutzerdefiniert“. Nenne sie „Deep Work“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa en el signo «+» y elige «Personalizada». Llámala «Deep Work»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie sur + et choisis « Personnalisé ». Appelle-la « Deep Work »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il segno \"+\" e scegli \"Personalizza\". Chiamala \"Deep Work\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + e escolha “Personalizado”. Dê a ele o nome de “Deep Work”."
          }
        }
      }
    },
    "Tap +, choose App, pick Think, select Is Opened." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосни +, избери Приложение, посочи Think и избери „При отваряне“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „+“, wähle „App“, wähle „Think“ aus und wähle „Ist geöffnet“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa +, elige «Aplicación», selecciona «Think» y marca «Está abierta»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie sur +, choisis « App », sélectionne « Think », puis « Est ouverte »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca +, scegli App, seleziona Think, poi seleziona \"È aperta\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em +, escolha “App”, selecione o Think e marque “Está aberto”."
          }
        }
      }
    },
    "Task" : {
