    "Entries stay on this device. Think has no server and no account." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записите остават на това устройство. Think няма сървър и няма акаунт."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Einträge bleiben auf diesem Gerät. Think hat keinen Server und kein Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus entradas se quedan en este dispositivo. Think no tiene servidor ni cuenta."
