    "History covers the last 365 days. All-time totals are retained. Older actual durations are unknown." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Историята обхваща последните 365 дни. Общите суми за цялото време се запазват. По-старите реални продължителности са неизвестни."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Verlauf umfasst die letzten 365 Tage. Gesamtsummen bleiben erhalten. Ältere tatsächliche Dauern sind unbekannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History covers the last 365 days. All-time totals are retained. Older actual durations are unknown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El historial cubre los últimos 365 días. Los totales de todos los tiempos se conservan. Las duraciones reales más antiguas son desconocidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'historique couvre les 365 derniers jours. Les totaux depuis le début sont conservés. Les durées réelles plus anciennes sont inconnues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La cronologia copre gli ultimi 365 giorni. I totali complessivi vengono conservati. Le durate effettive più vecchie sono sconosciute."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O histórico cobre os últimos 365 dias. Os totais desde o início são mantidos. Durações reais mais antigas são desconhecidas."
          }
        }
      }
    },
