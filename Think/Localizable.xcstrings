          }
        }
      }
    },
    "Think is a short daily practice, not a feed. A few honest minutes, every day." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Think е кратка ежедневна практика, не поток от съдържание. Няколко честни минути, всеки ден."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Think ist eine kurze tägliche Praxis, kein Feed. Ein paar ehrliche Minuten, jeden Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Think es una breve práctica diaria, no un feed. Unos minutos sinceros, cada día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Think, c'est un petit exercice quotidien, pas un fil d'actualité. Quelques minutes en toute sincérité, tous les jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Think è una breve pratica quotidiana, non un feed. Qualche minuto di sincerità, ogni giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Think é uma prática diária curta, não um feed. Alguns minutos sinceros, todos os dias."
          }
        }
      }
    },
