    "This session is temporary. Saved entries will be lost when Think closes." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тази сесия е временна. Запазените записи ще бъдат загубени, когато Think се затвори."
          }
        },
        "de" : {
          "stringUnit" : {
