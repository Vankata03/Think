    "Add the action Set Focus, choose Deep Work, and set Run Immediately." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добави действието „Задаване на режим на фокус“, избери „Дълбока работа“ и включи „Изпълнявай веднага“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Aktion „Fokus festlegen“ hinzu, wähle „Deep Work“ und aktiviere „Sofort ausführen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la acción «Establecer concentración», elige «Trabajo profundo» y marca «Ejecutar inmediatamente»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute l’action « Définir le mode de concentration », choisis « Concentration profonde » et active l’exécution immédiate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi l’azione “Set Focus”, scegli “Deep Work” e imposta “Esegui subito”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a ação “Definir foco”, escolha “Trabalho Profundo” e marque “Executar imediatamente”."
          }
        }
      }
    },
