    "Counts cover this calendar week only. Completed minutes use planned session lengths; partial effort is active time from sessions ended early." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts cover this calendar week only. Completed minutes use planned session lengths; partial effort is active time from sessions ended early."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Броячите обхващат само тази календарна седмица. Завършените минути използват планираната дължина на сесиите; частичното усилие е активното време от сесии, прекратени по-рано."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Zahlen beziehen sich nur auf diese Kalenderwoche. Abgeschlossene Minuten verwenden die geplante Sitzungslänge; Teilaufwand ist die aktive Zeit aus vorzeitig beendeten Sitzungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los recuentos cubren solo esta semana natural. Los minutos completados usan la duración planificada de la sesión; el esfuerzo parcial es el tiempo activo de las sesiones terminadas antes de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les compteurs couvrent uniquement cette semaine civile. Les minutes terminées utilisent la durée prévue des sessions ; l'effort partiel correspond au temps actif des sessions arrêtées avant la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I conteggi riguardano solo questa settimana di calendario. I minuti completati usano le durate pianificate delle sessioni; l'impegno parziale è il tempo attivo delle sessioni terminate in anticipo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As contagens cobrem apenas esta semana do calendário. Os minutos concluídos usam a duração planejada das sessões; o esforço parcial é o tempo ativo de sessões encerradas antes do fim."
          }
        }
      }
    },
