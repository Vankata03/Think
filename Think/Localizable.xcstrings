    "Categories, not a score. An entry either carries one of these tags or stays untagged." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Категории, а не оценка. Всеки запис или носи един от тези етикети, или остава без етикет."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kategorien, keine Bewertung. Ein Eintrag trägt entweder eines dieser Tags oder bleibt ohne Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categories, not a score. An entry either carries one of these tags or stays untagged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Son categorías, no una puntuación. Una entrada lleva una de estas etiquetas o se queda sin etiquetar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce sont des catégories, pas une note. Une entrée porte l'une de ces étiquettes ou reste sans étiquette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Categorie, non un punteggio. Una voce porta uno di questi tag oppure resta senza tag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Categorias, não uma pontuação. Uma entrada recebe uma dessas etiquetas ou fica sem etiqueta."
          }
        }
      }
    },
    "Change times and switches later in Settings, behind the gear on Progress." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Промени часовете и превключвателите по-късно в Настройки, зад зъбното колело в Напредък."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeiten und Schalter kannst du später in den Einstellungen ändern, hinter dem Zahnrad unter Fortschritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cambia las horas y los interruptores más tarde en Ajustes, tras el engranaje de Progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
