    "Drafts stay on this device until you save or discard them. Opening one continues it with its original day and prompt." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Черновите остават на това устройство, докато не ги запазите или отхвърлите. Отварянето на чернова я продължава с първоначалния ѝ ден и въпрос."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entwürfe bleiben auf diesem Gerät, bis du sie speicherst oder verwirfst. Beim Öffnen wird ein Entwurf mit seinem ursprünglichen Tag und seiner Frage fortgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drafts stay on this device until you save or discard them. Opening one continues it with its original day and prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los borradores permanecen en este dispositivo hasta que los guardes o los descartes. Al abrir uno, se continúa con su día y su pregunta originales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les brouillons restent sur cet appareil jusqu'à ce que vous les enregistriez ou les abandonniez. En ouvrir un permet de le poursuivre avec son jour et sa question d'origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le bozze restano su questo dispositivo finché non le salvi o le scarti. Aprendone una, la riprendi con il giorno e lo spunto originali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os rascunhos ficam neste dispositivo até você salvá-los ou descartá-los. Ao abrir um, você o continua com o dia e o tema originais."
          }
        }
      }
    },
