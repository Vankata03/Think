    "A few honest minutes. What you write stays on your device, and syncs through your own iCloud when available." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Няколко честни минути. Написаното остава на устройството ти и се синхронизира през твоя iCloud, когато е възможно."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein paar ehrliche Minuten. Was du schreibst, bleibt auf deinem Gerät und wird, wenn möglich, über dein eigenes iCloud synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unos minutos sinceros. Lo que escribes se queda en tu dispositivo y se sincroniza con tu propio iCloud cuando está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quelques minutes sincères. Ce que tu écris reste sur ton appareil et se synchronise via ton propre iCloud lorsque c’est possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pochi minuti sinceri. Quello che scrivi resta sul tuo dispositivo e si sincronizza con il tuo iCloud quando disponibile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alguns minutos sinceros. O que você escreve fica no seu dispositivo e sincroniza pelo seu próprio iCloud quando disponível."
          }
        }
      }
    },
