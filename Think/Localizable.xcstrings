    "Journal changes, including deletions, sync through your own iCloud when available. Think has no server or account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journal changes, including deletions, sync through your own iCloud when available. Think has no server or account."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Промените в дневника, включително изтриванията, се синхронизират през вашия собствен iCloud, когато е наличен. Think няма сървър или акаунт."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Änderungen im Journal, einschließlich Löschungen, werden über deine eigene iCloud synchronisiert, sofern verfügbar. Think hat keinen Server und kein Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los cambios del diario, incluidas las eliminaciones, se sincronizan a través de tu propio iCloud cuando está disponible. Think no tiene servidor ni cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les modifications du journal, y compris les suppressions, se synchronisent via votre propre iCloud lorsqu'il est disponible. Think n'a ni serveur ni compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le modifiche al diario, comprese le eliminazioni, si sincronizzano tramite il tuo iCloud quando disponibile. Think non ha server né account."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As alterações no diário, incluindo exclusões, sincronizam pelo seu próprio iCloud quando disponível. O Think não tem servidor nem conta."
          }
        }
      }
    },
