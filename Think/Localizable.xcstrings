    "The journal lock is unavailable on this device." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заключването на дневника не е достъпно на това устройство."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Journalsperre ist auf diesem Gerät nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo del diario no está disponible en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrouillage du journal n'est pas disponible sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco del diario non è disponibile su questo dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio do diário não está disponível neste dispositivo."
          }
        }
      }
    },
    "The reminder switches can stay on, but Think cannot schedule reminders until notifications are allowed in Settings." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превключвателите за напомнянията могат да останат включени, но Think не може да ги насрочи, докато не разрешиш известията в Настройки."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erinnerungsschalter können aktiviert bleiben, aber Think kann keine Erinnerungen planen, solange Mitteilungen in den Einstellungen nicht erlaubt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reminder switches can stay on, but Think cannot schedule reminders until notifications are allowed in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los interruptores de recordatorios pueden permanecer activados, pero Think no puede programar recordatorios hasta que permitas las notificaciones en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons de rappel peuvent rester activés, mais Think ne peut pas programmer de rappels tant que les notifications ne sont pas autorisées dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti dei promemoria possono restare attivi, ma Think non può programmare promemoria finché non abiliti le notifiche nelle Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os controles de lembrete podem continuar ativados, mas o Think não pode agendar lembretes até que você permita notificações nos Ajustes."
          }
        }
      }
    },
    "The time you've done so far is kept as partial effort." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Времето дотук се запазва като частично усилие."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die bisherige Zeit bleibt als Teilaufwand erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El tiempo que llevas se guarda como esfuerzo parcial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le temps déjà passé est conservé comme effort partiel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tempo svolto finora resta come impegno parziale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O tempo feito até agora fica salvo como esforço parcial."
          }
        }
      }
    },
    "The unsaved text is deleted from this device and cannot be recovered." : {
      "localizations" : {
