    "Close each day with two honest minutes. Your evening retrospectives will appear here." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завършвай всеки ден с две честни минути. Вечерните ти равносметки ще се появят тук."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe jeden Tag mit zwei ehrlichen Minuten ab. Deine Abendreflexionen erscheinen hier."
