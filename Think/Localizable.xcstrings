    "Health access is off. Allow Think to write mindful minutes in the Health app to use this setting." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достъпът до Здраве е изключен. Разреши на Think да записва минути за осъзнатост в приложението Здраве, за да използваш тази настройка."
          }
        },
        "de" : {
          "stringUnit" : {
