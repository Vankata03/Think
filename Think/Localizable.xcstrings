    "More than one version was written for %@, usually from two devices. All are kept; open one to edit or delete it." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За %@ е записана повече от една версия, обикновено от две устройства. Всички са запазени; отворете една от тях, за да я редактирате или изтриете."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für %@ wurde mehr als eine Version geschrieben, meist von zwei Geräten. Alle bleiben erhalten; öffne eine, um sie zu bearbeiten oder zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one version was written for %@, usually from two devices. All are kept; open one to edit or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se escribió más de una versión para %@, normalmente desde dos dispositivos. Todas se conservan; abre una para editarla o eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plus d'une version a été écrite pour %@, généralement depuis deux appareils. Toutes sont conservées ; ouvrez-en une pour la modifier ou la supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per %@ è stata scritta più di una versione, di solito da due dispositivi. Vengono conservate tutte; aprine una per modificarla o eliminarla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mais de uma versão foi escrita para %@, geralmente a partir de dois dispositivos. Todas são mantidas; abra uma delas para editá-la ou excluí-la."
          }
        }
      }
    },
