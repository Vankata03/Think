    "Tap + and choose Custom. Name it Deep Work." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосни + и избери Персонализиран. Назови го „Дълбока работа“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „+“ und wähle „Benutzerdefiniert“. Nenne sie „Deep Work“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa en el signo «+» y elige «Personalizada». Llámala «Deep Work»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie sur + et choisis « Personnalisé ». Appelle-la « Deep Work »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il segno \"+\" e scegli \"Personalizza\". Chiamala \"Deep Work\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + e escolha “Personalizado”. Dê a ele o nome de “Deep Work”."
          }
        }
      }
    },
    "Tap +, choose App, pick Think, select Is Opened." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докосни +, избери Приложение, посочи Think и избери „При отваряне“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „+“, wähle „App“, wähle „Think“ aus und wähle „Ist geöffnet“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa +, elige «Aplicación», selecciona «Think» y marca «Está abierta»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie sur +, choisis « App », sélectionne « Think », puis « Est ouverte »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca +, scegli App, seleziona Think, poi seleziona \"È aperta\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em +, escolha “App”, selecione o Think e marque “Está aberto”."
          }
        }
      }
    },
    "The path is intentionally small. Read, act, mark the day." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пътят е умишлено кратък. Прочети, действай, отбележи деня."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Weg ist bewusst klein. Lesen, handeln, den Tag abhaken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El camino es intencionadamente sencillo. Lee, actúa, deja huella en el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parcours est volontairement simple. Lis, agis, marque ta journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il percorso è volutamente semplice. Leggi, agisci, segna la giornata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O caminho é propositalmente simples. Lê, age, marca o dia."
          }
        }
      }
    },
    "The reminder switches can stay on, but Think cannot schedule reminders until notifications are allowed in Settings." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превключвателите за напомнянията могат да останат включени, но Think не може да ги насрочи, докато не разрешиш известията в Настройки."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erinnerungsschalter können aktiviert bleiben, aber Think kann keine Erinnerungen planen, solange Mitteilungen in den Einstellungen nicht erlaubt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reminder switches can stay on, but Think cannot schedule reminders until notifications are allowed in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los interruptores de recordatorios pueden permanecer activados, pero Think no puede programar recordatorios hasta que permitas las notificaciones en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons de rappel peuvent rester activés, mais Think ne peut pas programmer de rappels tant que les notifications ne sont pas autorisées dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti dei promemoria possono restare attivi, ma Think non può programmare promemoria finché non abiliti le notifiche nelle Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
