    "%@. One short lesson and one concrete task per day, ten minutes at most." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Един кратък урок и една конкретна задача на ден — най-много десет минути."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Eine kurze Lektion und eine konkrete Aufgabe pro Tag, höchstens zehn Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Una lección breve y una tarea concreta al día, diez minutos como mucho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Une petite leçon et une tâche concrète par jour, dix minutes tout au plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Una breve lezione e un compito concreto al giorno, al massimo dieci minuti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Uma lição curta e uma tarefa concreta por dia, no máximo dez minutos."
          }
        }
      }
    },
