    "How was the day? Close it honestly before it closes on you." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как мина денят? Завърши го честно, преди той да приключи с теб."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie war der Tag? Schließ ihn ehrlich ab, bevor er sich ohne dich schließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué tal te ha ido el día? Cierra este capítulo con sinceridad antes de que se te escape de las manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment s'est passée ta journée ? Fais le point en toute honnêteté avant qu'elle ne s'achève."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com'è andata la giornata? Chiudila in modo sincero prima che sia troppo tardi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como foi o dia? Encerre-o com sinceridade antes que ele termine por conta própria."
          }
        }
      }
    },
