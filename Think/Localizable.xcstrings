    "Health access is off. Allow Think to write mindful minutes in the Health app to use this setting." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достъпът до Здраве е изключен. Разреши на Think да записва минути за осъзнатост в приложението Здраве, за да използваш тази настройка."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Health-Zugriff ist deaktiviert. Erlaube Think in der Health-App, Achtsamkeitsminuten zu schreiben, um diese Einstellung zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health access is off. Allow Think to write mindful minutes in the Health app to use this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a Salud está desactivado. Permite que Think registre minutos de atención plena en la app Salud para usar este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à Santé est désactivé. Autorise Think à enregistrer des minutes de pleine conscience dans l’app Santé pour utiliser ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso a Salute è disattivato. Consenti a Think di registrare minuti di mindfulness nell’app Salute per usare questa impostazione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao app Saúde está desativado. Permita que o Think registre minutos de atenção plena no app Saúde para usar este ajuste."
          }
        }
      }
    },
