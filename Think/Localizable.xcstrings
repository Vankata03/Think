    "More than one retrospective exists for today. Choose one to edit; the others are kept and can be opened from the journal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one retrospective exists for today. Choose one to edit; the others are kept and can be opened from the journal."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За днес има повече от една ретроспекция. Изберете една за редактиране; останалите са запазени и могат да бъдат отворени от дневника."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für heute gibt es mehr als eine Retrospektive. Wähle eine zum Bearbeiten; die anderen bleiben erhalten und lassen sich im Journal öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Existe más de una retrospectiva para hoy. Elige una para editarla; las demás se conservan y se pueden abrir desde el diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il existe plus d'une rétrospective pour aujourd'hui. Choisissez-en une à modifier ; les autres sont conservées et peuvent être ouvertes depuis le journal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per oggi esiste più di una retrospettiva. Scegline una da modificare; le altre vengono conservate e possono essere aperte dal diario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Existe mais de uma retrospectiva para hoje. Escolha uma para editar; as outras são mantidas e podem ser abertas no diário."
          }
        }
      }
    },
    "More than one version was written for %@, usually from two devices. All are kept; open one to edit or delete it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one version was written for %@, usually from two devices. All are kept; open one to edit or delete it."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За %@ е записана повече от една версия, обикновено от две устройства. Всички са запазени; отворете една от тях, за да я редактирате или изтриете."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für %@ wurde mehr als eine Version geschrieben, meist von zwei Geräten. Alle bleiben erhalten; öffne eine, um sie zu bearbeiten oder zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se escribió más de una versión para %@, normalmente desde dos dispositivos. Todas se conservan; abre una para editarla o eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plus d'une version a été écrite pour %@, généralement depuis deux appareils. Toutes sont conservées ; ouvrez-en une pour la modifier ou la supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per %@ è stata scritta più di una versione, di solito da due dispositivi. Vengono conservate tutte; aprine una per modificarla o eliminarla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mais de uma versão foi escrita para %@, geralmente a partir de dois dispositivos. Todas são mantidas; abra uma delas para editá-la ou excluí-la."
          }
        }
      }
    },
