    "practice.052.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мнение, наследено незабелязано, пак управлява живота ти."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An opinion inherited unnoticed still directs your life."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Meinung, die du unbemerkt übernommen hast, bestimmt immer noch dein Leben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una opinión que has heredado sin darte cuenta sigue marcando el rumbo de tu vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opinion que tu as héritée sans t'en rendre compte continue de diriger ta vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’opinione che hai assimilato senza accorgertene continua a guidare la tua vita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma opinião que você herdou sem perceber ainda guia a sua vida."
          }
        }
      }
    },
    "practice.052.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое правило следваш, без да помниш, че си го избрал?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which rule do you follow without remembering choosing it?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Regel befolgst du, ohne dich daran zu erinnern, sie gewählt zu haben?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué norma sigues sin recordar haberla elegido?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle règle suis-tu sans te souvenir de l'avoir choisie ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale regola segui senza ricordarti di averla scelta?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual regra você segue sem se lembrar de ter escolhido?"
          }
        }
      }
    },
    "practice.053.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови едно свое мнение, което държиш временно, не завинаги."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name one current view you hold provisionally rather than permanently."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne eine aktuelle Ansicht, die du eher vorläufig als dauerhaft vertrittst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra una opinión que tengas ahora mismo de forma provisional, en lugar de definitiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cite une opinion que tu as en ce moment, mais que tu considères comme provisoire plutôt que définitive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un punto di vista che al momento hai in mente in modo provvisorio, piuttosto che definitivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cita uma opinião que você tenha no momento, que seja provisória e não definitiva."
          }
        }
      }
    },
