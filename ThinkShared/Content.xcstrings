        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which idea have you collected without testing?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Idee hast du gesammelt, ohne sie zu testen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué idea has recogido sin probarla?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle idée as-tu retenue sans l'avoir testée ?"
          }
