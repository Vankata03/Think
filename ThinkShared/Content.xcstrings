    "practice.045.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Но ако е правилно, защо се страхуваш от онези, които ще го осъдят несправедливо?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es aber richtig ist – warum fürchtest du dich vor denen, die es zu Unrecht tadeln?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "But if it is right, why are you afraid of those who shall find fault wrongly?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pero si tienes razón, ¿por qué te da miedo que haya gente que te critique sin motivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais si c’est juste, pourquoi crains-tu ceux qui le critiqueront à tort ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma se è giusto, perché temi chi lo criticherà a torto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas se está certo, por que você tem medo daqueles que vão criticar sem motivo?"
          }
        }
      }
    },
    "practice.045.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое правилно действие криеш, за да избегнеш осъждане?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche richtige Handlung verbirgst du, um nicht bewertet zu werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which right action are you hiding to avoid being judged?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué acción correcta estás ocultando para evitar que te juzguen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle bonne action caches-tu pour éviter d’être jugé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale azione giusta stai nascondendo per evitare di essere giudicato?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que ação correta você está escondendo para não ser julgado?"
          }
        }
      }
    },
    "practice.046.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши учтивия отказ, дори ако още не го изпращаш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formuliere das höfliche Nein, auch wenn du es noch nicht absendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft the respectful no, even if you do not send it yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacta un «no» respetuoso, aunque todavía no lo envíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédige un « non » respectueux, même si tu ne l'envoies pas tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un “no” rispettoso, anche se per ora non lo invii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva um “não” respeitoso, mesmo que ainda não vá enviá-lo."
          }
        }
      }
    },
