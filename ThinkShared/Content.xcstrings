    "practice.060.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Любопитството започва там, където свършва нуждата да изглеждаш информиран."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curiosity begins where the need to look informed ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neugier beginnt dort, wo das Bedürfnis, informiert zu wirken, endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La curiosidad empieza donde acaba la necesidad de parecer informado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La curiosité commence là où s'arrête le besoin de paraître informé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La curiosità inizia dove finisce il bisogno di sembrare informati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A curiosidade começa onde termina a necessidade de parecer informado."
          }
        }
      }
    },
    "practice.060.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво би попитал, ако не пазеше образа си?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you ask if you were not protecting your image?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was würdest du fragen, wenn du nicht auf dein Image achten müsstest?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué preguntarías si no estuvieras preocupándote por tu imagen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que demanderais-tu si tu n'avais pas à te soucier de ton image ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa chiederesti se non dovessi preoccuparti della tua immagine?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você perguntaria se não estivesse preocupado em proteger sua imagem?"
          }
        }
      }
    },
    "practice.061.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
