        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What reality are you spending energy refusing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué realidad estás rechazando con tanto empeño?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle réalité refuses-tu au prix de ton énergie ?"
