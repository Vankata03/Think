            "state": "translated",
            "value": "Cosa stai aspettando per sentirti pronto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você tá esperando pra se sentir pronto?"
          }
        }
      }
    },
    "practice.019.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи днешното повторение и не измервай резултата до утре."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu die heutige Wiederholung und lass das Ergebnis bis morgen ungemessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do today's repetition and leave the outcome unmeasured until tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz la repetición de hoy y deja el resultado sin evaluar hasta mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais l'exercice du jour et ne t'inquiète pas du résultat avant demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai l’esercizio di oggi e lascia che sia domani a giudicare il risultato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a repetição de hoje e deixe o resultado de lado até amanhã."
          }
        }
      }
    },
