    "practice.035.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можеш да пазиш всички варианти отворени и все пак да избереш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nicht alle Optionen offenhalten und trotzdem wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot protect every option and still choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes quedarte con todas las opciones y seguir eligiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne peux pas tout garder et quand même faire un choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi proteggere ogni opzione e continuare a scegliere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não dá pra proteger todas as opções e ainda assim escolher."
          }
        }
      }
    },
    "practice.035.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое решение остава нерешено, защото затварянето на врати ти изглежда като загуба?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Entscheidung hältst du offen, weil das Schließen von Türen sich wie Verlust anfühlt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which decision stays open because closing doors feels like loss?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué decisión sigues sin tomar porque cerrar puertas te parece una pérdida?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle décision restes-tu indécis à prendre, parce que fermer des portes te donne l'impression de perdre quelque chose ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale decisione lasci in sospeso perché chiudere delle porte ti sembra una perdita?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual decisão ainda está em aberto porque fechar portas parece uma perda?"
          }
        }
      }
    },
    "practice.036.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови я без одобрение или оплакване, после избери как да реагираш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenn es ohne Zustimmung oder Klage – dann wähle deine Reaktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State it without approval or complaint, then choose your response."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exprésalo sin juzgar ni quejarte, y luego elige tu respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Énonce-la sans l’approuver ni t’en plaindre, puis choisis ta réponse."
