    "practice.070.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какъв човек ставаш, зависи и от цената, която спираш да прехвърляш на другите."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer du wirst, hängt auch davon ab, welchen Preis du aufhörst, andere zahlen zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who you become is partly the cost you stop making others pay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En parte, en quién te conviertes depende de lo que dejes de hacer pagar a los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne que tu deviens, c'est en partie le prix que tu cesses de faire payer aux autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona che diventi dipende in parte dal prezzo che smetti di far pagare agli altri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem você se torna depende, em parte, do preço que você deixa de cobrar dos outros."
          }
        }
      }
    },
    "practice.070.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой твой навик създава работа, тревога или мълчание за някой друг?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche deiner Gewohnheiten schafft Arbeit, Sorgen oder Schweigen für jemand anderen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which of your patterns creates work, worry, or silence for someone else?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál de tus hábitos genera trabajo, preocupación o silencio para otra persona?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lequel de tes schémas de comportement est source de travail, d'inquiétude ou de silence pour quelqu'un d'autre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale dei tuoi schemi crea lavoro, preoccupazione o silenzio per qualcun altro?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual dos seus padrões gera trabalho, preocupação ou silêncio para outra pessoa?"
          }
        }
      }
    },
    "practice.071.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дай един ясен отговор, преди негодуванието да отговори вместо теб."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine klare Antwort, bevor der Groll es für dich tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give one clear answer before resentment gives it for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da una respuesta clara antes de que el resentimiento lo haga por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne une réponse claire avant que le ressentiment ne le fasse à ta place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai una risposta chiara prima che sia il risentimento a farlo al posto tuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma resposta clara antes que o ressentimento responda por você."
          }
        }
      }
    },
