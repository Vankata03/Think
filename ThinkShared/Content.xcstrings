    "path.deep-focus.step.9.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко известие е чужд план за вниманието ти."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every notification is someone else scheduling your attention."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Benachrichtigung ist jemand anderes, der deine Aufmerksamkeit plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada notificación es alguien que te está quitando tiempo para otras cosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque notification, c'est quelqu'un d'autre qui programme ton attention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni notifica è qualcuno che cerca di attirare la tua attenzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada notificação é alguém tentando chamar sua atenção."
          }
        }
      }
    },
    "path.deep-focus.step.9.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spend five minutes reviewing notifications. Keep the alerts you need and silence one unnecessary source."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прегледай известията за пет минути. Запази нужните и заглуши един ненужен източник."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüfe deine Mitteilungen fünf Minuten lang. Behalte nötige Hinweise und schalte eine unnötige Quelle stumm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revisa las notificaciones durante cinco minutos. Conserva las necesarias y silencia una fuente innecesaria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Examine tes notifications pendant cinq minutes. Garde les alertes nécessaires et coupe une source inutile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rivedi le notifiche per cinque minuti. Tieni quelle necessarie e silenzia una fonte inutile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revise as notificações por cinco minutos. Mantenha os alertas necessários e silencie uma fonte desnecessária."
          }
        }
      }
    },
