    "practice.092.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Годината се променя на нивото на обикновените вторници."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A year changes at the level of ordinary Tuesdays."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Jahr verändert sich im Rhythmus ganz normaler Dienstage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un año cambia en los martes más normales y corrientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une année, ça change au fil des mardis ordinaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anno cambia anche nei semplici martedì di sempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ano passa, mesmo nas terças-feiras mais comuns."
          }
        }
      }
    },
    "practice.092.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво поведение в обикновения ден би направило годината различна?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What ordinary-day behavior would make the year different?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Verhalten im Alltag würde dieses Jahr anders machen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué comportamiento en tu día a día haría que este año fuera diferente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel comportement au quotidien pourrait changer le cours de cette année ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale comportamento quotidiano potrebbe rendere quest’anno diverso?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que comportamento cotidiano tornaria este ano diferente?"
          }
        }
      }
    },
    "practice.093.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери едно нещо и му дай следващите десет непрекъснати минути."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one thing and give it the next uninterrupted ten minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such dir eine Sache aus und widme ihr die nächsten zehn Minuten ununterbrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una cosa y dedícale los próximos diez minutos sin interrupciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une chose et consacre-lui les dix prochaines minutes sans interruption."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cosa e dedicale i prossimi dieci minuti senza interruzioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma coisa e dedique a ela os próximos dez minutos sem interrupções."
          }
        }
      }
    },
