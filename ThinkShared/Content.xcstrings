    "path.deep-focus.step.20.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Планираното утро не отстъпва пред разсейванията."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A planned morning doesn't negotiate with distractions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gut geplanter Morgen lässt sich nicht von Ablenkungen aus der Bahn werfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mañana bien planificada no se deja llevar por las distracciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une matinée bien planifiée ne laisse pas de place aux distractions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mattinata ben pianificata non scende a compromessi con le distrazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma manhã bem planejada não dá espaço para distrações."
          }
        }
      }
    },
    "path.deep-focus.step.20.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази вечер запиши единствения приоритет за утре и кога ще го направиш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight, write down tomorrow's single priority and when you'll do it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib heute Abend die wichtigste Aufgabe für morgen auf und wann du sie erledigen wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta noche, anota cuál será tu única prioridad de mañana y cuándo la harás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce soir, note ta priorité unique pour demain et à quel moment tu vas t'y mettre."
