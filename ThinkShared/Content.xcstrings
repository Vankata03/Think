    "practice.094.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Цел без изваждане е просто желание за допълнителни часове."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A goal without a subtraction is a wish for extra hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ziel ohne Verzicht ist der Wunsch nach zusätzlichen Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objetivo sin sacrificar nada es como desear tener más horas al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objectif sans renoncement, c'est juste un souhait d'avoir plus d'heures dans la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un obiettivo senza rinunce è solo il desiderio di avere più tempo a disposizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma meta sem uma redução é só um desejo de ter mais tempo."
          }
        }
      }
    },
    "practice.094.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На какво ще отделяш по-малко време, ако тази цел е истинска?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What will receive less time if this goal is real?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür wirst du weniger Zeit haben, wenn dieses Ziel Wirklichkeit wird?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué le dedicarás menos tiempo si este objetivo se hace realidad?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi vas-tu consacrer moins de temps si cet objectif se concrétise ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A cosa dedicherai meno tempo se questo obiettivo diventasse realtà?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que vai ficar de lado se essa meta se tornar realidade?"
          }
        }
      }
    },
    "practice.095.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи една стъпка, докато човекът, здравето, достъпът или сезонът са все още тук."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take one step while the person, health, access, or season is still here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen Schritt, solange die Person, die Gesundheit, die Möglichkeit oder die Jahreszeit noch da ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un paso mientras la persona, la salud, el acceso o la estación aún estén ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un pas tant que la personne, la santé, l'accès ou la saison sont encore là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un passo finché la persona, la salute, l’accesso o la stagione sono ancora qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá um passo enquanto a pessoa, a saúde, o acesso ou a estação ainda estiverem por aqui."
          }
        }
      }
    },
