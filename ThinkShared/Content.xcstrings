    "path.clear-thinking.step.2.lesson": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Control is rarely all or nothing. You may influence a small part of a difficult situation without being responsible for the whole outcome."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Контролът рядко е всичко или нищо. Може да повлияете на малка част от трудна ситуация, без да носите отговорност за целия резултат."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrolle ist selten alles oder nichts. Du kannst einen kleinen Teil einer schwierigen Situation beeinflussen, ohne für das ganze Ergebnis verantwortlich zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El control rara vez es todo o nada. Puedes influir en una pequeña parte de una situación difícil sin ser responsable de todo el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le contrôle est rarement tout ou rien. Vous pouvez influencer une petite partie d'une situation difficile sans être responsable de l'ensemble du résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il controllo raramente è tutto o niente. Puoi influenzare una piccola parte di una situazione difficile senza essere responsabile dell'intero risultato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O controle raramente é tudo ou nada. Você pode influenciar uma pequena parte de uma situação difícil sem ser responsável pelo resultado inteiro."
          }
        }
      }
    },
    "path.clear-thinking.step.2.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save two lists: What I can act on and What is outside my control. Circle one small next step."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете два списъка: „Какво мога да предприема“ и „Какво е извън моя контрол“. Оградете една малка следваща стъпка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere zwei Listen: „Was ich beeinflussen kann“ und „Was außerhalb meiner Kontrolle liegt“. Kreise einen kleinen nächsten Schritt ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda dos listas: En qué puedo actuar y Qué está fuera de mi control. Rodea un pequeño paso siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez deux listes : Ce sur quoi je peux agir et Ce qui échappe à mon contrôle. Entourez une petite prochaine étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva due liste: Ciò su cui posso agire e Ciò che è fuori dal mio controllo. Cerchia un piccolo passo successivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve duas listas: Sobre o que posso agir e O que está fora do meu controle. Circule um pequeno próximo passo."
          }
        }
      }
    },
    "path.clear-thinking.step.2.smallerTask": {
      "extractionState": "manual",
