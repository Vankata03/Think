        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hast du gelernt, aber noch nicht angewendet?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué has aprendido pero aún no has puesto en práctica?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu as appris mais que tu n'as pas mis en pratique ?"
