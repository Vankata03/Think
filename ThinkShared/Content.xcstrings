            "state": "translated",
            "value": "Lance-toi dans une action utile sans en faire tout un plat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia un'azione utile senza dirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece uma ação útil sem anunciar nada."
          }
        }
      }
    },
