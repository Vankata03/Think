    "path.deep-focus.step.12.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фийдовете са проектирани срещу всичко, което си упражнявал досега."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeds are engineered against everything you've practiced so far."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Feeds sind so konzipiert, dass sie allem widersprechen, was du bisher geübt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones están diseñadas para desafiar todo lo que has practicado hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux sont conçus pour aller à l'encontre de tout ce que tu as appris jusqu'à présent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I feed sono progettati in modo da andare contro tutto ciò che hai fatto finora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os feeds foram criados para desafiar tudo o que você já praticou até agora."
          }
        }
      }
    },
    "path.deep-focus.step.12.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Take five minutes to choose a feed to skip and a helpful replacement. Try the experiment during the day."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За пет минути избери емисия, която да пропуснеш, и полезна замяна. Опитай експеримента през деня."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle in fünf Minuten einen Feed zum Auslassen und einen hilfreichen Ersatz. Probiere das Experiment tagsüber aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dedica cinco minutos a elegir un feed que omitir y una alternativa útil. Prueba el experimento durante el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prends cinq minutes pour choisir un fil à éviter et une alternative utile. Essaie cette expérience dans la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In cinque minuti scegli un feed da saltare e un'alternativa utile. Prova l'esperimento durante il giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
