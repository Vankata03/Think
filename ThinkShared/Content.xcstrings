    "practice.098.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дължиш продуктивност на всеки час; дължиш честност на важните часове."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not owe every hour productivity; you owe important hours honesty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst nicht jede Stunde produktiv sein; du musst den wichtigen Stunden Ehrlichkeit entgegenbringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes que ser productivo cada hora; lo que sí tienes que hacer es ser sincero en las horas importantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne dois pas être productif à chaque heure, mais honnête dans les heures importantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non devi dedicare ogni ora alla produttività; devi dedicare le ore importanti all’onestà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não precisa ser produtivo o tempo todo; o que importa é ser honesto nas horas que realmente contam."
          }
        }
      }
    },
    "practice.098.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този час за работа ли е, за почивка, или за избягване?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is this hour for work, rest, or avoidance?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist diese Stunde für Arbeit, Erholung oder Vermeidung?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Esta hora es para trabajar, descansar o evadirte?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette heure, c'est pour bosser, se reposer ou faire l'impasse ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quest’ora è per lavorare, riposarti o semplicemente per evadere?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa hora é pra trabalhar, descansar ou fugir das coisas?"
          }
        }
      }
    },
    "practice.099.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши цената до целта, преди да я приемеш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the tradeoff beside the goal before accepting it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib den Kompromiss neben das Ziel, bevor du es akzeptierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota la contrapartida junto al objetivo antes de aceptarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note le compromis à côté de l'objectif avant de l'accepter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi il compromesso accanto all’obiettivo prima di accettarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota a contrapartida ao lado da meta antes de aceitá-la."
          }
        }
      }
    },
