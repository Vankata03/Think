          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme-la, programme-la ou supprime-la dans les cinq prochaines minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudila, imposta un promemoria o cancellala entro i prossimi cinque minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua, agende ou elimine essa pendência nos próximos cinco minutos."
          }
        }
