    "practice.050.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Човек трябва да стои изправен сам, а не да го крепят другите."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Man muss selbst aufrecht stehen, nicht von anderen aufrecht gehalten werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A man then must stand erect, not be kept erect by others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hombre debe mantenerse erguido por sí mismo, sin que otros lo mantengan erguido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un homme doit donc se tenir droit, sans que ce soient les autres qui le maintiennent droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un uomo, quindi, deve stare dritto di sua spontanea volontà, senza che siano gli altri a tenerlo dritto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um homem deve, então, manter-se ereto, e não ser mantido ereto por outros."
          }
        }
      }
    },
    "practice.050.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде чакаш окуражение, преди да действаш?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you waiting for encouragement before acting?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo wartest du noch auf Ermutigung, bevor du handelst?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué aspectos estás esperando que te den ánimos antes de actuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quels domaines attends-tu qu'on t'encourage avant de passer à l'action ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quali situazioni stai aspettando un po’ di incoraggiamento prima di agire?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que situação você está esperando um incentivo antes de agir?"
          }
        }
      }
    },
    "practice.051.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намери най-силния аргумент срещу него и го изложи честно."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the strongest evidence against it and summarize it fairly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde die stärksten Argumente dagegen und fasse sie fair zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca los argumentos más sólidos en contra y resúmelos de forma imparcial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les arguments les plus solides contre elle et résume-les de manière impartiale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova le prove più convincenti a sfavore e riassumile in modo imparziale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre os argumentos mais fortes contra ele e resuma-os de forma imparcial."
          }
        }
      }
    },
