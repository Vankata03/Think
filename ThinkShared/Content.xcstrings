    "practice.076.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вниманието е един от малкото подаръци, които не можеш да дадеш по-късно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufmerksamkeit gehört zu den wenigen Geschenken, die man nicht nachholen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention is one of the few gifts that cannot be given later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La atención es uno de los pocos regalos que no se pueden dar más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attention est l'un des rares cadeaux qu'on ne peut pas offrir plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attenzione è uno dei pochi doni che non si possono regalare in un secondo momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atenção é um dos poucos presentes que não dá pra dar depois."
          }
        }
      }
    },
    "practice.076.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой получава близостта ти, но не и присъствието ти?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer bekommt deine Nähe, aber nicht deine Gegenwart?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who receives your proximity but not your presence?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién disfruta de tu cercanía, pero no de tu presencia?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui reçoit ta proximité, mais pas ta présence ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi percepisce la tua vicinanza ma non la tua presenza?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem percebe que você está por perto, mas não percebe sua presença?"
          }
        }
      }
    },
    "practice.077.action": {
      "comment": "Concrete action paired with the daily line.",
