    "practice.026.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Каква промяна отхвърли, защото първата версия изглеждаше твърде незначителна?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Veränderung hast du abgelehnt, weil der erste Schritt zu klein wirkte?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What change have you rejected because the first version looked too small?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué cambio has rechazado porque la primera versión te parecía demasiado pequeña?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel changement as-tu rejeté parce que la première version semblait trop modeste ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale cambiamento hai scartato perché la prima versione sembrava troppo modesta?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que mudança você já rejeitou porque a primeira versão parecia insignificante?"
          }
        }
      }
    },
