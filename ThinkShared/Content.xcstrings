    "path.clear-thinking.step.7.lesson": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A result alone cannot tell you whether a decision was sensible. Review what you knew then, what happened, and what you want to try next."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Резултатът сам по себе си не може да ви каже дали решението е било разумно. Прегледайте какво сте знаели тогава, какво се е случило и какво искате да опитате след това."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Ergebnis allein sagt dir nicht, ob eine Entscheidung vernünftig war. Überprüfe, was du damals wusstest, was passiert ist und was du als Nächstes ausprobieren willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un resultado por sí solo no puede decirte si una decisión fue sensata. Revisa lo que sabías entonces, lo que pasó y lo que quieres probar a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un résultat seul ne peut pas vous dire si une décision était sensée. Revoyez ce que vous saviez alors, ce qui s'est passé et ce que vous voulez essayer ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un risultato da solo non può dirti se una decisione era sensata. Rivedi cosa sapevi allora, cosa è successo e cosa vuoi provare dopo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um resultado sozinho não pode dizer se uma decisão foi sensata. Revise o que você sabia na época, o que aconteceu e o que quer tentar em seguida."
          }
        }
      }
    },
    "path.clear-thinking.step.7.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save a decision review: What I knew, What happened, What I learned, and My next experiment. Choose a lesson to repeat."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете преглед на решение: „Какво знаех“, „Какво се случи“, „Какво научих“ и „Моят следващ експеримент“. Изберете една поука, която да повторите."
          }
        },
        "de": {
