        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What in your environment keeps voting against your intention?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué cosas de tu entorno siguen yendo en contra de lo que te propones?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui, dans ton environnement, ne cesse d'aller à l'encontre de tes intentions ?"
