    "practice.058.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Историята, която разказваш за себе си, подбира доказателствата."
          }
        },
        "en": {
          "stringUnit": {
