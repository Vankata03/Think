    "practice.028.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обещанието след провал тежи по-малко от промяната в средата преди утре."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Versprechen nach dem Scheitern zählt weniger als die Umgebung, die du bis morgen änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The promise after failure matters less than the environment changed before tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La promesa tras un fracaso importa menos que el cambio en el entorno antes de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui compte, ce n'est pas tant la promesse après un échec que le changement d'environnement avant demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La promessa dopo un fallimento conta meno del cambiamento che si verifica nell’ambiente prima di domani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A promessa depois de um fracasso importa menos do que a mudança no ambiente antes de amanhã."
          }
        }
      }
    },
    "practice.028.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво направи последния провал предвидим?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was machte das letzte Scheitern vorhersehbar?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What made the last failure predictable?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hizo que el último fracaso fuera previsible?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui rendait cet échec prévisible ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ha reso prevedibile l’ultimo fallimento?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que fez com que o último fracasso fosse previsível?"
          }
        }
      }
    },
    "practice.029.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекъсни го веднъж днес и запиши какво го е предизвикало."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterbrich sie heute einmal und notiere, was sie ausgelöst hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupt it once today and record what triggered it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrúmpela una vez hoy y anota qué fue lo que la activó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interromps-la une fois aujourd’hui et note ce qui l’a déclenchée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompila una volta oggi e annota cosa l’ha fatta scattare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompa-o uma vez hoje e anote o que fez com que ele fosse acionado."
          }
        }
      }
    },
