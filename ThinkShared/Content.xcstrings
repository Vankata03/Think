            "value": "Choose one thing and give it the next uninterrupted ten minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such dir eine Sache aus und widme ihr die nächsten zehn Minuten ununterbrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una cosa y dedícale los próximos diez minutos sin interrupciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une chose et consacre-lui les dix prochaines minutes sans interruption."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cosa e dedicale i prossimi dieci minuti senza interruzioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma coisa e dedique a ela os próximos dez minutos sem interrupções."
          }
        }
      }
    },
