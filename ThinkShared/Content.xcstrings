    "practice.079.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко нещо има две дръжки — едната, с която може да се носи, другата — с която не може."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything has two handles, the one by which it may be borne, the other by which it may not."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles hat zwei Griffe: einen, an dem es sich tragen lässt, und einen, an dem es das nicht tut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo tiene dos asas: una con la que se puede llevar y otra con la que no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout a deux facettes : celle qui permet de le supporter, et celle qui ne le permet pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cosa ha due maniglie: una con cui può essere trasportata, l’altra con cui non può esserlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo tem duas alças: uma pela qual pode ser carregado, e outra pela qual não pode."
          }
        }
      }
    },
    "practice.079.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое тълкуване на конфликта прави полезен отговор възможен?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which interpretation of this conflict makes a useful response possible?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Interpretation dieses Konflikts ermöglicht eine sinnvolle Reaktion?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué interpretación de este conflicto permite dar una respuesta útil?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle interprétation de ce conflit permet d'apporter une réponse utile ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale interpretazione di questo conflitto rende possibile una risposta utile?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual interpretação desse conflito torna possível uma resposta útil?"
          }
        }
      }
    },
    "practice.080.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи поне една своя нужда в следващото решение."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include one of your own needs in the next decision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehe bei deiner nächsten Entscheidung eines deiner eigenen Bedürfnisse mit ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta una de tus propias necesidades en la próxima decisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pense à inclure l'un de tes propres besoins dans ta prochaine décision."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni conto di una delle tue esigenze nella prossima decisione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua uma das suas próprias necessidades na próxima decisão."
          }
        }
      }
    },
