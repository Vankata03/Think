    "practice.018.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Увереността, изградена преди действие, е предимно въображение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuversicht, die vor dem Handeln entsteht, ist meistens Einbildung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidence built before action is mostly imagination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La confianza que se genera antes de actuar es, en gran parte, fruto de la imaginación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confiance qu'on se forge avant d'agir, c'est surtout une question d'imagination."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiducia che si costruisce prima di agire è per lo più frutto dell’immaginazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A confiança que a gente constrói antes de agir é, em grande parte, imaginação."
          }
        }
      }
    },
    "practice.018.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За какво чакаш да се почувстваш готов?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worauf wartest du, um dich bereit zu fühlen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are you waiting to feel ready for?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué estás esperando para sentirte preparado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu attends pour te sentir prêt ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa stai aspettando per sentirti pronto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você tá esperando pra se sentir pronto?"
          }
        }
      }
    },
    "practice.019.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи днешното повторение и не измервай резултата до утре."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu die heutige Wiederholung und lass das Ergebnis bis morgen ungemessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do today's repetition and leave the outcome unmeasured until tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz la repetición de hoy y deja el resultado sin evaluar hasta mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais l'exercice du jour et ne t'inquiète pas du résultat avant demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai l’esercizio di oggi e lascia che sia domani a giudicare il risultato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça a repetição de hoje e deixe o resultado de lado até amanhã."
          }
        }
      }
    },
    "practice.019.author": {
      "comment": "Displayed attribution. Think is hidden in the UI.",
      "extractionState": "manual",
