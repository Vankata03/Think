          "stringUnit": {
            "state": "translated",
            "value": "Какво разкри последната ти грешка за процеса?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did your last mistake reveal about the process?"
          }
        },
        "de": {
