    "practice.073.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да те разберат не е същото като да се съгласят с теб."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstanden zu werden ist nicht dasselbe wie Zustimmung zu bekommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Being understood is not the same as being agreed with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que te entiendan no es lo mismo que estar de acuerdo contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Être compris, ce n'est pas la même chose qu'être approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Essere capiti non significa necessariamente essere d’accordo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser compreendido não é o mesmo que obter concordância."
          }
        }
      }
    },
    "practice.073.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Търсиш разбиране или капитулация?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittest du um Verständnis oder um Kapitulation?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you asking for comprehension or surrender?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás buscando la comprensión o la rendición?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherches-tu à être compris ou à obtenir la capitulation de l’autre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai chiedendo comprensione o resa?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está buscando compreensão ou rendição?"
          }
        }
      }
    },
    "practice.074.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задай един уточняващ въпрос, преди да предложиш решение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell eine klärende Frage, bevor du eine Lösung anbietest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask one clarifying question before offering a solution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta para aclarar las cosas antes de ofrecer una solución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une question pour clarifier les choses avant de proposer une solution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda chiarificatrice prima di proporre una soluzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta para esclarecer antes de oferecer uma solução."
          }
        }
      }
    },
