    "practice.087.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Яснотата идва по-често след изваждане, не след добавяне."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clarity often arrives after subtraction, not addition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klarheit entsteht oft durch Weglassen, nicht durch Hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La claridad suele llegar tras restar, no tras sumar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clarté vient souvent de ce qu'on enlève, pas de ce qu'on ajoute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesso la chiarezza arriva dopo aver eliminato qualcosa, non dopo aver aggiunto qualcosa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A clareza geralmente surge depois de tirar, não de acrescentar."
          }
        }
      }
    },
    "practice.087.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво може да се премахне, без да се навреди на същественото?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be removed without harming the essential result?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was kann weggelassen werden, ohne das wesentliche Ergebnis zu beeinträchtigen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué se puede quitar sin que afecte al resultado esencial?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qu'on peut enlever sans nuire au résultat essentiel ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa si può eliminare senza compromettere il risultato essenziale?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que pode ser removido sem prejudicar o resultado essencial?"
          }
        }
      }
    },
    "practice.088.action": {
