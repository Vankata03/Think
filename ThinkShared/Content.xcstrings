    "practice.021.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисциплината е по-малко въпрос на сила и повече на това да премахнеш следващото оправдание."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Disziplin beruht weniger auf Willenskraft als darauf, die nächste innere Debatte überflüssig zu machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discipline is less about force than removing the next argument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disciplina no tiene tanto que ver con la fuerza como con evitar la siguiente discusión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La discipline repose moins sur la force que sur l’élimination de la prochaine négociation intérieure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disciplina è meno forza e più eliminazione della prossima scusa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disciplina tem menos a ver com imposição e mais com eliminar o próximo motivo de discussão."
          }
        }
      }
    },
    "practice.021.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой полезен избор преразглеждаш всеки ден?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche sinnvolle Entscheidung verhandelst du jeden Tag neu?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which useful choice do you renegotiate every day?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué decisión útil te planteas cada día?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel choix utile repenses-tu chaque jour ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è quella scelta utile che riesamini ogni giorno?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual escolha útil você repensa todos os dias?"
          }
        }
      }
    },
    "practice.022.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи най-малката завършена версия преди лягане."
          }
        },
        "de": {
          "stringUnit": {
