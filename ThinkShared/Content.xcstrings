    "practice.043.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Но остави го да те изчака."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aber lass die Sache auf dich warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "But let the thing wait for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pero deja que eso te espere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais laisse la chose t’attendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma lascia che sia quella cosa ad aspettarti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas faça a coisa esperar por você."
          }
        }
      }
    },
    "practice.043.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой порив се засилва, защото му се подчиняваш веднага?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Impuls wird stärker, weil du ihm sofort nachgibst?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which impulse gets stronger because you obey it immediately?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué impulso se hace más fuerte porque lo sigues al instante?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle impulsion devient plus forte parce que tu y cèdes tout de suite ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale impulso diventa più forte perché gli dai subito seguito?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual impulso fica mais forte porque você o segue na hora?"
          }
        }
      }
    },
    "practice.044.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши какво знаеш сега, което не си знаел, когато си избирал."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib auf, was du jetzt weißt, das du damals noch nicht wusstest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write what you know now that you did not know when you chose it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe lo que sabes ahora y que no sabías cuando lo elegiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris ce que tu sais maintenant et que tu ne savais pas quand tu l'as choisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi ciò che sai adesso e che non sapevi quando l’hai scelta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva o que você sabe agora e que não sabia quando escolheu isso."
          }
        }
      }
    },
