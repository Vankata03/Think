    "practice.056.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дай си определение или описание на нещото, което ти е представено."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make for thyself a definition or description of the thing which is presented to thee."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle dir selbst eine Definition oder Beschreibung der Sache, die dir präsentiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tu propia definición o descripción de lo que se te presenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-toi ta propre définition ou description de ce qui t'est présenté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea per te stesso una definizione o una descrizione di ciò che ti viene presentato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie para si mesmo uma definição ou descrição daquilo que está sendo apresentado a você."
          }
        }
      }
    },
    "practice.056.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво става по-ясно, когато го лишиш от ласкавия или плашещия му етикет?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What becomes clearer when stripped of its flattering or frightening label?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was wird deutlicher, wenn man ihr schmeichelhaftes oder beängstigendes Etikett weglässt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué se ve más claro cuando te quitas esa etiqueta que te halaga o te asusta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui apparaît plus clairement une fois débarrassé de son étiquette flatteuse ou effrayante ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa diventa più chiaro quando ti liberi di quell’etichetta lusinghiera o spaventosa?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que fica mais claro quando tiramos esse rótulo que nos elogia ou nos assusta?"
          }
        }
      }
    },
    "practice.057.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
