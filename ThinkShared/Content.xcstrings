    "practice.077.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Питай, преди да помогнеш — спасяването понякога е контрол, облечен в доброта."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask before helping; rescue can be control wearing kindness."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag, bevor du hilfst; Hilfe kann Kontrolle sein, die sich als Freundlichkeit tarnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta antes de ayudar; el rescate puede convertirse en control disfrazado de amabilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande avant d’aider : secourir peut être du contrôle déguisé en gentillesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi prima di aiutare: il soccorso può essere controllo travestito da gentilezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte antes de ajudar; ajudar pode ser uma forma de controlar com gentileza."
          }
        }
      }
    },
    "practice.077.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде твоята помощ може да замества нечий избор?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where might your help be replacing another person's choice?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo könnte deine Hilfe die Entscheidung einer anderen Person ersetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué situaciones tu ayuda podría estar sustituyendo la decisión de otra persona?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quels cas ton aide pourrait-elle se substituer au choix d'une autre personne ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quali casi il tuo aiuto potrebbe sostituirsi alla scelta di un’altra persona?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que situações a sua ajuda poderia estar substituindo a escolha de outra pessoa?"
          }
        }
      }
    },
    "practice.078.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промени напомнянето, границата, графика или системата още днес."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the reminder, boundary, schedule, or system today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere noch heute die Erinnerung, die Grenze, den Zeitplan oder das System."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia hoy mismo el recordatorio, el límite, el horario o el sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie dès aujourd’hui le rappel, la limite, l’emploi du temps ou le système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia oggi stesso il promemoria, i limiti, il programma o il sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda hoje mesmo o lembrete, o limite, a programação ou o sistema."
          }
        }
      }
    },
