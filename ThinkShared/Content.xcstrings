    "path.deep-focus.step.21.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи 90 минути дълбока работа днес — раздели ги на сесии, както прецениш."
