    },
    "practice.003.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Затвори го, планирай го или го изтрий в следващите пет минути."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
