    "practice.060.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задай един основен въпрос, без да се извиняваш за него."
          }
        },
        "en": {
          "stringUnit": {
