    "practice.081.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Учене, което не е променило нито един избор, е просто складиране."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning that never changes a choice is storage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernen, das niemals eine Entscheidung verändert, ist Speicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aprendizaje que nunca cambia una elección es el almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprentissage qui ne change jamais un choix, c'est la mémorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apprendimento che non cambia mai una scelta è solo archiviazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender sem nunca mudar uma escolha é armazenamento."
          }
        }
      }
    },
    "practice.081.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво си научил, но не си приложил?"
