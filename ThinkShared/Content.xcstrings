    "path.deep-focus.step.9.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко известие е чужд план за вниманието ти."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every notification is someone else scheduling your attention."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Benachrichtigung ist jemand anderes, der deine Aufmerksamkeit plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada notificación es alguien que te está quitando tiempo para otras cosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque notification, c'est quelqu'un d'autre qui programme ton attention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni notifica è qualcuno che cerca di attirare la tua attenzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada notificação é alguém tentando chamar sua atenção."
          }
        }
      }
    },
    "path.deep-focus.step.9.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключи всяко известие, което не идва от човек, на когото си нужен."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off every notification that doesn't come from a human who needs you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte alle Benachrichtigungen aus, die nicht von einem Menschen kommen, der dich braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva todas las notificaciones que no vengan de alguien que te necesite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive toutes les notifications qui ne viennent pas d'une personne qui a besoin de toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva tutte le notifiche che non provengono da una persona che ha bisogno di te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa todas as notificações que não venham de alguém que precise de você."
          }
        }
      }
    },
