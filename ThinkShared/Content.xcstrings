    "practice.083.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Практиката разкрива въпросите, които подготовката оставя теоретични."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice exposes the questions that preparation keeps theoretical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Praxis bringt die Fragen ans Licht, die bei der Vorbereitung nur theoretisch bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La práctica saca a la luz las preguntas que la preparación deja en el ámbito teórico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pratique met en lumière les questions que la préparation laisse au stade théorique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pratica mette in luce le domande che la preparazione lascia solo a livello teorico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prática traz à tona as questões que a preparação deixa no plano teórico."
          }
        }
      }
    },
    "practice.083.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво може да се научи само като го опиташ?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can only be learned by attempting it?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was kann man nur lernen, wenn man es einfach ausprobiert?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es lo único que se puede aprender probándolo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qu'on ne peut apprendre qu'en essayant ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa si può imparare solo provandoci?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que só dá pra aprender tentando?"
          }
        }
      }
    },
    "practice.084.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдели десет минути за последната му неудобна част."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend ten minutes on its final uncomfortable part."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir zehn Minuten Zeit für den letzten, etwas unangenehmen Teil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica diez minutos a su parte final, que resulta un poco incómoda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe dix minutes sur la dernière partie, celle qui te met mal à l'aise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica dieci minuti alla parte finale, quella un po’ scomoda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica dez minutos à parte final, que é um pouco desconfortável."
          }
        }
      }
    },
