    "practice.003.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяка незавършена задача събира наем от вниманието ти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede offene Schleife verlangt ihren Tribut an Aufmerksamkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every open loop charges rent in attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bucle abierto te exige un poco de atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque boucle ouverte te demande de l'attention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ciclo aperto richiede un po’ di attenzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pendência cobra aluguel da sua atenção."
          }
        }
      }
    },
    "practice.003.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое незавършено нещо продължава да се връща в мислите ти?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche unerledigte Sache kehrt immer wieder in deine Gedanken zurück?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which unfinished thing keeps returning to your mind?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué asunto pendiente no deja de rondarte por la cabeza?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle affaire inachevée te revient sans cesse à l'esprit ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è quella cosa che non hai portato a termine e che continua a tornarti in mente?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é aquela coisa que você não terminou e que não para de voltar à sua cabeça?"
          }
        }
      }
    },
    "practice.004.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови един приоритет и извади от този час една задача, която му пречи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenn eine Priorität und streiche eine konkurrierende Aufgabe aus dieser Stunde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name one priority and remove one competing task from that hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una prioridad y elimina una tarea que te distraiga de esa hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une priorité et élimine une tâche qui te ferait perdre du temps pendant cette heure-là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica una priorità e elimina un'attività che la ostacola da quell'ora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma prioridade e tire uma tarefa que esteja competindo com ela daquela hora."
          }
        }
      }
    },
