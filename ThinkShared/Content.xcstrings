          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda una frase que empiece así: Estoy suponiendo que…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez une phrase commençant par : Je suppose que…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva una frase che inizi con: Sto dando per scontato che…"
          }
        },
        "pt-BR": {
