    "practice.037.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигурността изглежда чиста, защото скрива незавършеното."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewissheit wirkt ordentlich, weil sie das Unfertige verbirgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certainty feels clean because it hides the unfinished work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La certeza parece limpia porque oculta el trabajo pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La certitude paraît nette parce qu’elle cache le travail inachevé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La certezza dà una sensazione di pulizia perché nasconde il lavoro ancora incompiuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A certeza parece limpa porque esconde o trabalho inacabado."
          }
        }
      }
    },
    "practice.037.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде си по-уверен, отколкото доказателствата ти позволяват?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo bist du sicherer, als deine Belege es erlauben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you more certain than your evidence allows?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué aspectos estás más seguro de lo que te permiten tus pruebas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quels domaines es-tu plus sûr de toi que ne le permettent tes preuves ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quali situazioni sei più sicuro di quanto le prove ti consentano di esserlo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que situações você tem mais certeza do que as evidências permitem?"
          }
        }
      }
    },
    "practice.038.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови го и го приложи в следващите десет минути."
          }
