    "practice.032.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тревогата репетира болката, не отговора."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgen proben den Schmerz, nicht die Antwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worry rehearses pain, not response."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La preocupación te hace revivir el dolor, no te ayuda a reaccionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inquiétude ne fait que raviver la douleur, sans apporter de solution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La preoccupazione ti fa provare dolore, non ti aiuta a reagire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A preocupação repete a dor, não a resposta."
          }
        }
      }
    },
    "practice.032.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За кое конкретно събитие се тревожиш?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches konkrete Ereignis bereitet dir Sorgen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What specific event are you worried about?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué situación concreta te preocupa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel événement précis te préoccupe ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è l’evento specifico che ti preoccupa?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual evento específico está te preocupando?"
          }
        }
      }
    },
    "practice.033.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши наблюдаемите факти без предсказания или мотиви."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib die beobachtbaren Fakten – ohne Vorhersagen oder Motive."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the observable facts without predictions or motives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe los hechos observables sin hacer predicciones ni dar motivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note les faits observables, sans faire de prédictions ni évoquer de motivations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi i fatti osservabili senza fare previsioni né attribuire motivazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva os fatos observáveis, sem previsões nem motivos."
          }
        }
      }
    },
