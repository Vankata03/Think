    "practice.013.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ти трябва по-добро настроение. Трябва ти по-малък старт."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst keine bessere Stimmung. Du brauchst einen kleineren Anfang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not need a better mood. You need a smaller starting line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas estar de mejor humor. Lo que necesitas es una línea de salida más sencilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as pas besoin d'être de meilleure humeur. Tu as besoin d'un point de départ plus simple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ti serve un umore migliore. Ti serve una linea di partenza più bassa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não precisa de um humor melhor. Você precisa de um ponto de partida mais simples."
          }
        }
      }
    },
    "practice.013.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое изглежда прекалено голямо само защото първата стъпка е неясна?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was wirkt nur deshalb zu groß, weil der erste Schritt unklar ist?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What feels too large only because the first step is vague?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te parece demasiado complicado solo porque el primer paso no está claro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui te semble trop difficile juste parce que la première étape n'est pas claire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti sembra troppo difficile solo perché il primo passo è poco chiaro?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que parece grande demais só porque o primeiro passo é vago?"
          }
        }
      }
    },
    "practice.014.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Замени едно повторение на нежелания навик с най-малкото противоположно действие."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze eine Wiederholung der unerwünschten Gewohnheit durch ihr kleinstes Gegenteil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace one repetition of the unwanted habit with its smallest opposite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye una repetición del hábito no deseado por su opuesto más pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace une répétition de l'habitude indésirable par son contraire le plus infime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci una ripetizione dell’abitudine indesiderata con il suo opposto più piccolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua uma repetição do hábito indesejado pelo seu oposto mais simples."
          }
        }
      }
    },
