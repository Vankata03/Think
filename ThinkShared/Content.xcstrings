    "practice.061.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентичността трябва да обяснява практиката ти, не да я оправдава."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity should explain your practice, not excuse it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Identität sollte deine Vorgehensweise erklären, nicht rechtfertigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu identidad debería explicar tu práctica, no justificarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton identité doit expliquer ta pratique, pas la justifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua identità dovrebbe spiegare la tua pratica, non giustificarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade deve explicar a sua prática, não justificá-la."
          }
        }
      }
    },
    "practice.061.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой етикет ти позволява да не променяш поведението си?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which label lets you avoid changing a behavior?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit welcher Bezeichnung kannst du es vermeiden, ein Verhalten zu ändern?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué etiqueta te permite evitar cambiar un comportamiento?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle étiquette te permet d'éviter de changer un comportement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale etichetta ti permette di evitare di cambiare un comportamento?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual rótulo te ajuda a evitar mudar um comportamento?"
          }
        }
      }
    },
    "practice.062.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пази едно лично обещание днес и не го обявявай."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep one private promise today and do not announce it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte dir heute ein privates Versprechen und erzähl niemandem davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy, hazte una promesa en privado y no la cuentes a nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-toi une promesse en privé aujourd’hui et n’en parle à personne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una promessa a te stesso oggi e non dirla a nessuno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma promessa só pra você hoje e não conte pra ninguém."
          }
        }
      }
    },
