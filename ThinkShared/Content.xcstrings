    "practice.016.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Следващото действие трябва да е толкова конкретно, че да не можеш да спориш с него."
