    "practice.091.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Времето не просто се харчи. Разменяш го за човека, в когото се превръщаш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time is not only spent. It is traded for a particular self."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit wird nicht einfach nur verbraucht. Sie wird gegen ein bestimmtes Selbst eingetauscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo no solo se gasta. Se intercambia por un yo concreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps, ça ne se passe pas juste. On l'échange contre une certaine version de soi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo non viene solo trascorso. Viene scambiato per un sé particolare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo não é só gasto. Ele é trocado por um “eu” específico."
          }
        }
      }
    },
    "practice.091.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В какъв човек те превръщат навиците, с които пълниш часовете си?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who are your repeated hours training you to become?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wem formen dich die Stunden, die du immer gleich verbringst?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En quién te están convirtiendo las horas que repites?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui ces heures d'entraînement répétées te poussent-elles à devenir ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In chi ti trasformano le ore che ripeti ogni giorno?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em quem essas horas repetidas de treino estão te transformando?"
          }
        }
      }
    },
    "practice.092.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражни го веднъж днес — в час, в който можеш да го повториш и следващата седмица."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice it once today at a time you can repeat next week."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier es heute einmal aus – zu einem Zeitpunkt, den du nächste Woche wiederholen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébala hoy una vez, en un momento en el que puedas repetirlo la semana que viene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie-la une fois aujourd’hui, à un moment où tu pourras recommencer la semaine prochaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provala oggi una volta, in un momento in cui potrai ripeterla la settimana prossima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique isso uma vez hoje, num horário que você possa repetir na próxima semana."
          }
        }
      }
    },
