    "practice.096.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Едни сезони са за разширяване; други — за запазване на едно обещание живо."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some seasons are for expansion; others are for keeping one promise alive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Zeiten sind dazu da, sich zu entfalten; andere dazu, ein Versprechen lebendig zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay épocas para crecer; otras, para mantener viva una promesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines périodes sont faites pour s'épanouir ; d'autres, pour tenir une promesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono stagioni dedicate alla crescita; altre, invece, servono a mantenere viva una promessa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas épocas são para crescer; outras, para manter viva uma promessa."
          }
        }
      }
    },
    "practice.096.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В кой сезон всъщност си?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What season are you actually in?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In welcher Lebensphase befindest du dich gerade eigentlich?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué etapa de tu vida te encuentras ahora mismo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quelle saison es-tu en ce moment ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In che stagione ti trovi, in realtà?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que fase da vida você está, na verdade?"
          }
        }
      }
    },
    "practice.097.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стесни хоризонта до това, с което можеш да се справиш в следващите десет минути."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce the horizon to what can be handled in the next ten minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschränke deinen Horizont auf das, was du in den nächsten zehn Minuten bewältigen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita tus objetivos a lo que puedas hacer en los próximos diez minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite tes objectifs à ce que tu peux gérer dans les dix prochaines minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita i tuoi orizzonti a ciò che puoi gestire nei prossimi dieci minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita o que você precisa fazer aos próximos dez minutos."
          }
        }
      }
    },
