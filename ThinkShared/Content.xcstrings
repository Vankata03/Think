    "practice.038.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не се случва с човек, за което природата не го е подготвила да понесе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Menschen widerfährt nichts, was er von Natur aus nicht zu ertragen vermag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing happens to any man which he is not formed by nature to bear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A ningún hombre le ocurre nada que la naturaleza no le haya preparado para soportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’arrive rien à un homme qu’il ne soit pas capable de supporter par nature."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A nessun uomo capita nulla che la natura non lo abbia reso in grado di sopportare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada acontece a ninguém que a natureza não o tenha preparado para suportar."
          }
        }
      }
    },
