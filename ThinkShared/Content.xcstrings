    "path.clear-thinking.continuation": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You finished the seven-lesson introduction. Repeat a lesson with a new decision, or start a fresh seven-lesson run. A longer track is still in development."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завърши въведението от седем урока. Повтори урок с ново решение или започни нов цикъл от седем урока. По-дълъг курс още се разработва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast die Einführung mit sieben Lektionen beendet. Wiederhole eine Lektion mit einer neuen Entscheidung oder beginne einen neuen Durchlauf. Ein längerer Kurs ist noch in Entwicklung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terminaste la introducción de siete lecciones. Repite una con una nueva decisión o empieza otra vuelta de siete lecciones. El recorrido más largo sigue en desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu as terminé l'introduction en sept leçons. Reprends une leçon avec une nouvelle décision ou commence un nouveau parcours de sept leçons. Un parcours plus long est en développement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hai completato l'introduzione di sette lezioni. Ripeti una lezione con una nuova decisione o inizia un nuovo ciclo di sette lezioni. Un percorso più lungo è ancora in sviluppo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você concluiu a introdução de sete lições. Repita uma lição com outra decisão ou comece um novo ciclo de sete lições. Um percurso mais longo ainda está em desenvolvimento."
          }
        }
      }
    },
