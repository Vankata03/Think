    "practice.016.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Следващото действие трябва да е толкова конкретно, че да не можеш да спориш с него."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Handlung sollte so konkret sein, dass es nichts zu diskutieren gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next action should be too concrete to argue with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La siguiente acción debería ser tan concreta que no haya nada que objetar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine action devrait être trop concrète pour qu'on puisse la contester."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima azione dovrebbe essere talmente concreta da non lasciare spazio a discussioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima ação deve ser tão concreta que não dá pra contestar."
          }
        }
      }
    },
