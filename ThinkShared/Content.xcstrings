            "state": "translated",
            "value": "Practice one immediate, unpunished return today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica hoy mismo un retorno inmediato y sin castigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi dès aujourd’hui à faire un retour immédiat, sans te juger."
