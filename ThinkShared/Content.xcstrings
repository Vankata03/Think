    "path.deep-focus.step.12.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фийдовете са проектирани срещу всичко, което си упражнявал досега."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feeds are engineered against everything you've practiced so far."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Feeds sind so konzipiert, dass sie allem widersprechen, was du bisher geübt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones están diseñadas para desafiar todo lo que has practicado hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux sont conçus pour aller à l'encontre de tout ce que tu as appris jusqu'à présent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I feed sono progettati in modo da andare contro tutto ciò che hai fatto finora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os feeds foram criados para desafiar tudo o que você já praticou até agora."
          }
        }
      }
    },
    "path.deep-focus.step.12.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери един фийд или приложение и го пропусни изцяло за целия ден."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one feed or app and skip it entirely for the whole day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such dir einen Feed oder eine App aus und lass sie den ganzen Tag komplett links liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un canal o una app y no la uses en absoluto durante todo el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un fil d'actualité ou une appli et évite-la complètement pendant toute la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un feed o un’app e ignorala completamente per tutta la giornata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um feed ou aplicativo e ignora-o completamente durante o dia todo."
          }
        }
      }
    },
    "path.deep-focus.step.12.title": {
      "comment": "Thinking path step title.",
      "extractionState": "stale",
      "localizations": {
