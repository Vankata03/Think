        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In chi ti trasformano le ore che ripeti ogni giorno?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em quem essas horas repetidas de treino estão te transformando?"
          }
        }
      }
    },
    "practice.092.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражни го веднъж днес — в час, в който можеш да го повториш и следващата седмица."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice it once today at a time you can repeat next week."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probier es heute einmal aus – zu einem Zeitpunkt, den du nächste Woche wiederholen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébala hoy una vez, en un momento en el que puedas repetirlo la semana que viene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie-la une fois aujourd’hui, à un moment où tu pourras recommencer la semaine prochaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provala oggi una volta, in un momento in cui potrai ripeterla la settimana prossima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique isso uma vez hoje, num horário que você possa repetir na próxima semana."
          }
        }
      }
    },
