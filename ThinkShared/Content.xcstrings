    "practice.010.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не всяка мисъл заслужава среща."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht jeder Gedanke verdient eine Besprechung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not every thought deserves a meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No todos los pensamientos merecen una reunión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les pensées ne méritent pas qu'on s'y attarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tutti i pensieri meritano di essere approfonditi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem todo pensamento merece ser levado a sério."
          }
        }
      }
    },
    "practice.010.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя мисъл продължава да взема от времето ти, без да стига до решение?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Gedanke kostet immer wieder Zeit, ohne zu einer Entscheidung zu führen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which thought keeps taking time without producing a decision?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pensamiento te sigue quitando tiempo sin que llegues a tomar una decisión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle pensée te prend sans cesse du temps sans que tu arrives à te décider ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale pensiero continua a rubarti tempo senza portare a una decisione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual pensamento fica te ocupando o tempo sem que você consiga tomar uma decisão?"
          }
        }
      }
    },
    "practice.011.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи едно видимо действие, което доказва тази ценност, преди денят да свърши."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu heute noch eine sichtbare Handlung, die es beweist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one visible act that proves it before the day ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz algo concreto que lo demuestre antes de que acabe el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un geste concret qui le prouve avant la fin de la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai qualcosa di concreto che lo dimostri prima che finisca la giornata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça algo concreto que comprove isso antes do fim do dia."
          }
        }
      }
    },
