    "practice.099.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди да добавиш цел, реши на какво ще отделяш по-малко живот."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before adding a goal, decide what will receive less life."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du ein Ziel hinzufügst, überleg dir, worauf du in Zukunft weniger Zeit verwenden wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de añadir un objetivo, decide a qué vas a dedicar menos tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'ajouter un objectif, décide de ce à quoi tu vas consacrer moins de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di aggiungere un obiettivo, decidi a cosa dedicherai meno tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de adicionar uma meta, decida o que vai ficar em segundo plano."
          }
        }
      }
    },
    "practice.099.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой съществуващ ангажимент трябва да се свие, за да се побере новият?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which existing commitment must shrink for the new one to fit?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche bestehende Verpflichtung muss zurückgeschraubt werden, damit die neue Platz findet?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué compromiso actual tienes que dejar de lado para que quepa el nuevo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel engagement actuel faut-il réduire pour que le nouveau puisse trouver sa place ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale impegno già in corso devi ridimensionare per far posto a quello nuovo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual compromisso atual precisa ser reduzido para que o novo caiba?"
          }
        }
      }
    },
    "practice.100.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди лягане подготви първата задача, инструмента и часа на начало."
