    "practice.017.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Входящата кутия може да е празна, а истинската ти работа — недокосната."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
