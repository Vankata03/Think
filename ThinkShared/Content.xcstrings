    "practice.097.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не се измъчвай с мисли за целия си живот."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not disturb thyself by thinking of the whole of thy life."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quäle dich nicht damit, über dein ganzes Leben nachzudenken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te agobies pensando en toda tu vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne te tourmente pas en pensant à ta vie dans son ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tormentarti pensando a tutta la tua vita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se perturbe pensando na sua vida inteira."
          }
        }
      }
    },
    "practice.097.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое въображаемо бъдеще прави настоящата задача по-тежка?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which imagined future is making the present task heavier?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Vorstellung von der Zukunft macht die aktuelle Aufgabe schwerer?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué futuro imaginado está haciendo que la tarea actual te resulte más pesada?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle vision de l'avenir rend la tâche actuelle plus difficile ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale futuro immaginato sta rendendo più pesante il compito che stai affrontando adesso?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual futuro imaginário está tornando a tarefa atual mais pesada?"
          }
        }
      }
    },
    "practice.098.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови го честно и прави само това, без да примесваш останалото."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name it truthfully and do that one thing without mixing the others into it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenn es ehrlich und tu genau diese eine Sache, ohne andere Dinge mit hineinzumischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nómbrala con sinceridad y haz solo eso, sin mezclar otras cosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelle ça par son vrai nom et concentre-toi sur cette seule chose sans y mélanger les autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiamala con il suo vero nome e concentrati su quella cosa, senza mescolarci altre cose."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a ele um nome que reflita bem o que ele é e concentre-se nessa única função, sem misturar outras coisas nisso."
          }
        }
      }
    },
