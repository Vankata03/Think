    "path.deep-focus.step.7.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работното ти пространство взема решения преди теб."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workspace makes decisions for you before you make any yourself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Arbeitsbereich trifft Entscheidungen für dich, bevor du selbst welche triffst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu espacio de trabajo toma decisiones por ti antes de que tú mismo tomes ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton espace de travail prend des décisions à ta place avant même que tu n'en prennes toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo spazio di lavoro prende decisioni per te prima ancora che tu ne prenda una."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu espaço de trabalho toma decisões por você antes mesmo de você tomar qualquer decisão."
          }
        }
      }
    },
    "path.deep-focus.step.7.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчисти работното си пространство до необходимото за задачата пред теб."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear your workspace down to the essentials for the work in front of you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räume deinen Arbeitsplatz auf das Wesentliche für die anstehende Aufgabe herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despeja tu espacio de trabajo y quédate solo con lo imprescindible para la tarea que tienes entre manos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais le tri dans ton espace de travail pour ne garder que l'essentiel pour la tâche qui t'attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota la tua area di lavoro, lasciando solo l’essenziale per il lavoro che devi svolgere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa seu espaço de trabalho, deixando só o essencial para a tarefa que você tem pela frente."
          }
        }
      }
    },
