    "practice.034.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хората не се смущават от нещата, а от мненията си за тях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menschen werden nicht durch die Dinge beunruhigt, die geschehen, sondern durch ihre Urteile darüber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Men are disturbed not by the things which happen, but by the opinions about the things."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A los hombres no les perturban las cosas que pasan, sino las opiniones que tienen sobre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ne sont pas les événements eux-mêmes qui perturbent les hommes, mais l'opinion qu'ils s'en font."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli uomini non sono turbati dalle cose che accadono, ma dalle opinioni che si hanno su di esse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas não ficam perturbadas pelas coisas que acontecem, mas pelas opiniões que têm sobre elas."
          }
        }
      }
    },
