    "practice.005.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Каквито са обичайните ти мисли, такъв е и характерът на ума ти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie deine gewohnten Gedanken sind, so ist auch der Charakter deines Geistes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Such as are thy habitual thoughts, such also will be the character of thy mind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal como son tus pensamientos habituales, así será también el carácter de tu mente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes pensées habituelles déterminent le caractère de ton esprit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come sono i tuoi pensieri abituali, così sarà anche il carattere della tua mente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim como são seus pensamentos habituais, também será o caráter da sua mente."
          }
        }
      }
    },
    "practice.005.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя повтаряща се мисъл те оформя в грешна посока?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
