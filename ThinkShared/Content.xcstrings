    "practice.059.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чети по-малко. Спори повече с онова, което четеш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read less. Argue with more of it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies weniger. Setze dich mehr damit auseinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee menos. Discute más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis moins. Réfléchis davantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi meno. Metti maggiormente in discussione ciò che leggi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia menos. Conteste mais o que lê."
          }
        }
      }
    },
    "practice.059.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя идея си събрал, без да я провериш?"
