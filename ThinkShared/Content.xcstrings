    "practice.072.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Граница, обяснявана десет пъти, е преговор."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Grenze, die zehnmal erklärt wird, ist eine Verhandlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A boundary explained ten times is a negotiation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un límite que se explica diez veces ya es una negociación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une limite expliquée dix fois, c'est une négociation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un limite spiegato dieci volte è una negoziazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um limite explicado dez vezes já é uma negociação."
          }
        }
      }
    },
    "practice.072.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя граница се нуждае от спазване, а не от поредния аргумент?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Grenze braucht Konsequenz statt eines weiteren Arguments?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which boundary needs enforcement rather than another argument?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué límite hay que hacer valer en lugar de enzarzarse en otra discusión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle limite faut-il faire respecter plutôt que d'en venir à une nouvelle dispute ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale limite va fatto rispettare invece di litigare ancora?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual limite precisa ser respeitado, em vez de mais uma discussão?"
          }
        }
      }
    },
    "practice.073.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изкажи гледната си точка веднъж, после помоли другия да я обобщи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag deine Sichtweise einmal, dann bitte die andere Person, sie zusammenzufassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State your view once, then ask the other person to summarize it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expresa tu opinión una vez y luego pídele a la otra persona que la resuma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exprime ton point de vue une fois, puis demande à ton interlocuteur de le résumer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esprimi il tuo punto di vista una volta, poi chiedi all’altra persona di riassumerlo."
          }
        },
        "pt-BR": {
