            "value": "Reserve 25 minutos para uma tarefa exigente em um horário em que costuma ter energia."
          }
        }
      }
    },
    "path.deep-focus.step.14.title": {
      "comment": "Thinking path step title.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-трудното първо"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardest thing first"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schwierigste zuerst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo más difícil primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par le plus dur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia dalla cosa più difficile"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa pelo mais difícil"
          }
        }
      }
    },
    "path.deep-focus.step.15.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съобщенията запълват всяка пролука, която им оставиш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages expand to fill every gap you leave them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachrichten füllen jede Lücke aus, die du ihnen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes se amplían para llenar cada hueco que les dejes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages s'adaptent pour combler chaque pause que tu laisses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi si espandono per riempire ogni spazio che lasci libero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens se expandem para preencher cada lacuna que você deixar."
          }
        }
      }
    },
    "path.deep-focus.step.15.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plan two 10-minute message windows today. Keep exceptions for people or work that need a timely reply."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Планирай два периода по 10 минути за съобщения. Остави изключения за хора или работа, които изискват навременен отговор."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plane heute zwei Zeitfenster à 10 Minuten für Nachrichten. Erlaube Ausnahmen für Menschen oder Arbeit, die eine zeitnahe Antwort brauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Planifica dos bloques de 10 minutos para mensajes. Admite excepciones para personas o trabajo que necesiten una respuesta a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prévois deux créneaux de 10 minutes pour les messages. Garde des exceptions pour les personnes ou le travail qui demandent une réponse rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pianifica due finestre di 10 minuti per i messaggi. Prevedi eccezioni per persone o lavoro che richiedono una risposta tempestiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Planeje duas janelas de 10 minutos para mensagens. Mantenha exceções para pessoas ou trabalho que precisem de resposta rápida."
          }
        }
      }
    },
    "path.deep-focus.step.15.title": {
      "comment": "Thinking path step title.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Групирай повърхностното"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch the shallow"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Unwichtige bündeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja lo superficial para más adelante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupe les tâches superficielles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti da parte le cose superficiali"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa o que não é essencial"
          }
        }
      }
    },
    "path.deep-focus.step.16.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възстановяването не е противоположното на фокуса — то зарежда следващия блок."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery isn't the opposite of focus; it's what pays for the next block."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholung ist nicht das Gegenteil von Konzentration; sie ist das, was den nächsten Arbeitsblock erst möglich macht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación no es lo contrario de la concentración; es lo que te da fuerzas para el siguiente bloque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération, c'est pas le contraire de la concentration ; c'est ce qui te permet d'enchaîner la prochaine session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il recupero non è l’opposto della concentrazione; è ciò che ti dà la carica per il prossimo blocco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação não é o oposto do foco; é o que te dá energia para a próxima etapa."
          }
        }
      }
    },
    "path.deep-focus.step.16.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Take a 10-minute break: a walk if that suits you, or another form of rest, with your phone out of reach."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Почини 10 минути: разходка, ако ти е удобно, или друг вид почивка, с телефона извън обсег."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mach 10 Minuten Pause: einen Spaziergang, wenn er für dich passt, oder andere Ruhe, mit dem Telefon außer Reichweite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Descansa 10 minutos: pasea si te viene bien, o elige otro descanso, con el teléfono fuera de alcance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
