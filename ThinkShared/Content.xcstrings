    "practice.005.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши по-точна мисъл и се връщай към нея, когато старата се появи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib einen treffenderen Gedanken auf und ruf ihn zurück, wenn der alte erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a more accurate thought and return to it when the old one appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un pensamiento más preciso y vuelve a él cuando te venga el anterior."
          }
