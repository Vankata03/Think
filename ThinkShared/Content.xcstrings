    "practice.027.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко бързо се връщаш, когато вниманието, настроението или рутината ти се разклатят?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schnell kehrst du zurück, wenn Aufmerksamkeit, Stimmung oder Routine nachlässt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How quickly do you return after attention, mood, or routine slips?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto tardas en volver cuando se desvían tu atención, tu ánimo o tu rutina?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En combien de temps te remets-tu quand tu perds ta concentration, que ton humeur change ou que ta routine est perturbée ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ci metti a ritrovare la concentrazione, il buon umore o la routine quando ti capita di perderli?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que rapidez você volta ao normal depois que a atenção, o humor ou a rotina ficam meio fora de controle?"
          }
        }
      }
    },
