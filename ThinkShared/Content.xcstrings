            "state": "translated",
            "value": "Bereite die erste Aufgabe, das Werkzeug und die Startzeit noch vor dem Schlafengehen vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara la primera tarea, la herramienta y la hora de inicio antes de acostarte."
          }
        },
        "fr": {
