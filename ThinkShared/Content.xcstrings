    "practice.033.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови факта, преди да назовеш катастрофата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenn zuerst die Tatsache – dann erst die Katastrophe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the fact before you name the catastrophe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra el hecho antes de nombrar la catástrofe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomme le fait avant de nommer la catastrophe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla dei fatti prima di parlare della catastrofe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale do fato antes de falar da catástrofe."
          }
        }
      }
    },
    "practice.033.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво знаеш и какво си добавил?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was weißt du – und was hast du dazugedichtet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you know, and what have you added?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué sabes y qué has aportado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu sais, et qu'est-ce que tu as apporté de plus ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa sai e cosa hai aggiunto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você sabe e o que você acrescentou?"
          }
        }
      }
    },
    "practice.034.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Замени една абсолютна дума — винаги, никога, съсипано — с точно описание."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze ein absolutes Wort – immer, nie, ruiniert – durch eine genaue Beschreibung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace one absolute word—always, never, ruined—with a precise description."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye una palabra absoluta —siempre, nunca, arruinado— por una descripción precisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace un mot absolu — « toujours », « jamais », « fichu » — par une description précise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci una parola assoluta — sempre, mai, rovinato — con una descrizione precisa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca uma palavra absoluta — sempre, nunca, arruinado — por uma descrição precisa."
          }
        }
      }
    },
