          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a rule and a date when you are allowed to reconsider it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una regla y una fecha en la que puedas reconsiderarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris une règle et la date à laquelle tu auras le droit de la revoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una regola e una data entro la quale potrai riconsiderarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva uma regra e uma data em que você poderá repensá-la."
          }
        }
      }
    },
