        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale azione stai allenando attraverso la ripetizione, che tu lo voglia o no?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que ação você está treinando por meio da repetição, quer queira quer não?"
          }
        }
      }
    },
    "practice.015.action": {
