    "path.deep-focus.step.17.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готов си за повече работа на дълбочина."
