    "practice.054.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опонентът ти може да греши — но описанието ти на позицията му пак може да е нечестно."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The person you disagree with may be wrong; your summary of them can still be dishonest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gegenüber mag irren; trotzdem kann deine Darstellung seiner Position unehrlich sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La otra persona puede equivocarse; tu descripción de su postura aún puede ser deshonesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton adversaire peut avoir tort ; ta présentation de sa position peut pourtant être malhonnête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’altra persona può sbagliare; la tua descrizione della sua posizione può comunque essere disonesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa com quem você discorda pode estar errada; mesmo assim, o que você diz sobre ela pode não ser verdade."
          }
        }
      }
    },
    "practice.054.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Биха ли разпознали позицията си в описанието ти?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could they recognize their position in your description?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Könnten sie sich in deiner Beschreibung wiedererkennen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reconocería esa persona su postura en tu descripción?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Est-ce qu’ils se reconnaîtraient dans ta description ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riescono a riconoscersi nella tua descrizione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será que eles conseguiram se identificar com a descrição que você fez?"
          }
        }
      }
    },
    "practice.055.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спри за пет минути и запиши въпроса, който бързането крие."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause for five minutes and write the question speed is hiding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach fünf Minuten Pause und schreib die Frage auf, die sich hinter der Geschwindigkeit verbirgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómate cinco minutos y escribe la pregunta que se esconde tras la velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends cinq minutes pour t'arrêter et note la question que cache la vitesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una pausa di cinque minuti e scrivi la domanda che si nasconde dietro la velocità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pausa de cinco minutos e escreva a pergunta que a pressa esconde."
          }
        }
      }
    },
