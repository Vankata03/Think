    "path.deep-focus.step.8.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокусът се изгражда като физическа форма: добавяй обема постепенно."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus builds like fitness: add volume gradually."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzentration funktioniert wie Fitness: Steigere die Intensität schrittweise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentración se entrena como el ejercicio físico: ve aumentando la intensidad poco a poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentration, c'est comme le sport : augmente progressivement l'intensité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentrazione si allena come il fitness: aumenta gradualmente l’intensità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Focus funciona como um treino físico: aumente a intensidade aos poucos."
          }
        }
      }
    },
    "path.deep-focus.step.8.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи две 25-минутни сесии днес с истинска почивка между тях."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete two 25-minute sessions today with a real break between them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach heute zwei 25-minütige Sitzungen mit einer richtigen Pause dazwischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz hoy dos sesiones de 25 minutos cada una, con un descanso de verdad entre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais deux séances de 25 minutes aujourd’hui, en prenant une vraie pause entre les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi completa due sessioni da 25 minuti ciascuna, con una pausa vera e propria tra una e l’altra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça hoje duas sessões de 25 minutos, com um intervalo de verdade entre elas."
          }
        }
      }
