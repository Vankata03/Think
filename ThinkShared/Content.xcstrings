    "practice.014.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако искаш нещо да стане навик — просто го прави."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du zur Gewohnheit machen willst: Tu es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generally then if you would make anything a habit, do it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En general, si quieres convertir algo en un hábito, hazlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En gros, si tu veux prendre une habitude, lance-toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In generale, quindi, se vuoi trasformare qualcosa in un’abitudine, fallo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Então, de modo geral, se você quiser transformar alguma coisa em hábito, vá em frente."
          }
        }
      }
    },
    "practice.014.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое действие тренираш чрез повторение, искаш или не?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Handlung trainierst du durch Wiederholung – ob du es willst oder nicht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which action are you training through repetition, whether you mean to or not?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué acción estás practicando a base de repetición, lo quieras o no?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle action est-ce que tu entraînes par la répétition, que tu le veuilles ou non ?"
