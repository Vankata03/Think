    "practice.104.line": {
      "extractionState": "manual",
      "comment": "Original Think house practice. Generated copy; editorial and translation review pending.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A small question can make room for someone else's whole day."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Един малък въпрос може да отвори място за целия ден на друг човек."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine kleine Frage kann Raum für den ganzen Tag eines anderen Menschen schaffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una pequeña pregunta puede dar cabida a todo el día de otra persona."
          }
        },
        "fr": {
          "stringUnit": {
