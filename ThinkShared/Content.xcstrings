    "practice.008.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пълен ден може пак да е празен отговор."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein voller Tag kann trotzdem eine leere Antwort sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full day can still be an empty answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día entero puede seguir siendo una respuesta vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même une journée bien remplie peut rester une réponse vide de sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche una giornata intera può essere una risposta vuota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia inteiro ainda pode ser uma resposta vazia."
          }
        }
      }
    },
    "practice.008.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя дейност те кара да се чувстваш продуктивен, без да придвижва нищо важно?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Aktivität lässt dich produktiv fühlen, ohne wirklich etwas Wichtiges voranzubringen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which activity makes you feel productive without moving anything important?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué actividad te hace sentir productivo sin tener que mover nada importante?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle activité te donne l’impression d’être productif sans rien faire avancer d’important ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale attività ti fa sentire produttivo senza dover spostare nulla di importante?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual atividade faz você se sentir produtivo sem fazer nada importante avançar?"
          }
        }
      }
    },
    "practice.009.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди да заспиш, подготви едно полезно действие за първия час."
          }
        },
        "de": {
