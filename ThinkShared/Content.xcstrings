    "practice.009.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Първият ти час гласува, преди амбицията ти да се е събудила."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine erste Stunde wählt, bevor dein Ehrgeiz aufwacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first hour votes before your ambition wakes up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu primera hora es decisiva antes de que se despierte tu ambición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est pendant ta première heure que tu prends tes décisions, avant que ton ambition ne se réveille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prima ora è fondamentale prima che la tua ambizione si risvegli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua primeira hora é decisiva antes que sua ambição acorde."
          }
        }
      }
    },
    "practice.009.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За какво гласува първият ти час в момента?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür entscheidet sich deine erste Stunde gerade?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does your first hour currently vote for?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué te decantas ahora mismo en tu primera hora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi consacres-tu ta première heure en ce moment ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa scegli per la tua prima ora in questo momento?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que a sua primeira hora está votando?"
          }
        }
      }
    },
    "practice.010.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Побери я в едно изречение, после се върни към това пред теб."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib einen Satz darüber, dann wende dich wieder dem zu, was vor dir liegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it one written sentence, then return to what is in front of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbele una frase y luego vuelve a lo que tienes delante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne-lui une phrase écrite, puis retourne à ce que tu as sous les yeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una frase, poi torna a ciò che hai davanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva uma frase, depois volte ao que está na sua frente."
          }
        }
      }
    },
