    "practice.019.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо велико не се случва внезапно, казвал Епиктет — нито гроздето, нито смокинята."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Großes entsteht plötzlich, sagte Epiktet – auch nicht die Traube oder die Feige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing great, said Epictetus, is produced suddenly, since not even the grape or the fig is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nada grande —decía Epicteto— surge de repente, pues ni siquiera la uva ni el higo lo hacen»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Rien de grand, disait Épictète, ne naît du jour au lendemain, pas même le raisin ni la figue. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nulla di grande», diceva Epitteto, «nasce all’improvviso, poiché nemmeno l’uva o il fico lo fanno»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de grande, disse Epicteto, surge de repente, já que nem mesmo a uva ou o figo surgem assim."
          }
        }
      }
    },
    "practice.019.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какъв резултат изискваш преди неговото време?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Ergebnis forderst du, bevor es Zeit dafür ist?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What result are you demanding before its season?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué resultado esperas antes de que termine la temporada?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel résultat exiges-tu avant qu’il ne soit mûr ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che risultato ti aspetti prima della fine della stagione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que resultado você está exigindo antes da hora?"
          }
        }
      }
    },
