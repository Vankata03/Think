    "practice.040.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Денят може да не изпълни плана и пак да служи на целта си."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag kann seinen Plan verfehlen und trotzdem seinen Zweck erfüllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day can fail its plan and still serve its purpose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día puede no salir según lo planeado y aun así cumplir su propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée peut ne pas se dérouler comme prévu tout en remplissant son objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una giornata può non andare secondo i piani e comunque servire al suo scopo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dia pode não sair como planejado e, mesmo assim, cumprir seu propósito."
          }
        }
      }
    },
    "practice.040.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво все още има значение, след като днес се промени?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist jetzt noch wichtig, nachdem sich der Tag verändert hat?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What still matters now that today changed?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué sigue importando ahora que hoy ha cambiado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui compte encore maintenant que cette journée a changé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa conta ancora adesso che oggi è cambiato?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ainda importa agora que o dia de hoje mudou?"
          }
        }
      }
    },
    "practice.041.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Доближи се до него за пет минути, без да изискваш завършеност."
