        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale realtà stai cercando di negare con tutte le tue forze?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que realidade você está gastando energia tentando negar?"
          }
        }
      }
    },
    "practice.037.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
