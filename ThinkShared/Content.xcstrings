    "practice.007.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Повече информация може да е благоприличен начин да се криеш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Input kann eine salonfähige Form des Versteckens sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More input can be a respectable form of hiding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumir más información puede ser una forma respetable de esconderte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accumuler des informations peut être une manière respectable de se cacher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumare più informazioni può essere un modo rispettabile per nascondersi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais informações podem ser uma forma respeitável de se esconder."
          }
        }
      }
    },
    "practice.007.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво вече знаеш достатъчно, за да започнеш?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür weißt du bereits genug, um anzufangen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you already know enough to begin?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué sabes ya lo suficiente como para empezar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu sais déjà suffisamment pour commencer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa sai già abbastanza per iniziare?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você já sabe o suficiente para começar?"
          }
        }
      }
    },
    "practice.008.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Замени десет минути въртене с десет минути истинска работа."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze zehn Minuten Betrieb durch zehn Minuten echte Arbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace ten minutes of motion with ten minutes of the real work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia diez minutos de distracciones por diez minutos de trabajo de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace dix minutes d'agitation par dix minutes de vrai travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci dieci minuti di attività frenetica con dieci minuti di lavoro vero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca dez minutos de distração por dez minutos de trabalho de verdade."
          }
        }
      }
    },
