    "practice.025.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако системата ти изисква героизъм, тя все още не е система."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht dein System Heldenmut, ist es noch keins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your system needs heroics, it is not a system yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu sistema necesita hazañas heroicas, es que aún no es un sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ton système a besoin de faire des prouesses, c'est qu'il n'est pas encore un système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo sistema ha bisogno di gesta eroiche, allora non è ancora un sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu sistema precisa de feitos heróicos, ainda não é um sistema de verdade."
          }
        }
      }
    },
    "practice.025.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде разчиташ на усилие в последния момент?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo verlässt du dich auf Einsatz in letzter Minute?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you relying on last-minute effort?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué aspectos sigues confiando en el esfuerzo de última hora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quels domaines tu comptes sur des efforts de dernière minute ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quali situazioni ti affidi a uno sforzo dell’ultimo minuto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que áreas você ainda depende de esforços de última hora?"
          }
        }
      }
    },
    "practice.026.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери най-малкото повторение, което все още има значение, и го завърши."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die kleinste Wiederholung, die noch zählt – und mach sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the smallest repetition that still counts and complete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la repetición más pequeña que aún tenga sentido y hazla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis la plus petite répétition qui ait encore un sens et mène-la à bien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la ripetizione più piccola che abbia comunque senso e portala a termine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a menor repetição que ainda faça sentido e conclua-a."
          }
        }
      }
    },
