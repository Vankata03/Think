    "practice.074.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "От какво може да се нуждае този човек, без да знае как да го поиска?"
