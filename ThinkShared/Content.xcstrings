    "practice.030.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдели десет такива минути — без безкрайно превъртане и без известия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir zehn Minuten davon – ohne Feed oder Benachrichtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take ten minutes of that kind without a feed or notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómate diez minutos así, sin feeds ni notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends dix minutes comme ça, sans fil d'actualité ni notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concediti dieci minuti così, senza feed né notifiche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve dez minutos assim, sem feed nem notificações."
          }
        }
      }
    },
