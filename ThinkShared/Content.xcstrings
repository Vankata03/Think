    "practice.080.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш да оставиш място за някого, без да се изключиш самия себе си."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can leave room for someone without leaving yourself out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jemandem Raum lassen, ohne dich selbst dabei außen vor zu lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes dejar espacio para otra persona sin dejar de lado tus propias necesidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux faire de la place à quelqu'un d'autre sans pour autant te mettre de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi lasciare spazio a qualcun altro senza tralasciare te stesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode dar espaço para outra pessoa sem deixar de lado a si mesmo."
          }
        }
      }
    },
    "practice.080.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде грижата се е превърнала в самозаличаване?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where has care become self-erasure?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo ist Fürsorge zur Selbstauslöschung geworden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué momento el cuidado se ha convertido en una forma de borrarte a ti mismo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où le soin des autres est-il devenu effacement de soi ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In che momento la cura si è trasformata in autoannullamento?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que momento o cuidado se transformou em autoanulação?"
          }
        }
      }
    },
