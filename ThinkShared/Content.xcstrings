    "practice.034.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хората не се смущават от нещата, а от мненията си за тях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menschen werden nicht durch die Dinge beunruhigt, die geschehen, sondern durch ihre Urteile darüber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Men are disturbed not by the things which happen, but by the opinions about the things."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A los hombres no les perturban las cosas que pasan, sino las opiniones que tienen sobre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ne sont pas les événements eux-mêmes qui perturbent les hommes, mais l'opinion qu'ils s'en font."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli uomini non sono turbati dalle cose che accadono, ma dalle opinioni che si hanno su di esse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas não ficam perturbadas pelas coisas que acontecem, mas pelas opiniões que têm sobre elas."
          }
        }
      }
    },
    "practice.034.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое мнение усилва труден факт?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Urteil macht eine schwierige Tatsache noch schwerer?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which opinion is intensifying a difficult fact?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué opinión está agravando una situación ya de por sí difícil?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle opinion accentue encore plus la gravité d'une situation difficile ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale opinione sta esacerbando una situazione già difficile?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual opinião está dando mais peso a um fato difícil?"
          }
        }
      }
    },
    "practice.035.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери една обратима посока и задай дата за преглед."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine umkehrbare Richtung und setz ihr ein Überprüfungsdatum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one reversible direction and give it a date for review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una dirección reversible y ponle una fecha para revisarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une direction réversible et fixe une date pour la revoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una direzione reversibile e stabilisci una data per la revisione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma direção reversível e defina uma data para revisar."
          }
        }
      }
    },
