      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The hidden assumption"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скритото допускане"
          }
        },
        "de": {
          "stringUnit": {
