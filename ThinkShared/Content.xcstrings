    "practice.055.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Скоростта крие въпроси, на които търпението би те накарало да отговориш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed hides questions that patience would force you to answer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschwindigkeit verbirgt Fragen, die du mit Geduld beantworten müsstest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prisa oculta preguntas que la paciencia te obligaría a responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse te cache les questions auxquelles la patience t'obligerait à répondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fretta nasconde domande a cui la pazienza ti costringerebbe a rispondere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pressa esconde perguntas que a paciência te faria responder."
          }
        }
      }
    },
    "practice.055.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде бързаш, защото спирането може да промени плана?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you rushing because stopping might change the plan?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin hast du es so eilig, dass ein Anhalten den Plan durcheinanderbringen könnte?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A dónde vas con tanta prisa porque parar podría cambiar el plan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi tu te précipites comme ça, juste parce que t'arrêter pourrait changer tes plans ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove stai correndo così, solo perché fermarti potrebbe cambiare i piani?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para onde você está correndo, com medo de que parar possa mudar o plano?"
          }
        }
      }
    },
