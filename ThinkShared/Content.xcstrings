          "stringUnit": {
            "state": "translated",
            "value": "Qual reação sincera poderia ajudar a melhorar o trabalho?"
          }
        }
      }
    },
    "practice.086.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши едно правило, което да не допусне грешката отново, там, където ще го видиш следващия път."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write one prevention rule where you will see it next time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib eine Präventionsregel auf, wo du sie das nächste Mal sehen wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una regla de prevención en un sitio donde la veas la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris une règle de prévention à un endroit où tu la verras la prochaine fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una regola di prevenzione in un posto dove potrai vederla la prossima volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva uma regra de prevenção num lugar onde você possa vê-la da próxima vez."
          }
        }
      }
    },
