    "practice.053.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промяната на мнение не е загуба, когато истината е мерилото."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing your mind is not losing when truth is the score."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meinung zu ändern ist kein Verlust, wenn es um die Wahrheit geht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de opinión no es perder cuando lo que cuenta es la verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer d’avis, ce n’est pas perdre quand la vérité est l’objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare idea non significa perdere quando la verità è l’unico risultato che conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar de ideia não é perder quando o que importa é a verdade."
          }
        }
      }
    },
    "practice.053.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога последно нови данни промениха важно твое убеждение?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did new evidence last change an important view?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann haben neue Erkenntnisse das letzte Mal eine wichtige Sichtweise verändert?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo fue la última vez que nuevas pruebas cambiaron una opinión importante?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quand remonte la dernière fois où de nouvelles preuves ont fait évoluer une opinion importante ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è stata l’ultima volta che nuove prove hanno cambiato una visione importante?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando foi a última vez que novas evidências mudaram uma visão importante?"
          }
        }
      }
    },
    "practice.054.action": {
      "comment": "Concrete action paired with the daily line.",
