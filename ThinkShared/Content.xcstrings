        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz la versión más corta antes de acostarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais la plus petite version complète avant d'aller te coucher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai la versione più breve e completa prima di andare a dormire."
          }
        },
