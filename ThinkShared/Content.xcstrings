    "practice.085.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избягваната обратна връзка се превръща в самоналожен таван."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback avoided becomes a ceiling chosen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeidetes Feedback wird zu einer selbst gewählten Grenze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitar la retroalimentación se convierte en un techo que tú mismo eliges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les retours qu'on évite deviennent un plafond qu'on s'impose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il feedback che eviti diventa un limite che ti sei imposto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O feedback que a gente evita acaba se tornando um limite que a gente escolhe."
          }
        }
      }
    },
    "practice.085.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чия честна реакция би подобрила работата?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whose honest reaction could improve the work?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wessen ehrliche Reaktion könnte die Arbeit verbessern?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿La reacción sincera de quién podría mejorar el trabajo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle réaction sincère pourrait aider à améliorer ce travail ?"
