        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The inbox can be empty while your real work remains untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandeja de entrada puede estar vacía sin que tu trabajo de verdad se vea afectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta boîte de réception peut rester vide sans que ça n'affecte ton vrai boulot."
