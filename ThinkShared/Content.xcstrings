    "path.deep-focus.step.6.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако не можеш да се отегчиш, не можеш да се съсредоточиш. Поносимостта към скуката е мускулът отдолу."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you can't be bored, you can't be focused. Boredom tolerance is the muscle underneath."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dich nicht langweilen kannst, kannst du dich auch nicht konzentrieren. Die Fähigkeit, Langeweile zu ertragen, ist die Grundlage dafür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no eres capaz de aburrirte, no podrás concentrarte. La tolerancia al aburrimiento es la base de todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu ne sais pas t'ennuyer, tu ne peux pas te concentrer. La capacité à supporter l'ennui, c'est le muscle qui te permet d'y arriver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non riesci ad annoiarti, non riesci a concentrarti. La tolleranza alla noia è il muscolo che sta alla base di tutto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não consegue ficar entediado, não consegue se concentrar. A tolerância ao tédio é o músculo por trás disso."
          }
        }
      }
    },
    "path.deep-focus.step.6.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Седни 10 минути без нищо — без телефон, без музика, без книга. Просто седи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit for 10 minutes with no input — no phone, no music, no book. Just sit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich für 10 Minuten hin, ganz ohne Ablenkung – kein Handy, keine Musik, kein Buch. Setz dich einfach hin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate durante 10 minutos sin distracciones: sin móvil, sin música, sin libro. Solo siéntate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assieds-toi pendant 10 minutes sans rien faire d'autre : pas de téléphone, pas de musique, pas de livre. Contente-toi de t'asseoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti per 10 minuti senza distrazioni: niente telefono, niente musica, niente libri. Siediti e basta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senta por 10 minutos sem distrações — sem celular, sem música, sem livro. Apenas senta."
          }
        }
      }
    },
    "path.deep-focus.step.6.title": {
      "comment": "Thinking path step title.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
