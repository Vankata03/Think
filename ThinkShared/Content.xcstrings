    "practice.024.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Улесни правилното действие, преди да поискаш от себе си да станеш по-силен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach die richtige Handlung leichter, bevor du von dir Stärke verlangst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the right action easier before asking yourself to become stronger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que te resulte más fácil dar el paso adecuado antes de exigirte que seas más fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facilite-toi la bonne action avant de te demander de devenir plus fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi più facile compiere l’azione giusta prima di chiederti di diventare più forte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Facilite a ação certa antes de exigir de si mesmo que se torne mais forte."
          }
        }
      }
    },
    "practice.024.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво в средата ти гласува против намерението ти?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was in deiner Umgebung arbeitet gegen deine Absicht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What in your environment keeps voting against your intention?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué cosas de tu entorno siguen yendo en contra de lo que te propones?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui, dans ton environnement, ne cesse d'aller à l'encontre de tes intentions ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa c'è nel tuo ambiente che continua a ostacolare le tue intenzioni?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que no seu ambiente fica sempre indo contra o que você quer?"
          }
        }
      }
    },
