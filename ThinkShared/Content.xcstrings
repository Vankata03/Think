    "practice.078.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Извинение без практическа промяна е молба да се забрави."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An apology without changed logistics is a request to forget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Entschuldigung ohne Änderungen an den Rahmenbedingungen ist eine Aufforderung zum Vergessen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una disculpa sin cambios en los detalles prácticos es una petición para que lo olvides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des excuses sans changement concret, c'est une demande d'oubli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedere scusa senza cambiare nulla è come chiedere di dimenticare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pedido de desculpas sem mudanças na logística é um pedido para esquecer."
          }
        }
      }
    },
    "practice.078.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Каква конкретна промяна би направила извинението ти убедително?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What practical change would make your apology believable?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche konkrete Veränderung würde deine Entschuldigung glaubwürdig machen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué cambio práctico haría que tu disculpa resultara creíble?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel changement concret rendrait tes excuses crédibles ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale cambiamento concreto renderebbe credibili le tue scuse?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que mudança prática tornaria seu pedido de desculpas mais convincente?"
          }
        }
      }
    },
    "practice.079.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опиши същото събитие от най-полезната честна гледна точка."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the same event from the most workable honest angle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe dasselbe Ereignis aus dem realistischsten und ehrlichsten Blickwinkel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe el mismo suceso desde el punto de vista más realista y sincero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris le même événement sous l'angle le plus réaliste et le plus honnête possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi lo stesso evento dal punto di vista più realistico e sincero possibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o mesmo evento pelo ângulo mais prático e honesto possível."
          }
        }
      }
    },
