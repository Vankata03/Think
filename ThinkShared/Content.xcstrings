    "practice.010.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя мисъл продължава да взема от времето ти, без да стига до решение?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Gedanke kostet immer wieder Zeit, ohne zu einer Entscheidung zu führen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which thought keeps taking time without producing a decision?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pensamiento te sigue quitando tiempo sin que llegues a tomar una decisión?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle pensée te prend sans cesse du temps sans que tu arrives à te décider ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale pensiero continua a rubarti tempo senza portare a una decisione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual pensamento fica te ocupando o tempo sem que você consiga tomar uma decisão?"
          }
        }
      }
    },
    "practice.011.action": {
