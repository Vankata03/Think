    "practice.064.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма граница за онова, което веднъж е надхвърлило истинската мяра."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das wahre Maß einmal überschritten hat, kennt keine Grenzen mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no limit to that which has once passed the true measure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay límite para aquello que ya ha superado la verdadera medida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de limite à ce qui a déjà dépassé la vraie mesure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è limite a ciò che, una volta, ha superato la vera misura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há limite para aquilo que já passou pela verdadeira medida."
          }
        }
      }
    },
    "practice.064.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя роля изяжда енергия, предназначена за работата, която наистина можеш да вършиш?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Rolle frisst Energie, die du für Arbeit brauchst, die wirklich zu dir passt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which role is consuming energy that belongs to work you can truly do?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué aspecto te está quitando energía que podrías dedicar a lo que realmente sabes hacer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel rôle te prend l'énergie que tu pourrais consacrer à un travail que tu es vraiment capable de faire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale ruolo sta assorbendo le energie che dovresti dedicare al lavoro che sai davvero fare?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual função está consumindo a energia que você poderia usar para fazer o trabalho que realmente sabe fazer?"
          }
        }
      }
    },
    "practice.065.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи десет минути без намерение да споделяш резултата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeite zehn Minuten daran, ohne das Ergebnis teilen zu wollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do ten minutes of the work with no plan to share the result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica diez minutos a esta actividad sin pensar en compartir el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais dix minutes d'exercice sans avoir l'intention de partager le résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica dieci minuti a questo esercizio senza pensare di condividere il risultato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça dez minutos do exercício sem a intenção de compartilhar o resultado."
          }
        }
      }
    },
