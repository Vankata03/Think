    "practice.010.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не всяка мисъл заслужава среща."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht jeder Gedanke verdient eine Besprechung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not every thought deserves a meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No todos los pensamientos merecen una reunión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les pensées ne méritent pas qu'on s'y attarde."
