            "state": "translated",
            "value": "Was könntest du erklären, ohne die Quelle erneut zu öffnen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué podrías explicar sin volver a abrir la fuente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que pourrais-tu expliquer sans rouvrir la source ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa potresti spiegare senza riaprire il codice sorgente?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você conseguiria explicar sem precisar reabrir a fonte?"
          }
        }
