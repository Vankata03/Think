    "practice.057.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой показател изглежда добре, докато реалният резултат остава същият?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which metric looks good while the real outcome stays unchanged?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Kennzahl sieht gut aus, während das tatsächliche Ergebnis unverändert bleibt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué indicador parece bueno aunque el resultado real no cambie?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel indicateur semble satisfaisant alors que le résultat réel reste inchangé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale parametro sembra positivo mentre il risultato reale rimane invariato?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual métrica parece boa, mesmo que o resultado real continue o mesmo?"
          }
        }
      }
    },
    "practice.058.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
