    "practice.102.line": {
      "extractionState": "manual",
      "comment": "Original Think house practice. Generated copy; editorial and translation review pending.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enough is a decision you can make before you are exhausted."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Достатъчно е решение, което можеш да вземеш, преди да се изтощиш."
