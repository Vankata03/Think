    "practice.075.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-трудният разговор трупа лихва, докато го избягваш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das schwerste Gespräch wird teurer, je länger du es meidest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hardest conversation grows interest while you avoid it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversación más difícil acumula intereses mientras la evitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation la plus difficile accumule des intérêts tant que tu l’évites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversazione più difficile accumula interessi mentre la eviti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa mais difícil cobra juros enquanto você a evita."
          }
        }
      }
    },
    "practice.075.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво поскъпва, защото остава неизказано?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was wird teurer, weil es unausgesprochen bleibt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is getting more expensive because it remains unsaid?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué se está encareciendo porque no se dice nada al respecto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui devient de plus en plus cher parce qu'on n'en parle pas ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa sta diventando più costoso proprio perché non viene detto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está ficando mais caro por não ser dito?"
          }
        }
      }
    },
    "practice.076.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дай им десет минути без никакъв екран наблизо."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ihnen zehn Minuten, ohne dass ein Bildschirm in Reichweite ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give them ten minutes with every screen out of reach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dales diez minutos con todas las pantallas fuera de tu alcance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accorde-leur dix minutes, loin de tous les écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi loro dieci minuti con ogni schermo fuori dalla loro portata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá a eles dez minutos com todas as telas fora de alcance."
          }
        }
      }
    },
