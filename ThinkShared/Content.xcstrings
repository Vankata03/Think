    "practice.066.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти не си най-лошият си ден, но носиш отговорност за следващата стъпка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht dein schlechtester Tag – aber für den nächsten Schritt bist du verantwortlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not your worst day, but you are responsible for the next move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No eres tu peor día, pero sí eres responsable de tu próximo paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'es pas ta pire journée, mais c'est à toi de décider de la suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei il tuo giorno peggiore, ma sei responsabile della prossima mossa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não é o seu pior dia, mas é responsável pelo próximo passo."
          }
        }
      }
    },
    "practice.066.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво можеш да поправиш, без да превръщаш провала в идентичност?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was lässt sich wiedergutmachen, ohne das Scheitern zur Identität zu machen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What repair is available without turning failure into identity?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué solución hay sin que el fracaso se convierta en parte de tu identidad?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment peut-on réparer sans que l'échec devienne une partie de notre identité ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale soluzione c'è senza trasformare il fallimento in parte della propria identità?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que tipo de recuperação é possível sem transformar o fracasso em identidade?"
          }
        }
      }
    },
    "practice.067.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши какво би следвал, ако никой не можеше да сравнява резултата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib auf, was du anstreben würdest, wenn niemand das Ergebnis vergleichen könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write what you would pursue if nobody could compare the result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe lo que perseguirías si nadie pudiera comparar el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris ce que tu ferais si personne ne pouvait comparer le résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi cosa faresti se nessuno potesse confrontare il risultato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva o que você faria se ninguém pudesse comparar o resultado."
          }
        }
      }
    },
