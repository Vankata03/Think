    "practice.005.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Каквито са обичайните ти мисли, такъв е и характерът на ума ти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie deine gewohnten Gedanken sind, so ist auch der Charakter deines Geistes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Such as are thy habitual thoughts, such also will be the character of thy mind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal como son tus pensamientos habituales, así será también el carácter de tu mente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes pensées habituelles déterminent le caractère de ton esprit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come sono i tuoi pensieri abituali, così sarà anche il carattere della tua mente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim como são seus pensamentos habituais, também será o caráter da sua mente."
          }
        }
      }
    },
    "practice.005.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя повтаряща се мисъл те оформя в грешна посока?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher wiederkehrende Gedanke formt dich in die falsche Richtung?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which repeated thought is shaping you in the wrong direction?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pensamiento recurrente te está llevando por el camino equivocado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle pensée récurrente te fait dériver dans la mauvaise direction ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale pensiero ricorrente ti sta portando nella direzione sbagliata?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual pensamento recorrente está te levando na direção errada?"
          }
        }
      }
    },
    "practice.006.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "При един преход днес спри за три вдишвания и избери следващото действие."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte vor einem Übergang inne, atme dreimal und wähle die nächste Aktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before one transition, stop for three breaths and choose the next action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de pasar a otra cosa, haz una pausa de tres respiraciones y elige qué hacer a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant chaque transition, prends le temps de faire trois respirations et choisis ce que tu vas faire ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di passare a un’altra attività, fermati per tre respiri e scegli cosa fare dopo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de cada transição, pare por três respirações e escolha o que fazer a seguir."
          }
        }
      }
    },
