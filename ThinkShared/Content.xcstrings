            "value": "Ask one basic question without apologizing for it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell eine einfache Frage, ohne dich dafür zu entschuldigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta básica sin disculparte por ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose une question simple, sans t'excuser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda semplice senza scusarti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta básica sem se desculpar por isso."
          }
        }
      }
    },
