          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'entraîner à gérer l'ennui"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenamento contro la noia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treinamento para lidar com o tédio"
          }
        }
      }
    },
    "path.deep-focus.step.7.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работното ти пространство взема решения преди теб."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workspace makes decisions for you before you make any yourself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Arbeitsbereich trifft Entscheidungen für dich, bevor du selbst welche triffst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu espacio de trabajo toma decisiones por ti antes de que tú mismo tomes ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton espace de travail prend des décisions à ta place avant même que tu n'en prennes toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo spazio di lavoro prende decisioni per te prima ancora che tu ne prenda una."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu espaço de trabalho toma decisões por você antes mesmo de você tomar qualquer decisão."
          }
        }
      }
    },
    "path.deep-focus.step.7.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spend five minutes clearing your workspace to the essentials for the work in front of you."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отдели пет минути да оставиш на работното си място само нужното за текущата задача."
