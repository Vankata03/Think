    "practice.069.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никога не смятай за изгодно за себе си онова, което ще те принуди да нарушиш обещанието си."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte nichts für nützlich, das dich zwingt, dein Wort zu brechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never value anything as profitable to thyself which shall compel thee to break thy promise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca consideres que algo te reporta beneficio si eso te obliga a romper tu promesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne considère jamais comme un avantage pour toi-même quelque chose qui t'obligerait à rompre ta promesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non considerare mai vantaggioso per te stesso nulla che ti costringa a infrangere una promessa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca considere vantajoso aquilo que obrigue você a quebrar sua promessa."
          }
        }
      }
    },
    "practice.069.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое привидно предимство те кара да станеш някой, когото не би уважавал?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher scheinbare Vorteil verlangt, dass du jemand wirst, den du nicht respektieren würdest?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which apparent advantage asks you to become someone you would not respect?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué ventaja aparente te pide que te conviertas en alguien a quien no respetarías?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel avantage apparent te demande de devenir quelqu’un que tu ne respecterais pas ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale vantaggio apparente ti spinge a diventare qualcuno che non rispetteresti?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que vantagem aparente te pede para virar alguém que você não respeitaria?"
          }
        }
      }
    },
    "practice.070.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поеми отговорност за една част, без да добавяш оправдание."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm für einen Teil Verantwortung, ohne eine Rechtfertigung hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take responsibility for one part without adding a justification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asume la responsabilidad de una parte sin dar excusas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assume la responsabilité d’un aspect sans chercher à te justifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assumiti la responsabilità di una parte senza aggiungere giustificazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assuma a responsabilidade por uma parte sem dar nenhuma justificativa."
          }
        }
      }
    },
