    "practice.063.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ценностите ти се виждат по-ясно в отказите, отколкото в биографията ти."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your values are easier to find in your refusals than in your bio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Werte lassen sich leichter in deinen Absagen erkennen als in deiner Biografie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus valores se ven más claramente en lo que rechazas que en tu biografía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est souvent dans tes refus qu'on reconnaît le mieux tes valeurs, plus que dans ta bio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi valori si riconoscono più facilmente dai tuoi \"no\" che dalla tua biografia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É mais fácil descobrir seus valores nas coisas que você recusa do que na sua biografia."
          }
        }
      }
    },
    "practice.063.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На какво трябва да кажеш „не“, за да кажеш „да“ на нещо истински важно?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What deserves a no so a real value can receive a yes?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was verdient ein „Nein“, damit ein echter Wert ein „Ja“ bekommen kann?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué se merece un «no» para que algo que realmente vale la pena pueda recibir un «sí»?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui mérite un « non » pour qu'une vraie valeur puisse recevoir un « oui » ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa merita un “no” affinché un vero valore possa ricevere un “sì”?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que merece um “não” para que algo de verdadeiro valor possa receber um “sim”?"
          }
        }
      }
    },
    "practice.064.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стесни едно обещание до честен и изпълним обхват."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenze ein Versprechen auf einen ehrlichen, machbaren Umfang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce one promise to an honest, finishable scope."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce una promesa a un alcance honesto que puedas cumplir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène une promesse à une portée honnête et réalisable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci ogni promessa a un obiettivo realistico e raggiungibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz uma promessa a um escopo honesto e que possa ser concluído."
          }
        }
      }
    },
