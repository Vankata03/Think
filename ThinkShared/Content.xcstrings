    },
    "path.deep-focus.step.13.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокусът не е да не се отклоняваш никога — а да забележиш отклонението и да се върнеш без драма."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus isn't never drifting — it's noticing the drift and coming back without drama."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich zu konzentrieren bedeutet nicht, niemals abzuschweifen – es bedeutet, das Abschweifen zu bemerken und ohne großes Aufhebens wieder zurückzukommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentración no consiste en no distraerte nunca, sino en darte cuenta de que te estás distrayendo y volver a centrarte sin dramas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentration, ce n'est pas de ne jamais se laisser distraire, c'est de remarquer quand on se laisse distraire et de revenir à l'essentiel sans en faire tout un plat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentrazione non significa non distrarsi mai: significa accorgersi quando la mente vaga e tornare al presente senza drammi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco não é nunca se distrair — é perceber quando a atenção se dispersa e voltar ao que estava fazendo sem drama."
          }
        }
      }
    },
    "path.deep-focus.step.13.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В една 25-минутна сесия брой колко пъти се връщаш след отклонение. Всяко връщане е повторение."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In one 25-minute session, count how many times you return after drifting. Each return is a rep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähle in einer 25-minütigen Sitzung, wie oft du zurückkommst, nachdem du abgeschweift bist. Jede Rückkehr ist eine Wiederholung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una sesión de 25 minutos, cuenta cuántas veces vuelves a centrarte después de distraerte. Cada vez que vuelves a centrarte cuenta como una repetición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant une session de 25 minutes, compte chaque retour à ta tâche après une distraction. Chaque retour est une répétition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una sessione di 25 minuti, conta quante volte torni al presente dopo aver divagato. Ogni volta che torni al presente è una ripetizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uma sessão de 25 minutos, conta quantas vezes você volta ao foco depois de se distrair. Cada vez que você volta é uma repetição."
          }
        }
      }
    },
    "path.deep-focus.step.13.title": {
      "comment": "Thinking path step title.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връщането е умението"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returning is the skill"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückkehren ist die Kunst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave está en volver"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour, c'est tout un art"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ritorno è l’abilità"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar é a habilidade"
          }
        }
      }
    },
    "path.deep-focus.step.14.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Волята е най-силна сутринта. Харчи я за важното, не за имейли."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Willpower is highest early. Spend it on what matters, not on email."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Willenskraft ist am Anfang am stärksten. Setze sie für das ein, was wirklich zählt – nicht für E-Mails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuerza de voluntad es mayor a primera hora. Úsala en lo que importa, no en el correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La force de volonté est à son maximum en début de journée. Utilise-la pour ce qui compte vraiment, pas pour tes e-mails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forza di volontà è al massimo all’inizio della giornata. Usala per le cose che contano, non per le e-mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A força de vontade é maior logo de manhã. Usa-a no que importa, não no e-mail."
          }
        }
      }
    },
    "path.deep-focus.step.14.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи най-натоварващата задача преди всичко лесно днес."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do your most demanding task before anything easy today."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige heute deine anspruchsvollste Aufgabe, bevor du dich an etwas Leichtes machst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy, haz primero la tarea más difícil antes de pasar a las más fáciles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui, commence par ta tâche la plus difficile avant de t’attaquer aux plus faciles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi, prima di fare qualsiasi cosa facile, occupati del compito più impegnativo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, faz a tarefa mais difícil antes de qualquer coisa fácil."
          }
        }
      }
    },
    "path.deep-focus.step.14.title": {
      "comment": "Thinking path step title.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-трудното първо"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardest thing first"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schwierigste zuerst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo más difícil primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par le plus dur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia dalla cosa più difficile"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa pelo mais difícil"
          }
        }
      }
    },
    "path.deep-focus.step.15.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съобщенията запълват всяка пролука, която им оставиш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages expand to fill every gap you leave them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachrichten füllen jede Lücke aus, die du ihnen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes se amplían para llenar cada hueco que les dejes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages s'adaptent pour combler chaque pause que tu laisses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi si espandono per riempire ogni spazio che lasci libero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens se expandem para preencher cada lacuna que você deixar."
          }
        }
      }
    },
    "path.deep-focus.step.15.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прегледай всички съобщения и имейли в един или два фиксирани прозореца днес — нищо между тях."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle all messages and email in one or two fixed windows today — nothing in between."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite heute alle Nachrichten und E-Mails in einem oder zwei festen Fenstern – nichts dazwischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona hoy mismo todos tus mensajes y correos en una o dos ventanas fijas, sin nada más entre medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gère tous tes messages et tes e-mails dans une ou deux fenêtres fixes aujourd’hui — rien d’autre entre les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci tutti i messaggi e le e-mail in una o due finestre fisse oggi stesso — niente in mezzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, lida com todas as mensagens e e-mails em uma ou duas janelas fixas — nada mais além disso."
          }
        }
      }
    },
    "path.deep-focus.step.15.title": {
      "comment": "Thinking path step title.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Групирай повърхностното"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch the shallow"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Unwichtige bündeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja lo superficial para más adelante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupe les tâches superficielles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti da parte le cose superficiali"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa o que não é essencial"
          }
        }
      }
    },
    "path.deep-focus.step.16.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Възстановяването не е противоположното на фокуса — то зарежда следващия блок."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery isn't the opposite of focus; it's what pays for the next block."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholung ist nicht das Gegenteil von Konzentration; sie ist das, was den nächsten Arbeitsblock erst möglich macht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación no es lo contrario de la concentración; es lo que te da fuerzas para el siguiente bloque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération, c'est pas le contraire de la concentration ; c'est ce qui te permet d'enchaîner la prochaine session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il recupero non è l’opposto della concentrazione; è ciò che ti dà la carica per il prossimo blocco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação não é o oposto do foco; é o que te dá energia para a próxima etapa."
          }
        }
      }
    },
    "path.deep-focus.step.16.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вземи си истинска почивка днес: разходка, навън ако може, без телефона."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take one real break today: a walk, outside if you can, phone left behind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönn dir heute mal eine echte Pause: einen Spaziergang, wenn möglich draußen, und lass dein Handy zu Hause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómate hoy un descanso de verdad: da un paseo, al aire libre si puedes, y deja el móvil en casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-toi une vraie pause aujourd’hui : va te promener, dehors si tu peux, en laissant ton téléphone de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concediti una vera pausa oggi: una passeggiata, all’aperto se puoi, lasciando il telefono a casa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pausa de verdade hoje: dê uma caminhada, ao ar livre se puder, e deixe o celular de lado."
          }
        }
      }
    },
    "path.deep-focus.step.16.title": {
      "comment": "Thinking path step title.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Почивката е част от работата"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest is part of work"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholung ist Teil der Arbeit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descanso forma parte del trabajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repos fait partie du travail"
          }
        },
        "it": {
