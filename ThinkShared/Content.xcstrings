    "path.clear-thinking.tagline": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A seven-lesson introduction to clearer decisions"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Въведение в по-ясните решения със седем урока"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sieben Lektionen als Einstieg in klarere Entscheidungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una introducción de siete lecciones a decisiones más claras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sept leçons pour aborder des décisions plus claires"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sette lezioni introduttive per decisioni più chiare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma introdução de sete lições a decisões mais claras"
          }
        }
      }
    },
    "path.deep-focus.name": {
      "comment": "Thinking path name.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дълбок фокус"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep focus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefe Konzentration"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentración profunda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentration profonde"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrazione profonda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentração profunda"
          }
        }
      }
    },
    "path.deep-focus.step.1.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вниманието се плъзга само по себе си. За да го задържиш, трябва първо да видиш накъде отива."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention drifts by default. Before you can hold it, you have to see where it goes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufmerksamkeit schweift von Natur aus ab. Bevor du sie festhalten kannst, musst du erst einmal sehen, wohin sie wandert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La atención se desvía por defecto. Antes de poder mantenerla, tienes que ver adónde va."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, l'attention a tendance à vagabonder. Avant de pouvoir la retenir, il faut d'abord voir où elle va."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attenzione tende a vagare per natura. Prima di riuscire a trattenerla, devi capire dove va a finire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, a atenção se dispersa. Antes de conseguir mantê-la, você precisa ver para onde ela vai."
          }
        }
      }
    },
    "path.deep-focus.step.1.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи 10 минути върху едно нещо. Отбелязвай всеки порив да превключиш. Само брой — без да осъждаш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work for 10 minutes on one thing. Keep a tally of every urge to switch. Just count — don't judge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeite 10 Minuten lang an einer Sache. Notiere dir jeden Drang, etwas anderes zu machen. Zähle einfach – urteile nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 10 minutos a una sola cosa. Anota cada vez que sientas la tentación de cambiar de actividad. Solo cuenta, sin juzgar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-toi pendant 10 minutes sur une seule chose. Note chaque envie de passer à autre chose. Contente-toi de compter, sans juger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrati per 10 minuti su una sola cosa. Tieni il conto di ogni impulso a cambiare attività. Contali e basta, senza giudicare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre-se por 10 minutos em uma única coisa. Anote cada vontade que tiver de mudar de atividade. Apenas conte — não julgue."
          }
        }
      }
    },
    "path.deep-focus.step.1.title": {
      "comment": "Thinking path step title.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Усети привличането"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice the pull"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte auf den Reiz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fíjate en el tirón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarque l'attrait"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai caso al richiamo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repara na atração"
          }
        }
      }
    },
    "path.deep-focus.step.2.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокусът започва преди работата: с една ясно определена цел."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus starts before the work: with a single, clearly defined target."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konzentration beginnt schon vor der Arbeit: mit einem einzigen, klar definierten Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentración empieza antes de ponerte a trabajar: con un único objetivo bien definido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentration commence avant même de se mettre au travail : avec un seul objectif clairement défini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentrazione inizia prima ancora di mettersi al lavoro: con un unico obiettivo ben definito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O foco começa antes do trabalho: com uma meta única e bem definida."
          }
        }
      }
    },
    "path.deep-focus.step.2.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spend 10 minutes defining one important task and what 'done' looks like, then begin its first step."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отдели 10 минути да определиш важна задача и как изглежда завършена, после започни първата стъпка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Definiere in 10 Minuten eine wichtige Aufgabe und was „fertig“ bedeutet. Beginne dann den ersten Schritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dedica 10 minutos a definir una tarea importante y qué significa terminarla; comienza su primer paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prends 10 minutes pour définir une tâche importante et ce que signifie la terminer, puis commence le premier pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dedica 10 minuti a definire un compito importante e cosa significa finirlo, poi inizia il primo passo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use 10 minutos para definir uma tarefa importante e o que significa concluí-la; depois comece o primeiro passo."
          }
        }
      }
    },
    "path.deep-focus.step.2.title": {
      "comment": "Thinking path step title.",
      "extractionState": "manual",
      "localizations": {
