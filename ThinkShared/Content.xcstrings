        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the smallest repair before explaining what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz la reparación más pequeña antes de explicar lo que ha pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par faire la plus petite réparation avant d'expliquer ce qui s'est passé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai la piccola correzione prima di spiegare cosa è successo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o conserto mais básico antes de explicar o que aconteceu."
          }
        }
      }
    },
