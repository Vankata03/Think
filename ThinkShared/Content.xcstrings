            "value": "Una cosa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma coisa"
          }
        }
      }
    },
    "path.deep-focus.step.3.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонът не се побеждава с дисциплина — а с разстояние."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't resist your phone with discipline — you resist it with distance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du widerstehst deinem Handy nicht mit Disziplin – du widerstehst ihm mit Abstand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te enfrentas al móvil con disciplina, sino con distancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne résistes pas à ton téléphone par la discipline, mais en gardant tes distances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ti opponi al tuo telefono con la disciplina, ma con la distanza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não resiste ao seu celular com disciplina — você resiste com distância."
          }
        }
      }
    },
    "path.deep-focus.step.3.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи една 25-минутна сесия с телефона в друга стая."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one 25-minute session with your phone in another room."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach eine 25-minütige Sitzung, während dein Handy in einem anderen Zimmer liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una sesión de 25 minutos dejando el móvil en otra habitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais une séance de 25 minutes en laissant ton téléphone dans une autre pièce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una sessione di 25 minuti lasciando il telefono in un’altra stanza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma sessão de 25 minutos com seu celular em outro cômodo."
          }
        }
      }
    },
    "path.deep-focus.step.3.title": {
      "comment": "Thinking path step title.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разстоянието бие волята"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance beats willpower"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanz ist stärker als Willenskraft"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia vence a la fuerza de voluntad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance l'emporte sur la volonté"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza batte la forza di volontà"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância supera a força de vontade"
          }
        }
      }
    },
    "path.deep-focus.step.4.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Започването е най-трудното, затова направи началото смешно малко."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting is the hardest part, so make the start laughably small."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anfang ist das Schwierigste, also mach den Anfang lächerlich klein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar es lo más difícil, así que haz que el primer paso sea ridículamente pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus dur, c'est de se lancer, alors commence par quelque chose de ridiculement petit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniziare è la parte più difficile, quindi rendi il primo passo ridicolmente piccolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar é a parte mais difícil, então faz com que o começo seja ridiculamente pequeno."
          }
        }
      }
    },
    "path.deep-focus.step.4.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вземи задачата, която избягваш, и работи по нея само две минути. Продължи само ако искаш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take the task you've been dreading and work on it for just two minutes. Continue only if you want to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir die Aufgabe vor, vor der du dich so gefürchtet hast, und arbeite nur zwei Minuten daran. Mach nur weiter, wenn du Lust dazu hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coge esa tarea que tanto te da pereza y dedícale solo dos minutos. Sigue solo si te apetece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends la tâche que tu redoutes et consacre-lui juste deux minutes. Ne continue que si tu en as envie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi il compito che stai rimandando da tempo e lavoraci per soli due minuti. Continua solo se ne hai voglia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega aquela tarefa que você tá adiando e dedica só dois minutos a ela. Só continua se quiser."
          }
        }
      }
    },
    "path.deep-focus.step.4.title": {
      "comment": "Thinking path step title.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Старт от две минути"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two-minute start"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zweiminütige Einstieg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos minutos iniciales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux premières minutes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I primi due minuti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois minutos iniciais"
          }
        }
      }
    },
    "path.deep-focus.step.5.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки отворен таб е обещание да се прекъснеш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every open tab is a promise to interrupt yourself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder geöffnete Tab ist ein Versprechen, dich selbst zu unterbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pestaña abierta es una promesa de que te vas a distraer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque onglet ouvert est une promesse de t’interrompre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scheda aperta è una promessa di interrompere te stesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aba aberta é uma promessa de que você vai se distrair."
          }
        }
      }
    },
    "path.deep-focus.step.5.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи една 25-минутна сесия с един прозорец и един таб."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one 25-minute session with a single window and a single tab open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach eine 25-minütige Sitzung, bei der nur ein Fenster und ein Tab geöffnet sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una sesión de 25 minutos con una sola ventana y una sola pestaña abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais une séance de 25 minutes avec une seule fenêtre et un seul onglet ouverts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una sessione di 25 minuti con una sola finestra e una sola scheda aperte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma sessão de 25 minutos com apenas uma janela e uma aba abertas."
          }
        }
      }
    },
    "path.deep-focus.step.5.title": {
      "comment": "Thinking path step title.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
