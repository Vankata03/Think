    "practice.071.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Закъснялото „не“ се превръща в нечестно „да“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein aufgeschobenes Nein wird zu einem unehrlichen Ja."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A delayed no becomes a dishonest yes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un «no» que se retrasa se convierte en un «sí» falso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un « non » qui traîne devient un « oui » hypocrite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un “no” detto in ritardo diventa un “sì” disonesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um “não” adiado vira um “sim” desonesto."
          }
        }
      }
    },
    "practice.071.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде учтивостта те кара да даваш обещания, които не можеш да спазиш?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo erschafft Höflichkeit ein Versprechen, das du nicht halten kannst?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where is politeness creating a promise you cannot keep?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué situaciones la cortesía te lleva a hacer una promesa que no puedes cumplir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quels cas la politesse t'amène-t-elle à faire une promesse que tu ne peux pas tenir ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quali casi la cortesia ti porta a fare promesse che non puoi mantenere?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que situações a educação acaba criando uma promessa que você não consegue cumprir?"
          }
        }
      }
    },
    "practice.072.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
