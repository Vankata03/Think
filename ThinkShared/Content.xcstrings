    "practice.093.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Помни — всеки човек живее единствено в настоящия миг."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bear in mind that every man lives only this present time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk daran, dass jeder Mensch nur im Hier und Jetzt lebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que cada persona vive solo este momento presente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde à l'esprit que chaque homme ne vit que le moment présent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricorda che ogni persona vive solo questo momento presente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra que todo mundo vive só o momento presente."
          }
        }
      }
    },
    "practice.093.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво заслужава настоящия час, вместо смътно бъдещо обещание?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What deserves the present hour rather than a vague future promise?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was verdient die Gegenwart mehr als ein vages Versprechen für die Zukunft?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué se merece más el momento presente que una vaga promesa de futuro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui mérite qu'on s'y consacre maintenant plutôt qu'une vague promesse d'avenir ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa merita l’ora presente piuttosto che una vaga promessa per il futuro?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que merece a atenção agora, em vez de uma vaga promessa para o futuro?"
          }
        }
      }
    },
