    "practice.020.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„По-късно“ е избор с невидима цена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Später ist eine echte Entscheidung mit einer unsichtbaren Quittung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later is a real choice with an invisible receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Más tarde» es una decisión real con un recibo invisible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remettre à plus tard est un vrai choix dont la facture reste invisible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Più tardi» è una scelta reale con una ricevuta invisibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiar é uma escolha real com um recibo invisível."
          }
        }
      }
    },
    "practice.020.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко ще струва отлагането, ако го повторяш месец?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was kostet das Aufschieben, wenn es einen Monat lang wiederholt wird?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What will delay cost if repeated for a month?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto te costaría el retraso si se repitiera durante un mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que coûtera ce report s’il se répète pendant un mois ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ti costerà rimandare se lo fai per un mese?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto custaria o atraso se isso se repetisse durante um mês?"
          }
        }
      }
    },
    "practice.021.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Установи едно правило, което прави утрешния избор автоматичен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimme jetzt einen Standard, der morgen die Wahl abnimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set one default that makes tomorrow's choice automatic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece una opción predeterminada que haga que la elección de mañana sea automática."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis un choix par défaut pour que celui de demain se fasse tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un'opzione predefinita che renda automatica la scelta di domani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina uma opção padrão que torne a escolha de amanhã automática."
          }
        }
      }
    },
