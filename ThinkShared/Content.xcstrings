    },
    "practice.094.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На какво ще отделяш по-малко време, ако тази цел е истинска?"
