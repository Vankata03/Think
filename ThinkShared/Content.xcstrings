    "practice.012.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачата, която постоянно преименуваш, си остава същата задача."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe, die du immer wieder umbenennst, bleibt die Aufgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task you keep renaming is still the task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea a la que no paras de cambiar el nombre sigue siendo la misma tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche que tu n'arrêtes pas de renommer reste toujours la même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il compito che continui a rinominare è sempre lo stesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa que você fica mudando de nome continua sendo a mesma tarefa."
          }
        }
      }
    },
    "practice.012.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво си прикрил като планиране, проучване или подготовка?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hast du als Planung, Recherche oder Vorbereitung getarnt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What have you disguised as planning, research, or preparation?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es lo que has hecho pasar por planificación, investigación o preparación?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu as fait passer pour de la planification, de la recherche ou de la préparation ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa hai mascherato da pianificazione, ricerca o preparazione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você tem disfarçado de planejamento, pesquisa ou preparação?"
          }
        }
      }
    },
    "practice.013.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свий първата стъпка до две минути и я направи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkleinere den Anfang, bis er zwei Minuten dauert – dann tu es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink the start until it takes two minutes, then do it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce la duración del ejercicio inicial hasta que te lleve dos minutos y, luego, hazlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduis la durée de la séance de départ jusqu'à ce qu'elle ne dure que deux minutes, puis lance-toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci il tempo iniziale fino a due minuti, poi mettiti all’opera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza o tempo inicial até que dure dois minutos, depois faça isso."
          }
        }
      }
    },
