            "value": "Befass dich fünf Minuten damit, ohne Abschluss zu erwarten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approach it for five minutes without requiring completion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébala durante cinco minutos sin necesidad de terminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie-la pendant cinq minutes, sans te mettre la pression pour aller jusqu'au bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provala per cinque minuti senza sentirti in dovere di portarla a termine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime-se disso por cinco minutos, sem exigir concluir."
          }
        }
      }
    },
