        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pensamiento recurrente te está llevando por el camino equivocado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle pensée récurrente te fait dériver dans la mauvaise direction ?"
          }
