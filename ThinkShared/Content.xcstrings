      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Увереността, изградена преди действие, е предимно въображение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuversicht, die vor dem Handeln entsteht, ist meistens Einbildung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidence built before action is mostly imagination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La confianza que se genera antes de actuar es, en gran parte, fruto de la imaginación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confiance qu'on se forge avant d'agir, c'est surtout une question d'imagination."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiducia che si costruisce prima di agire è per lo più frutto dell’immaginazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A confiança que a gente constrói antes de agir é, em grande parte, imaginação."
          }
        }
      }
    },
    "practice.018.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За какво чакаш да се почувстваш готов?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worauf wartest du, um dich bereit zu fühlen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are you waiting to feel ready for?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué estás esperando para sentirte preparado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu attends pour te sentir prêt ?"
          }
        },
        "it": {
