    "practice.023.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандарт, който не можеш да спазиш в лош ден, е просто поза."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Maßstab, den du an schlechten Tagen nicht lebst, ist nur Theater."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A standard you cannot practice on a bad day is a performance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estándar que no puedes mantener en un mal día es solo una actuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une performance, c'est une norme que tu ne peux pas respecter quand tu passes une mauvaise journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cosa che non puoi mettere in pratica quando hai una giornata no è una performance."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um padrão que você não consegue sustentar num dia ruim é encenação."
          }
        }
      }
    },
    "practice.023.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какъв е честният минимум за най-трудните ти дни?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist das ehrliche Minimum für deine härtesten Tage?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is the honest minimum for your hardest days?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es lo mínimo que necesitas de verdad para tus días más duros?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est quoi, le strict minimum dont tu as besoin pour tes journées les plus dures ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è il minimo indispensabile per affrontare i tuoi giorni più difficili?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é o mínimo que você realmente precisa nos seus dias mais difíceis?"
          }
        }
      }
    },
    "practice.024.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Премести, скрий или приготви един предмет, за да направиш по-доброто действие по-лесно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieb, versteck oder bereite einen Gegenstand vor, damit die bessere Wahl leichter fällt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move, block, or prepare one object so the better action becomes easier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve, bloquea o prepara un objeto para que la mejor acción resulte más fácil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace, bloque ou prépare un objet pour que la meilleure action devienne plus facile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta, blocca o prepara un oggetto in modo che l’azione migliore diventi più facile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova, bloqueie ou prepare um objeto para que a melhor ação fique mais fácil."
          }
        }
      }
    },
