    "practice.089.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторение без наблюдение вгражда грешките."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetition without observation hardens mistakes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholung ohne Reflexion verfestigt Fehler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La repetición sin observación consolida los errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répéter sans observer, ça ne fait que renforcer les erreurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripetere senza riflettere non fa che radicare gli errori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A repetição sem observação consolida os erros."
          }
        }
      }
    },
    "practice.089.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво повтаряш, без да проверяваш дали се подобрява?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you repeat without checking whether it improves?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was wiederholst du, ohne zu prüfen, ob es besser wird?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es lo que repites sin comprobar si mejora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu répètes sans vérifier si ça s'améliore ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ripeti senza controllare se migliora?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você repete sem verificar se isso traz alguma melhora?"
          }
        }
      }
    },
