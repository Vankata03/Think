    "practice.042.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Смелостта не е в силата на гласа. Понякога е едно нередактирано изречение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mut ist keine Frage der Lautstärke. Manchmal ist er ein einziger unkorrigierter Satz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Courage is not volume. Sometimes it is one unedited sentence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor no está en el volumen. A veces basta con una sola frase sin editar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le courage, ce n'est pas une question de volume. Parfois, c'est juste une phrase, sans fioritures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il coraggio non sta nel volume. A volte basta una sola frase, senza fronzoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coragem não é volume. Às vezes, é só uma frase sem edições."
          }
        }
      }
    },
    "practice.042.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое истинско изречение омекотяваш до неузнаваемост?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welchen wahren Satz glättest du, bis er unkenntlich wird?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What true sentence are you softening past recognition?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué verdad estás suavizando hasta dejarla irreconocible?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle vérité es-tu en train d'édulcorer au point de la rendre méconnaissable ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale verità stai edulcorando al punto da renderla irriconoscibile?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que verdade você está suavizando a ponto de ficar irreconhecível?"
          }
        }
      }
    },
    "practice.043.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сложи десет минути между порива и решението."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg zehn Minuten zwischen den Impuls und die Entscheidung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a ten-minute delay between the impulse and the choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja pasar diez minutos entre el impulso y la decisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévois un délai de dix minutes entre l'impulsion et le choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti dieci minuti di pausa tra l’impulso e la scelta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá um tempo de dez minutos entre o impulso e a escolha."
          }
        }
      }
    },
