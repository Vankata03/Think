        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you waiting for encouragement before acting?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo wartest du noch auf Ermutigung, bevor du handelst?"
          }
