    "practice.064.v2.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма граница за онова, което веднъж е надхвърлило истинската мяра."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das wahre Maß einmal überschritten hat, kennt keine Grenzen mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no limit to that which has once passed the true measure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay límite para aquello que ya ha superado la verdadera medida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de limite à ce qui a déjà dépassé la vraie mesure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è limite a ciò che, una volta, ha superato la vera misura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há limite para aquilo que já passou pela verdadeira medida."
          }
        }
      }
    },
    "practice.064.v2.question": {
      "extractionState": "manual",
      "comment": "Editorial revision 2. Generated copy; editorial and translation review pending. v1 remains unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "What would enough look like for one possession you want?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Как би изглеждало достатъчното за една вещ, която искаш?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was wäre bei einem Gegenstand, den du möchtest, genug?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Qué sería suficiente para una posesión que deseas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qu'est-ce qui serait suffisant pour un objet que tu désires ?"
