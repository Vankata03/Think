    "practice.048.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Комфортът е полезен за възстановяване и скъп като компас."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komfort ist nützlich zur Erholung und teuer als Kompass."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comfort is useful for recovery and expensive as a compass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comodidad sirve para recuperarte, pero sale cara como brújula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le confort aide à récupérer, mais coûte cher quand il sert de boussole."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La comodità è utile per recuperare, ma costosa come bussola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conforto ajuda na recuperação, mas sai caro como bússola."
          }
        }
      }
    },
    "practice.048.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
