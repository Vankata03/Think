    "practice.046.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Животът, който искаш, може да е затрупан под ангажименти, спазвани само за да избегнеш неловкостта."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wunschleben liegt vielleicht unter Pflichten begraben, die du nur erfüllst, um Unbehagen zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The life you want may be buried under commitments kept only to avoid awkwardness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vida que quieres puede quedar sepultada bajo compromisos que mantienes solo por evitar incomodidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vie que tu veux est peut-être enfouie sous des engagements gardés par peur du malaise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vita che vuoi può essere sepolta sotto impegni mantenuti solo per evitare disagio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vida que você quer pode estar enterrada sob compromissos assumidos só para evitar constrangimentos."
          }
        }
      }
    },
    "practice.046.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой ангажимент би отказал, ако ти го предложат днес?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Verpflichtung würdest du ablehnen, wenn man sie dir heute anbieten würde?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which commitment would you decline if it were offered today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué compromiso rechazarías si te lo ofrecieran hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel engagement refuserais-tu si on te le proposait aujourd’hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale impegno rifiuteresti se ti venisse proposto oggi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual compromisso você recusaria se te oferecessem hoje?"
          }
        }
      }
    },
    "practice.047.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Повтори веднъж като начинаещ и си позволи несъвършен резултат."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Üb einmal wie ein Anfänger, ohne ein gutes Ergebnis zu brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one beginner repetition where the result can be imperfect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una repetición de principiante en la que el resultado pueda ser imperfecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un essai de débutant où le résultat peut être imparfait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una ripetizione da principiante, anche se il risultato potrebbe non essere perfetto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma repetição para iniciantes, em que o resultado pode não ser perfeito."
          }
        }
      }
    },
