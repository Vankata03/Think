    "practice.006.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Качеството на деня се крие в преходите му."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Qualität eines Tages verbirgt sich in seinen Übergängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quality of a day is hidden in its transitions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La calidad de un día está en sus momentos de transición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est dans les transitions qu'on trouve la qualité d'une journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La qualità di una giornata sta proprio nei suoi momenti di transizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A qualidade de um dia está nas transições."
          }
        }
      }
    },
    "practice.006.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде губиш посока между една задача и следващата?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo verlierst du zwischen einer Aufgabe und der nächsten den Faden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you lose direction between one task and the next?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué momento pierdes el rumbo entre una tarea y la siguiente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel moment tu te sens perdu entre deux tâches ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quale momento perdi la rotta tra un compito e l’altro?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que momento você perde o rumo entre uma tarefa e outra?"
          }
        }
      }
    },
    "practice.007.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не приемай нищо ново по темата, докато не създадеш един малък резултат."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsumiere nichts dazu, bis du ein erstes kleines Ergebnis produziert hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consume nothing about it until you produce one small result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No consumas nada más sobre el tema hasta producir un pequeño resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne consulte plus rien à ce sujet avant d’avoir produit un petit résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non consumare altro materiale sull’argomento finché non produci un piccolo risultato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consuma mais nada sobre isso até produzir um pequeno resultado."
          }
        }
      }
    },
