    "path.clear-thinking.step.3.lesson": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plans often depend on something we have not checked. An assumption is a useful question to investigate, not proof that your plan is wrong."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Плановете често зависят от нещо, което не сме проверили. Допускането е полезен въпрос за проучване, а не доказателство, че планът ви е грешен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pläne hängen oft von etwas ab, das wir nicht geprüft haben. Eine Annahme ist eine nützliche Frage, der du nachgehen kannst – kein Beweis, dass dein Plan falsch ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los planes suelen depender de algo que no hemos comprobado. Una suposición es una pregunta útil que investigar, no una prueba de que tu plan esté equivocado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les plans dépendent souvent de quelque chose que nous n'avons pas vérifié. Une hypothèse est une question utile à explorer, pas la preuve que votre plan est mauvais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I piani spesso dipendono da qualcosa che non abbiamo verificato. Un'ipotesi è una domanda utile da indagare, non la prova che il tuo piano sia sbagliato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os planos muitas vezes dependem de algo que não verificamos. Uma suposição é uma pergunta útil para investigar, não uma prova de que seu plano está errado."
          }
        }
      }
    },
    "path.clear-thinking.step.3.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save one plan, the assumption it depends on, and a small way to check that assumption."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете един план, допускането, от което зависи, и малък начин да проверите това допускане."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere einen Plan, die Annahme, von der er abhängt, und eine kleine Möglichkeit, diese Annahme zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda un plan, la suposición de la que depende y una forma sencilla de comprobar esa suposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez un plan, l'hypothèse dont il dépend et un petit moyen de vérifier cette hypothèse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva un piano, l'ipotesi da cui dipende e un piccolo modo per verificarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve um plano, a suposição da qual ele depende e uma forma simples de verificar essa suposição."
          }
        }
      }
    },
    "path.clear-thinking.step.3.smallerTask": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save one sentence beginning: I am assuming that…"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете едно изречение, което започва с: „Допускам, че…“"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
