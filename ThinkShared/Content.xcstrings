    "practice.062.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Личните стандарти са там, където характерът спира да се преструва."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private standards are where character stops performing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Maßstäbe sind der Punkt, an dem der Charakter aufhört, eine Rolle zu spielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los principios personales son donde el carácter deja de actuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est quand on en vient à ses principes personnels que le personnage cesse de jouer un rôle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È quando smetti di recitare che emerge il tuo vero carattere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os padrões pessoais são onde o caráter deixa de ser uma fachada."
          }
        }
      }
    },
    "practice.062.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой стандарт е важен дори когато никой не може да те награди?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What standard matters even when nobody can reward you?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Maßstab zählt, selbst wenn dich niemand dafür belohnen kann?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué criterio importa, incluso cuando nadie puede recompensarte?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle norme compte vraiment, même si personne ne peut te récompenser ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale criterio conta, anche quando nessuno può ricompensarti?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que tipo de padrão importa, mesmo quando ninguém pode te recompensar?"
          }
        }
      }
    },
    "practice.063.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Откажи, отмени или съкрати едно маловажно задължение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
