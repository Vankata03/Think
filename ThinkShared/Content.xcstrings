    "practice.084.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Завършването учи на различни неща от започването."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing teaches a different subject than starting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Beenden lehrt etwas anderes als das Beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar te enseña algo diferente a lo que te enseña empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller jusqu'au bout, c'est une autre histoire que de commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Portare a termine qualcosa ti insegna qualcosa di diverso rispetto all’inizio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluir ensina algo diferente do que começar."
          }
        }
      }
    },
    "practice.084.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое почти завършено нещо може да те научи на завършване?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which nearly finished piece of work could teach you about completion?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches fast fertige Werk könnte dir etwas über das Vollenden beibringen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué trabajo que ya casi has terminado podría enseñarte algo sobre la finalización?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle œuvre presque achevée pourrait t'apprendre ce qu'est l'achèvement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale lavoro quasi finito potrebbe insegnarti qualcosa sul portare a termine le cose?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual trabalho quase concluído poderia te ensinar sobre conclusão?"
          }
        }
      }
    },
    "practice.085.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поискай една конкретна критика, не обща похвала."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask for one specific criticism, not general approval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag nach einer konkreten Kritik, nicht nach allgemeiner Zustimmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide una crítica concreta, no una aprobación general."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande une critique précise, pas un simple « j'aime bien »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi una critica specifica, non un'approvazione generica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça uma crítica específica, não um elogio genérico."
          }
        }
      }
    },
