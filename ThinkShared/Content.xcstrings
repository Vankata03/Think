    "practice.036.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не търси нещата да стават по твоята воля."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begehre nicht, dass das Geschehende so eintritt, wie du es wünschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seek not that the things which happen should happen as you wish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No busques que las cosas que suceden pasen tal y como tú quieres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne cherche pas à ce que les choses qui arrivent se passent comme tu le souhaites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cercare che le cose che accadono avvengano come desideri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não busque que as coisas que acontecem aconteçam do jeito que você quer."
          }
        }
      }
    },
    "practice.036.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На каква реалност харчиш сили да се противиш?"
          }
        },
        "de": {
