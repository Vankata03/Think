          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve uma coisa que você precisaria aprender antes de ficar mais seguro."
          }
        }
      }
    },
    "path.clear-thinking.step.5.title": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A reversible choice"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Обратим избор"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine umkehrbare Entscheidung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una decisión reversible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un choix réversible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una scelta reversibile"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma escolha reversível"
          }
        }
      }
    },
    "path.clear-thinking.step.5.lesson": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Some decisions can be tested cheaply; others deserve more care. Name the cost and a way back before calling a choice reversible."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Някои решения могат да бъдат изпробвани евтино; други заслужават повече внимание. Назовете цената и пътя назад, преди да наречете един избор обратим."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Manche Entscheidungen lassen sich günstig testen; andere verdienen mehr Sorgfalt. Benenne die Kosten und einen Weg zurück, bevor du eine Entscheidung umkehrbar nennst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algunas decisiones se pueden probar a bajo coste; otras merecen más cuidado. Nombra el coste y una vía de vuelta antes de llamar reversible a una decisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certaines décisions peuvent être testées à peu de frais ; d'autres méritent plus de soin. Nommez le coût et un moyen de revenir en arrière avant de qualifier un choix de réversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcune decisioni si possono mettere alla prova a basso costo; altre meritano più attenzione. Indica il costo e una via di ritorno prima di definire una scelta reversibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algumas decisões podem ser testadas a baixo custo; outras merecem mais cuidado. Nomeie o custo e um caminho de volta antes de chamar uma escolha de reversível."
          }
        }
      }
    },
    "path.clear-thinking.step.5.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save one small decision, its possible cost, a way to undo it, and a date to review what happened."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете едно малко решение, възможната му цена, начин да го отмените и дата, на която да прегледате какво се е случило."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere eine kleine Entscheidung, ihre möglichen Kosten, einen Weg, sie rückgängig zu machen, und ein Datum, an dem du prüfst, was passiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda una decisión pequeña, su posible coste, una forma de deshacerla y una fecha para revisar qué pasó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez une petite décision, son coût possible, un moyen de l'annuler et une date pour revoir ce qui s'est passé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva una piccola decisione, il suo possibile costo, un modo per annullarla e una data per rivedere cosa è successo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve uma pequena decisão, seu possível custo, uma forma de desfazê-la e uma data para revisar o que aconteceu."
          }
        }
      }
    },
    "path.clear-thinking.step.5.smallerTask": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
