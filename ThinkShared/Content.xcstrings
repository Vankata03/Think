          "stringUnit": {
            "state": "needs_review",
            "value": "Belege, die deine Meinung ändern könnten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pruebas que podrían hacerte cambiar de opinión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Des preuves qui pourraient vous faire changer d'avis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prove che potrebbero farti cambiare idea"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Evidências que poderiam mudar sua opinião"
          }
        }
      }
    },
    "path.clear-thinking.step.4.lesson": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A belief is easier to update when you decide in advance what evidence would matter. Seek a source that could challenge you, and allow uncertainty."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Едно убеждение се променя по-лесно, когато предварително решите какви доказателства биха имали значение. Потърсете източник, който може да ви оспори, и допуснете несигурност."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Überzeugung lässt sich leichter anpassen, wenn du vorher festlegst, welche Belege zählen würden. Suche eine Quelle, die dich herausfordern könnte, und lass Unsicherheit zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una creencia es más fácil de actualizar cuando decides de antemano qué pruebas importarían. Busca una fuente que pueda cuestionarte y permítete la incertidumbre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une croyance est plus facile à réviser quand vous décidez à l'avance quelles preuves compteraient. Cherchez une source qui pourrait vous contredire, et acceptez l'incertitude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una convinzione è più facile da aggiornare quando decidi in anticipo quali prove conterebbero. Cerca una fonte che possa metterti in discussione e concediti l'incertezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma crença é mais fácil de atualizar quando você decide de antemão que evidência importaria. Procure uma fonte que possa desafiá-lo e permita a incerteza."
          }
        }
      }
    },
    "path.clear-thinking.step.4.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save one belief, one piece of evidence for it, and one finding that would make you reconsider it."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете едно убеждение, едно доказателство в негова полза и една констатация, която би ви накарала да го преосмислите."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere eine Überzeugung, einen Beleg dafür und eine Erkenntnis, die dich zum Umdenken bringen würde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda una creencia, una prueba a su favor y un hallazgo que te haría reconsiderarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez une croyance, une preuve en sa faveur et une découverte qui vous ferait la reconsidérer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva una convinzione, una prova a suo favore e una scoperta che ti farebbe riconsiderarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve uma crença, uma evidência a favor dela e uma descoberta que faria você reconsiderá-la."
          }
        }
      }
    },
    "path.clear-thinking.step.4.smallerTask": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save one thing you would need to learn before becoming more certain."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете едно нещо, което би трябвало да научите, преди да станете по-сигурни."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere eine Sache, die du lernen müsstest, bevor du sicherer wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda una cosa que necesitarías aprender antes de estar más seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez une chose que vous auriez besoin d'apprendre avant d'être plus sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
