        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which rule do you follow without remembering choosing it?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Regel befolgst du, ohne dich daran zu erinnern, sie gewählt zu haben?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué norma sigues sin recordar haberla elegido?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle règle suis-tu sans te souvenir de l'avoir choisie ?"
