    "practice.047.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Страхът да изглеждаш глупаво е погребал повече опити от самия провал."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angst, töricht auszusehen, hat mehr Übung begraben als jedes Scheitern es je konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fear of looking foolish has buried more practice than failure ever could."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El miedo al ridículo ha enterrado más práctica que el propio fracaso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La peur de passer pour un idiot a tué plus d'entraînement que l'échec n'aurait jamais pu le faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La paura del ridicolo ha sepolto più pratica del fallimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O medo de parecer bobo já impediu muito mais prática do que qualquer fracasso jamais poderia."
          }
        }
      }
    },
    "practice.047.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде пазиш образа си на компетентен, вместо да изграждаш истинско умение?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo schützt du Kompetenz, anstatt sie aufzubauen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you protecting competence instead of building it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué aspectos estás protegiendo la competencia en lugar de desarrollarla?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quels domaines tu te contentes de préserver tes compétences au lieu de les développer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In quali ambiti stai solo difendendo le tue competenze invece di svilupparle?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em que áreas você está apenas mantendo a competência em vez de desenvolvê-la?"
          }
        }
      }
    },
    "practice.048.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери едно малко, съзнателно неудобство в служба на важното."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine kleine, bewusste Unbequemlichkeit hinzu, die dem dient, was zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one small, deliberate discomfort that serves what matters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una pequeña incomodidad deliberada que te ayude a centrarte en lo que importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un petit inconfort délibéré qui sert l'essentiel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un piccolo, deliberato disagio che serva a ciò che conta davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um pequeno e deliberado desconforto que contribua para o que realmente importa."
          }
        }
      }
    },
