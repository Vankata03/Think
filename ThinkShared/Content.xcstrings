        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which private repetition is lowering your standard?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué repetición privada está bajando tu nivel?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle répétition intérieure te fait baisser la barre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
