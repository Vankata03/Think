    "practice.004.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато всичко е важно, удобството избира вместо теб."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn alles wichtig ist, entscheidet die Bequemlichkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When everything matters, convenience decides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando todo cuenta, la comodidad es lo que decide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tout compte, c'est la simplicité qui fait la différence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando tutto conta, è la praticità a fare la differenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando tudo importa, a praticidade faz a diferença."
          }
        }
      }
    },
    "practice.004.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво наистина заслужава най-добрия ти час днес?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was verdient heute wirklich deine beste Stunde?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What actually deserves your best hour today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es lo que realmente se merece tu mejor hora de hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui mérite vraiment que tu y consacres une heure aujourd'hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa merita davvero la tua ora migliore oggi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que realmente merece a sua melhor hora hoje?"
          }
        }
      }
    },
    "practice.005.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши по-точна мисъл и се връщай към нея, когато старата се появи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib einen treffenderen Gedanken auf und ruf ihn zurück, wenn der alte erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a more accurate thought and return to it when the old one appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un pensamiento más preciso y vuelve a él cuando te venga el anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris une pensée plus précise et reviens-y quand l'ancienne refait surface."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un pensiero più preciso e torna a leggerlo quando ti torna in mente quello vecchio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva um pensamento mais preciso e volte a ele quando o antigo aparecer."
          }
        }
      }
    },
