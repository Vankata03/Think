    "practice.065.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако работата е важна само когато някой гледа, огледай публиката."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Arbeit nur dann zählt, wenn andere zusehen – schau dir dein Publikum an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the work matters only when witnessed, inspect the audience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu trabajo solo tiene sentido cuando hay quien lo ve, fíjate bien en tu público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ton travail n'a de sens que s'il est vu par quelqu'un, observe bien ton public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo lavoro ha senso solo se qualcuno lo vede, valuta bene il tuo pubblico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o trabalho só faz sentido quando tem quem veja, dá uma olhada no público."
          }
        }
      }
    },
    "practice.065.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чията реакция е станала част от причината ти да правиш това?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wessen Reaktion ist Teil davon geworden, warum du das tust?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whose reaction has become part of your reason for doing this?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿La reacción de quién se ha convertido en parte de tu motivo para hacer esto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réaction de qui t'a poussé à faire ça ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La reazione di chi è diventata parte del motivo per cui lo fai?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reação de quem se tornou parte do motivo que te levou a fazer isso?"
          }
        }
      }
    },
    "practice.066.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи най-малката поправка, преди да обясняваш какво се е случило."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach den kleinsten Reparaturschritt, bevor du erklärst, was passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the smallest repair before explaining what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz la reparación más pequeña antes de explicar lo que ha pasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par faire la plus petite réparation avant d'expliquer ce qui s'est passé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai la piccola correzione prima di spiegare cosa è successo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o conserto mais básico antes de explicar o que aconteceu."
          }
        }
      }
    },
