    "practice.029.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това, което повтаряш насаме, се превръща в твоя публичен предел."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du im Verborgenen wiederholst, wird deine öffentliche Grenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you repeat in private becomes your public limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que repites en privado se convierte en tu límite público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu répètes en privé devient ta limite en public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che ripeti in privato diventa il tuo limite pubblico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você repete em particular vira o seu limite público."
          }
        }
      }
    },
    "practice.029.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое тайно повторение снижава стандарта ти?"
