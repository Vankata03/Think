    "practice.027.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мери завръщането, не отдалечаването."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss die Rückkehr, nicht die Abweichung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure the return, not the drift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide cuánto tardas en volver, no cuánto te desvías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure ton retour, pas ton écart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura il rendimento, non la deriva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede o retorno, não o desvio."
          }
        }
      }
    },
    "practice.027.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко бързо се връщаш, когато вниманието, настроението или рутината ти се разклатят?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie schnell kehrst du zurück, wenn Aufmerksamkeit, Stimmung oder Routine nachlässt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How quickly do you return after attention, mood, or routine slips?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto tardas en volver cuando se desvían tu atención, tu ánimo o tu rutina?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En combien de temps te remets-tu quand tu perds ta concentration, que ton humeur change ou que ta routine est perturbée ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ci metti a ritrovare la concentrazione, il buon umore o la routine quando ti capita di perderli?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que rapidez você volta ao normal depois que a atenção, o humor ou a rotina ficam meio fora de controle?"
          }
        }
      }
    },
    "practice.028.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промени едно условие, преди да дадеш ново обещание."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere eine Bedingung, bevor du ein weiteres Versprechen gibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change one condition before making another promise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia una condición antes de hacer otra promesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change une condition avant de faire une autre promesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia una condizione prima di fare un’altra promessa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude uma condição antes de fazer outra promessa."
          }
        }
      }
    },
