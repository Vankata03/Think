    "practice.002.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефонът не краде вниманието ти, докато е наблизо. Ти сам му го даваш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Handy stiehlt deine Aufmerksamkeit nicht, solange es in Reichweite liegt. Du leihst sie ihm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone is not stealing your attention while it remains within reach. You are lending it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El móvil no te roba la atención mientras lo tienes a mano. Se la estás prestando tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone ne te vole pas ton attention tant qu’il reste à portée de main. C’est toi qui la lui accordes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono non ti ruba l’attenzione finché rimane a portata di mano. Sei tu a concedergliela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular não está roubando sua atenção enquanto fica ao seu alcance. Você é que está emprestando-a a ele."
          }
        }
      }
    },
    "practice.002.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой момент днес най-много се нуждае от цялото ти присъствие?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Moment braucht heute deine volle Präsenz am meisten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which moment today most needs your full presence?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué momento de hoy necesita más tu plena atención?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel moment de cette journée a le plus besoin que tu y sois pleinement présent ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è il momento di oggi che richiede maggiormente la tua piena presenza?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual momento de hoje precisa mais da sua atenção total?"
          }
        }
      }
    },
    "practice.003.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Затвори го, планирай го или го изтрий в следващите пет минути."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledige es, terminiere es oder streiche es in den nächsten fünf Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close it, schedule it, or delete it in the next five minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciérrala, prográmala o bórrala en los próximos cinco minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme-la, programme-la ou supprime-la dans les cinq prochaines minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudila, imposta un promemoria o cancellala entro i prossimi cinque minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua, agende ou elimine essa pendência nos próximos cinco minutos."
          }
        }
      }
    },
