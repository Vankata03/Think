    "practice.068.v2.line": {
      "extractionState": "manual",
      "comment": "Editorial revision 2. Generated copy; editorial and translation review pending. v1 remains unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A small promise kept can help you trust yourself again."
          }
        },
        "bg": {
          "stringUnit": {
