    "practice.001.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдели десет минути за нещото, което искаш да присъства по-често в живота ти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schütze zehn Minuten für das, was du in deinem Leben mehr haben möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect ten minutes for the thing you want your life to contain more of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserva diez minutos para aquello de lo que quieres disfrutar más en tu vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réserve-toi dix minutes pour ce dont tu aimerais avoir davantage dans ta vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riservati dieci minuti per ciò che vorresti ci fosse di più nella tua vita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve dez minutos para aquilo que você quer que faça mais parte da sua vida."
          }
        }
      }
    },
