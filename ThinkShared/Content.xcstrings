    "practice.031.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "От нещата едни са в наша власт, а други не са."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von den Dingen sind einige in unserer Macht, andere nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of things some are in our power, and others are not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cosas que están en nuestras manos y otras que no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a des choses sur lesquelles on a le contrôle, et d'autres non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono cose che dipendono da noi e altre che invece no."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas coisas estão ao nosso alcance, outras não."
          }
        }
      }
    },
    "practice.031.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя част от днешния проблем наистина зависи от теб?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Teil des heutigen Problems liegt wirklich in deiner Hand?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which part of today's problem is actually yours to act on?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué parte del problema de hoy te corresponde realmente a ti resolver?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle partie du problème d'aujourd'hui te concerne vraiment et sur laquelle tu peux agir ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale parte del problema di oggi spetta davvero a te risolvere?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que parte do problema de hoje realmente cabe a você resolver?"
          }
        }
      }
    },
    "practice.032.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши един отговор, който би предприел, ако се случи — и спри да го репетираш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib eine Reaktion, die du wählen könntest, falls es eintritt – dann hör auf, es durchzuspielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write one response you could take if it happens, then stop rehearsing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una respuesta que podrías dar si eso pasara y, después, deja de ensayarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris une réponse que tu pourrais donner si ça arrivait, puis arrête de la répéter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi una risposta che potresti dare se dovesse succedere, poi smetti di ripeterla mentalmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva uma resposta que você poderia dar se isso acontecer e, depois, pare de ensaiá-la."
          }
        }
      }
    },
