    "practice.086.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Грешка, изучена веднъж, се изплаща с години."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mistake studied once can pay rent for years."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fehler, den man einmal analysiert hat, kann sich jahrelang auszahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un error que analices una vez puede pagarte el alquiler durante años."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur étudiée une fois peut rapporter pendant des années."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un errore studiato una volta può ripagarti per anni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
