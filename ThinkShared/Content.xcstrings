    "practice.034.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Замени една абсолютна дума — винаги, никога, съсипано — с точно описание."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze ein absolutes Wort – immer, nie, ruiniert – durch eine genaue Beschreibung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace one absolute word—always, never, ruined—with a precise description."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye una palabra absoluta —siempre, nunca, arruinado— por una descripción precisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace un mot absolu — « toujours », « jamais », « fichu » — par une description précise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci una parola assoluta — sempre, mai, rovinato — con una descrizione precisa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca uma palavra absoluta — sempre, nunca, arruinado — por uma descrição precisa."
          }
        }
      }
    },
