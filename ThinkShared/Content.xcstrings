    "path.deep-focus.name": {
      "comment": "Thinking path name.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дълбок фокус"
          }
        },
        "en": {
