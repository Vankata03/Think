    "practice.057.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Може би оптимизираш частта, която е най-лесна за измерване."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may be optimizing the part that is easiest to measure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielleicht optimierst du gerade den Teil, der am einfachsten zu messen ist."
          }
        },
