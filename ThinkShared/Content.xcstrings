    "practice.067.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чужда цел може да погълне собствения ти живот."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein geliehenes Ziel kann dein eigentliches Leben auffressen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A borrowed goal can consume an original life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objetivo que no es el tuyo puede acabar con tu vida auténtica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objectif qui n'est pas le tien peut te faire perdre de vue ta propre vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un obiettivo preso in prestito può consumare una vita autentica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um objetivo alheio pode consumir a vida que seria sua."
          }
        }
      }
    },
    "practice.067.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя цел звучи похвално, но не се усеща като твой избор?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Ziel klingt bewundernswert, aber fühlt sich nicht wirklich gewählt an?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which goal sounds admirable but does not feel chosen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué objetivo te parece admirable, pero no sientes que lo hayas elegido?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel objectif te semble louable, mais que tu n'as pas vraiment choisi ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale obiettivo ti sembra ammirevole ma non ti sembra quello giusto per te?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual objetivo parece admirável, mas não parece ter sido escolhido por você?"
          }
        }
      }
    },
    "practice.068.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи го достатъчно малко, за да го изпълниш преди края на деня."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte es klein genug, um es noch heute einzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it small enough to keep before the day ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazla lo bastante pequeña como para cumplirla antes de que acabe el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rends-la assez petite pour pouvoir la tenir avant la fin de la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendila abbastanza piccola da poterla mantenere entro fine giornata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma promessa pequena o bastante para cumprir antes do fim do dia."
          }
        }
      }
    },
