    "practice.051.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намери най-силния аргумент срещу него и го изложи честно."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the strongest evidence against it and summarize it fairly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde die stärksten Argumente dagegen und fasse sie fair zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca los argumentos más sólidos en contra y resúmelos de forma imparcial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve les arguments les plus solides contre elle et résume-les de manière impartiale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova le prove più convincenti a sfavore e riassumile in modo imparziale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre os argumentos mais fortes contra ele e resuma-os de forma imparcial."
          }
        }
      }
    },
