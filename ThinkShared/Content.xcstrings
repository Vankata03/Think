    "practice.082.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бележката не е урокът. Урокът е онова, което можеш да възстановиш от паметта."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note you take is not the lesson. The retrieval is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht die Notiz, die du machst, ist die Lektion. Sondern das Abrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo importante no es la nota que tomas, sino lo que recuerdas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas la note que tu prends qui compte, mais ce que tu en retiens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota che prendi non è la lezione. È il richiamo che conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você anota não é a lição. O que importa é o que você consegue lembrar."
          }
        }
      }
    },
    "practice.082.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво можеш да обясниш, без да отваряш отново източника?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What could you explain without reopening the source?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was könntest du erklären, ohne die Quelle erneut zu öffnen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué podrías explicar sin volver a abrir la fuente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que pourrais-tu expliquer sans rouvrir la source ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa potresti spiegare senza riaprire il codice sorgente?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você conseguiria explicar sem precisar reabrir a fonte?"
          }
        }
      }
    },
    "practice.083.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи един малък опит и запиши къде реалността се разминава с плана ти."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run one small trial and record where reality disagrees with your plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen kleinen Versuch und notiere, wo die Realität nicht mit deinem Plan übereinstimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pequeña prueba y anota en qué puntos la realidad no coincide con tu plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un petit test et note les moments où la réalité ne correspond pas à ton projet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un piccolo esperimento e prendi nota di dove la realtà non coincide con il tuo piano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um pequeno teste e anote onde a realidade não bate com o seu plano."
          }
        }
      }
    },
