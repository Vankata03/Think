    "practice.074.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чуй молбата под оплакването."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör auf die Bitte, die hinter der Klage steckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen for the request underneath the complaint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presta atención a la petición que se esconde tras la queja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie de déceler la demande qui se cache derrière la plainte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca di cogliere la richiesta che si nasconde dietro la lamentela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Presta atenção no que a pessoa realmente quer, por trás da reclamação."
          }
        }
      }
    },
    "practice.074.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "От какво може да се нуждае този човек, без да знае как да го поиска?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was könnte diese Person brauchen, aber nicht wissen, wie sie darum bittet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What might this person need but not know how to ask for?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué podría necesitar esta persona sin saber cómo pedirlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De quoi cette personne pourrait-elle avoir besoin sans savoir comment le demander ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di cosa potrebbe aver bisogno questa persona senza sapere come chiederlo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que essa pessoa pode estar precisando, mas não sabe como pedir?"
          }
        }
      }
    },
