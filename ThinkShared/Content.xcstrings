    "path.deep-focus.step.11.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Незатворен цикъл те преследва цяла вечер. Затвори го на хартия."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open loop follows you around all evening. Close it on paper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein offener Gedankengang begleitet dich den ganzen Abend lang. Bring ihn auf Papier zu Ende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pensamiento sin resolver te acompaña toda la noche. Ponle punto final en un papel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une boucle ouverte te suit tout au long de la soirée. Clôture-la sur papier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pensiero in sospeso ti accompagna per tutta la serata. Mettilo nero su bianco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pensamento em aberto te acompanha a noite toda. Anote-o no papel."
          }
        }
      }
    },
    "path.deep-focus.step.11.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приключи работния ден като запишеш първата задача за утре. Достатъчен е един ред."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End your workday by writing down tomorrow's first task. One line is enough."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende deinen Arbeitstag, indem du die erste Aufgabe für morgen aufschreibst. Eine Zeile reicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina tu jornada laboral anotando la primera tarea de mañana. Basta con una línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine ta journée de travail en notant la première tâche de demain. Une ligne suffit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concludi la tua giornata lavorativa annotando il primo compito di domani. Basta una riga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre seu dia de trabalho anotando a primeira tarefa de amanhã. Uma linha basta."
          }
        }
      }
    },
    "path.deep-focus.step.11.title": {
      "comment": "Thinking path step title.",
