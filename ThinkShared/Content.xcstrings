        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask before helping; rescue can be control wearing kindness."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag, bevor du hilfst; Hilfe kann Kontrolle sein, die sich als Freundlichkeit tarnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta antes de ayudar; el rescate puede convertirse en control disfrazado de amabilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande avant d’aider : secourir peut être du contrôle déguisé en gentillesse."
