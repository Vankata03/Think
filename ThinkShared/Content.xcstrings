    "path.deep-focus.step.18.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко да е залог върху бъдещото ти внимание. Пази го."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every yes is a claim on future attention. Guard it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes „Ja“ ist ein Anspruch auf zukünftige Aufmerksamkeit. Geh sorgsam damit um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada «sí» es una promesa de atención futura. Cuídalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque « oui » est un engagement pour l'avenir. Préserve-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni “sì” è una promessa di attenzione futura. Custodiscilo con cura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada “sim” é uma promessa de atenção futura. Cuida bem disso."
          }
        }
      }
    },
    "path.deep-focus.step.18.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Откажи днес една молба, покана или задача, която не заслужава вниманието ти."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline one request, invitation, or task today that doesn't deserve your focus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehne heute eine Anfrage, Einladung oder Aufgabe ab, die deine Aufmerksamkeit nicht verdient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy, rechaza una petición, una invitación o una tarea que no merezca tu atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuse aujourd’hui une demande, une invitation ou une tâche qui ne mérite pas que tu t’y consacres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi rifiuta una richiesta, un invito o un compito che non merita la tua attenzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuse hoje um pedido, convite ou tarefa que não mereça seu foco."
          }
        }
      }
    },
    "path.deep-focus.step.18.title": {
      "comment": "Thinking path step title.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кажи не веднъж"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say no once"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag einmal „Nein“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di «no» una vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis « non » une fois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di' di no una volta sola"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga “não” uma vez"
          }
        }
      }
    },
    "path.deep-focus.step.19.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това, което е крало вниманието ти тази седмица, ще го краде и следващата — ако не го назовеш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What pulled your attention this week will pull it next week — unless you name it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was diese Woche deine Aufmerksamkeit auf sich gezogen hat, wird sie auch nächste Woche auf sich ziehen – es sei denn, du benennst es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que te ha llamado la atención esta semana te la llamará también la semana que viene, a menos que le pongas nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui a retenu ton attention cette semaine la retiendra aussi la semaine prochaine — à moins que tu ne l'identifies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che ha attirato la tua attenzione questa settimana attirerà la tua attenzione anche la prossima — a meno che tu non gli dia un nome."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que chamou sua atenção essa semana vai chamar na próxima — a menos que você identifique o que é."
          }
        }
      }
    },
    "path.deep-focus.step.19.task": {
      "comment": "Concrete task for this path step.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдели 10 минути и запиши трите места, откъдето вниманието ти изтича най-много по този път."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 10 minutes writing down your three biggest attention leaks from this path so far."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir 10 Minuten Zeit und schreibe deine drei größten Aufmerksamkeitsfresser auf, die dir auf diesem Weg bisher aufgefallen sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 10 minutos a anotar las tres cosas que más te han distraído en este camino hasta ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends 10 minutes pour noter les trois principales sources de distraction que tu as rencontrées jusqu'à présent sur ce parcours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica 10 minuti a scrivere le tre cose che finora ti hanno distratto di più lungo questo percorso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve 10 minutos para anotar as três maiores distrações que você teve nessa jornada até agora."
          }
        }
      }
    },
