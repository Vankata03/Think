    "practice.030.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Почивката, която те възстановява, е тренировка. Бягството, което те вцепенява, праща сметка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholung, die dich stärkt, ist Training. Flucht, die betäubt, schickt die Rechnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest that restores you is training. Escape that numbs you sends an invoice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descanso que te recarga son los entrenamientos. La evasión que te adormece te pasa factura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repos qui te ressource, c'est l'entraînement. L'évasion qui t'engourdit, ça te coûte cher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riposo che ti rigenera è un allenamento. La fuga che ti intorpidisce ti manda il conto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O descanso que te revigora é um treino. A fuga que te entorpece te cobra uma conta."
          }
        }
      }
    },
    "practice.030.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какъв вид почивка те оставя по-отворен към живота?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Art von Ruhe macht dich dem Leben gegenüber offener?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which kind of rest leaves you more available to life?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tipo de descanso te deja más disponible para la vida?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel type de repos te permet d'être le plus à l'écoute de la vie ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale tipo di riposo ti rende più disponibile alla vita?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que tipo de descanso te deixa mais disponível para a vida?"
          }
        }
      }
    },
    "practice.031.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Начертай две колони — зависи от мен и не зависи от мен — после действай по един елемент от първата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh zwei Spalten – meins und nicht meins – und handle an einem Punkt aus der ersten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw two columns—mine and not mine—then act on one item from the first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz dos columnas —lo mío y lo que no es mío— y luego actúa sobre una cosa de la primera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais deux colonnes — « à moi » et « pas à moi » — puis passe à l'action sur un élément de la première colonne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna due colonne — “mio” e “non mio” — poi agisci su una cosa della prima colonna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça duas colunas — “meu” e “não meu” — e depois faça algo com um item da primeira coluna."
          }
        }
      }
    },
