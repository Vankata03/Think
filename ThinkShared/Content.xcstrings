    "practice.049.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Честният отговор обикновено се появява преди внушителния."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ehrliche Antwort erscheint meist vor der beeindruckenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The honest answer usually appears before the impressive one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta sincera suele aparecer antes que la más impresionante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse honnête vient souvent avant la réponse qui en met plein la vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta sincera di solito viene prima di quella che fa colpo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta sincera geralmente aparece antes da resposta que impressiona."
          }
        }
