    "practice.095.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Крайният срок не е единственото, което прави този момент краен."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deadline is not the only thing making this moment finite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Frist ist nicht das Einzige, was diesen Moment begrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha límite no es lo único que hace que este momento sea efímero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas seulement la date limite qui rend ce moment éphémère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scadenza non è l’unica cosa che rende questo momento limitato nel tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prazo não é a única coisa que torna esse momento finito."
          }
        }
      }
    },
    "practice.095.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво отлагаш, сякаш възможността е вечна?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are you postponing as if the opportunity were permanent?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was schiebst du auf, als ob die Gelegenheit ewig bestehen würde?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué estás posponiendo como si la oportunidad fuera a durar para siempre?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce que tu repousses comme si cette occasion allait durer éternellement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa stai rimandando come se l’occasione fosse eterna?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você tá adiando como se a oportunidade fosse durar pra sempre?"
          }
        }
      }
    },
    "practice.096.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери обещанието, което трябва да оцелее тази седмица."
          }
        },
        "en": {
          "stringUnit": {
