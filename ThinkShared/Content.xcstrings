    "practice.088.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновата е мястото, където вкусът спира да наблюдава отстрани."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft is where taste stops being a spectator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Entwurf hört der Geschmack auf, nur Zuschauer zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador es donde el gusto deja de ser un mero espectador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est dans le brouillon que le bon goût cesse d'être simple spectateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bozza è il momento in cui il gusto smette di essere uno spettatore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É no rascunho que o bom gosto deixa de ser apenas um espectador."
          }
        }
      }
    },
    "practice.088.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Каква преценка правиш, без да си произвел нещо за преценяване?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What judgment are you making without producing anything to judge?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Urteil fällst du, ohne etwas zu produzieren, das du beurteilen könntest?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué juicio estás haciendo sin producir nada que juzgar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel jugement tu portes sans rien produire à juger ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che giudizio stai dando senza produrre nulla su cui basarlo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que tipo de julgamento você está fazendo sem produzir nada para julgar?"
          }
        }
      }
    },
