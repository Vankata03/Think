    "practice.090.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Полезният въпрос обикновено е онзи, който променя работата — не онзи, с който показваш какво знаеш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The useful question is often the one that changes the work, not the one that displays knowledge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nützliche Frage ist oft die, die die Arbeit verändert, nicht die, die Wissen zur Schau stellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pregunta útil suele ser aquella que cambia el trabajo, no la que demuestra que sabes mucho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La question utile, c'est souvent celle qui fait évoluer le travail, pas celle qui montre qu'on sait des trucs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesso la domanda utile è quella che cambia il modo di lavorare, non quella che mette in mostra le conoscenze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pergunta útil geralmente é aquela que muda o trabalho, não aquela que mostra conhecimento."
          }
        }
      }
    },
    "practice.090.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
