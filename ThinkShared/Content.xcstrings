    "path.clear-thinking.step.1.title": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fact and story"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Факт и история"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fakt und Geschichte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hecho e historia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fait et récit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fatto e storia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fato e história"
          }
        }
      }
    },
    "path.clear-thinking.step.1.lesson": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fact describes something you could observe. A story adds an interpretation. Both can matter, but separating them makes a next step easier to choose."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фактът описва нещо, което бихте могли да наблюдавате. Историята добавя тълкуване. И двете може да са важни, но разделянето им улеснява избора на следваща стъпка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Fakt beschreibt etwas, das du beobachten könntest. Eine Geschichte fügt eine Deutung hinzu. Beides kann wichtig sein, doch die Trennung macht es leichter, einen nächsten Schritt zu wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un hecho describe algo que podrías observar. Una historia añade una interpretación. Ambos pueden importar, pero separarlos hace más fácil elegir el siguiente paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un fait décrit quelque chose que vous pourriez observer. Un récit y ajoute une interprétation. Les deux peuvent compter, mais les séparer rend le choix d'une prochaine étape plus facile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un fatto descrive qualcosa che potresti osservare. Una storia aggiunge un'interpretazione. Entrambi possono contare, ma separarli rende più facile scegliere il passo successivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um fato descreve algo que você poderia observar. Uma história acrescenta uma interpretação. Os dois podem importar, mas separá-los torna mais fácil escolher o próximo passo."
          }
        }
      }
    },
    "path.clear-thinking.step.1.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save a note with two headings: What happened and What I made it mean. Put one sentence under each."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете бележка с две заглавия: „Какво се случи“ и „Какво значение му придадох“. Напишете по едно изречение под всяко."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere eine Notiz mit zwei Überschriften: „Was passiert ist“ und „Was ich daraus gemacht habe“. Schreibe unter jede einen Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda una nota con dos encabezados: Qué pasó y Qué significado le di. Escribe una frase debajo de cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez une note avec deux titres : Ce qui s'est passé et Ce que j'en ai conclu. Écrivez une phrase sous chacun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva una nota con due titoli: Cosa è successo e Cosa ho pensato che significasse. Scrivi una frase sotto ciascuno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve uma nota com dois títulos: O que aconteceu e O que eu fiz isso significar. Escreva uma frase abaixo de cada um."
          }
        }
      }
    },
    "path.clear-thinking.step.1.smallerTask": {
      "extractionState": "manual",
