    },
    "practice.041.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво е нараснало в мислите ти, докато остава недокоснато?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist in deinem Kopf gewachsen, während es unangetastet blieb?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What has grown in your mind while remaining untouched?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué ha ido creciendo en tu mente sin que te dieras cuenta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui a mûri dans ton esprit tout en restant intact ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa è cresciuto nella tua mente pur rimanendo intatto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que cresceu na sua mente enquanto você não tocava nisso?"
          }
        }
      }
    },
    "practice.042.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши го простичко; после реши дали трябва да го изпратиш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib es klar heraus; entscheide später, ob du es schicken willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write it plainly; decide later whether it should be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe con sencillez; ya decidirás más tarde si lo envías o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris simplement ; tu décideras plus tard si tu veux l'envoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi in modo semplice; decidi dopo se inviarlo o meno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva de forma simples; decida depois se deve enviar ou não."
          }
        }
      }
    },
