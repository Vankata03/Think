    "path.deep-focus.step.10.lesson": {
      "comment": "Brief lesson for this path step.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дълбочината идва точно там, където обикновено спираш."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depth arrives around the point where you would usually stop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tiefe stellt sich ungefähr an der Stelle ein, an der du normalerweise aufhören würdest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La profundidad llega justo en el momento en el que normalmente te detendrías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La profondeur s'installe à peu près là où tu t'arrêterais d'habitude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La profondità arriva proprio nel momento in cui di solito ti fermeresti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A profundidade surge mais ou menos no ponto em que você normalmente pararia."
          }
        }
      }
    },
    "path.deep-focus.step.10.task": {
