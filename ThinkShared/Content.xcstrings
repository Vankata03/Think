    "practice.044.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имаш право да разочароваш версията на себе си, която е избрала зле."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst die Version von dir enttäuschen, die damals schlecht gewählt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are allowed to disappoint the version of you that chose badly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes derecho a decepcionar a esa versión de ti mismo que tomó malas decisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as le droit de décevoir la version de toi-même qui a fait de mauvais choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti è permesso deludere quella versione di te che ha fatto scelte sbagliate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem todo o direito de decepcionar aquela versão de si mesmo que fez escolhas erradas."
          }
        }
      }
    },
    "practice.044.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кой стар ангажимент оцелява само защото промяната изглежда непоследователна?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche alte Verpflichtung besteht nur noch, weil eine Änderung inkonsequent wirken würde?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which old commitment survives only because changing feels inconsistent?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué compromiso antiguo sigues manteniendo solo porque cambiar te parece incoherente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel ancien engagement subsiste uniquement parce que changer te semble incohérent ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale vecchio impegno sopravvive solo perché cambiare ti sembra incoerente?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual compromisso antigo só sobrevive porque mudar parece inconsistente?"
          }
        }
      }
    },
    "practice.045.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи една видима стъпка, без да съчиняваш оправдание за нея."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu einen sichtbaren Schritt, ohne ihn zu rechtfertigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take one visible step without writing a defense for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un paso concreto sin tener que justificarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un pas concret sans chercher à te justifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un passo concreto senza cercare di giustificarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá um passo concreto sem precisar justificar nada."
          }
        }
      }
    },
