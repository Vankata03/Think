    "practice.088.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновата е мястото, където вкусът спира да наблюдава отстрани."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft is where taste stops being a spectator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Entwurf hört der Geschmack auf, nur Zuschauer zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador es donde el gusto deja de ser un mero espectador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est dans le brouillon que le bon goût cesse d'être simple spectateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bozza è il momento in cui il gusto smette di essere uno spettatore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É no rascunho que o bom gosto deixa de ser apenas um espectador."
          }
