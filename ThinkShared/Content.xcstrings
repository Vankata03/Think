    },
    "practice.083.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи един малък опит и запиши къде реалността се разминава с плана ти."
