    "practice.038.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не се случва с човек, за което природата не го е подготвила да понесе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Menschen widerfährt nichts, was er von Natur aus nicht zu ertragen vermag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing happens to any man which he is not formed by nature to bear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A ningún hombre le ocurre nada que la naturaleza no le haya preparado para soportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’arrive rien à un homme qu’il ne soit pas capable de supporter par nature."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A nessun uomo capita nulla che la natura non lo abbia reso in grado di sopportare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada acontece a ninguém que a natureza não o tenha preparado para suportar."
          }
        }
      }
    },
    "practice.038.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое качество в теб вече е доказано от минала трудност?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Fähigkeit hat eine vergangene Schwierigkeit bereits in dir bewiesen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which capacity has a past difficulty already proven in you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué aspecto ya has demostrado haber superado una dificultad en el pasado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle capacité une difficulté passée a-t-elle déjà révélée en toi ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale tua capacità è già stata dimostrata da una difficoltà passata?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que capacidade uma dificuldade passada já provou que você tem?"
          }
        }
      }
    },
    "practice.039.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши правило и дата, на която имаш право да го преразгледаш."
          }
        },
        "de": {
          "stringUnit": {
