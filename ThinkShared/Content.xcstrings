    "practice.099.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преди да добавиш цел, реши на какво ще отделяш по-малко живот."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before adding a goal, decide what will receive less life."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du ein Ziel hinzufügst, überleg dir, worauf du in Zukunft weniger Zeit verwenden wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de añadir un objetivo, decide a qué vas a dedicar menos tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'ajouter un objectif, décide de ce à quoi tu vas consacrer moins de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di aggiungere un obiettivo, decidi a cosa dedicherai meno tempo."
