      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи една обратима стъпка, докато си все още несигурен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen umkehrbaren Schritt, auch wenn du noch unsicher bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take one reversible step while still uncertain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un paso reversible aunque aún tengas dudas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un pas réversible, même si tu es encore dans l’incertitude."
