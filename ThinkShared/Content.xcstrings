    "practice.068.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Самоуважението расте от доказателства, не от утвърждения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbstachtung wächst aus Beweisen, nicht aus Selbstbestätigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-respect grows from evidence, not affirmations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autoestima se construye a partir de hechos, no de afirmaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'estime de soi se construit à partir de faits concrets, pas d'affirmations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autostima nasce dall'evidenza, non dalle affermazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autoestima vem de fatos, não de afirmações."
          }
        }
      }
    },
    "practice.068.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое обещание би ти дало полезно доказателство днес?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Versprechen würde dir heute nützliche Beweise liefern?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What promise would give you useful evidence today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué promesa te aportaría algo útil hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle promesse te donnerait aujourd’hui des preuves concrètes ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale promessa ti darebbe oggi una prova concreta della sua utilità?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que promessa te daria uma prova útil hoje?"
          }
        }
      }
    },
    "practice.069.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Назови какво ще струва на характера ти, преди да решиш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenn den Preis für deinen Charakter, bevor du entscheidest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the cost in character before deciding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valora el coste en términos de carácter antes de decidirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évalue le coût en termes de personnalité avant de te décider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta bene il costo in termini di carattere prima di decidere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê nome ao custo para o seu caráter antes de decidir."
          }
        }
      }
    },
