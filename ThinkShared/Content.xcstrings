    "practice.051.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Най-силното ти убеждение заслужава най-строгата проверка."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your strongest belief deserves your strongest test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine festeste Überzeugung verdient deine härteste Prüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu convicción más firme merece tu prueba más dura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes convictions les plus fortes méritent d'être mises à rude épreuve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua convinzione più forte merita la prova più dura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua convicção mais forte merece o teste mais difícil."
          }
        }
      }
    },
    "practice.051.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое убеждение е достатъчно важно, за да рискуваш да го коригираш?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which belief is important enough to risk correcting?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Überzeugung ist wichtig genug, um das Risiko einzugehen, sie zu hinterfragen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué creencia es lo suficientemente importante como para arriesgarte a corregirla?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle conviction est suffisamment importante pour que tu prennes le risque de la remettre en question ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale convinzione è abbastanza importante da rischiare di correggerla?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual crença é importante o suficiente pra você se arriscar a corrigir?"
          }
        }
      }
    },
    "practice.052.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
