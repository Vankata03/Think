    "practice.011.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спри да говориш какъв трябва да бъде добрият човек — бъди такъв."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höre nicht mehr darüber, was ein guter Mensch sein sollte – sei einer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No longer talk at all about the kind of man that a good man ought to be, but be such."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hables más de qué tipo de hombre debería ser un buen hombre, sino sélo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête de parler de ce qu’est un homme bien, et sois-le, tout simplement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non parlare più di che tipo di uomo dovrebbe essere un uomo perbene, ma sii proprio così."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não fale mais sobre como um bom homem deve ser, mas seja assim."
          }
        }
      }
    },
    "practice.011.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Коя ценност си описвал по-често, отколкото си практикувал?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welchen Wert hast du öfter beschrieben als gelebt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which value have you described more often than you have practiced?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué valor has descrito más a menudo de lo que lo has puesto en práctica?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle valeur as-tu décrite plus souvent que tu ne l'as mise en pratique ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale valore hai descritto più spesso di quanto tu l’abbia messo in pratica?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual valor você já falou mais do que realmente colocou em prática?"
          }
        }
      }
    },
    "practice.012.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
