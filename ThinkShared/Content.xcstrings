    "practice.039.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Решение, което отваряш всеки ден, източва вниманието ти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Entscheidung, die du täglich neu aufrollst, ist ein Leck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A decision you revisit daily is a leak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisión que te planteas cada día es una fuga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une décision que tu remets en question tous les jours, c'est une fuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisione che rivedi ogni giorno è una perdita di tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma decisão que você revisa todo dia é um vazamento."
          }
        }
      }
    },
    "practice.039.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Кое вече взето решение продължава да поглъща вниманието ти?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche bereits getroffene Entscheidung frisst immer wieder neue Aufmerksamkeit?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which settled choice keeps consuming fresh attention?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué elección ya tomada sigue acaparando tu atención?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel choix, une fois arrêté, continue de retenir ton attention ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale scelta, una volta fatta, continua a richiedere sempre nuova attenzione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual escolha já definida continua exigindo atenção constante?"
          }
        }
      }
    },
    "practice.040.action": {
      "comment": "Concrete action paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери едно полезно действие, което пасва на деня, какъвто всъщност е."
