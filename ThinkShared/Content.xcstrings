          "stringUnit": {
            "state": "translated",
            "value": "A man then must stand erect, not be kept erect by others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hombre debe mantenerse erguido por sí mismo, sin que otros lo mantengan erguido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un homme doit donc se tenir droit, sans que ce soient les autres qui le maintiennent droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un uomo, quindi, deve stare dritto di sua spontanea volontà, senza che siano gli altri a tenerlo dritto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um homem deve, então, manter-se ereto, e não ser mantido ereto por outros."
          }
        }
      }
    },
    "practice.050.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Къде чакаш окуражение, преди да действаш?"
          }
