    "practice.041.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избягването превръща малки врати в стени."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeidung lässt kleine Türen wie Wände aussehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoidance makes small doors look like walls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La evasión hace que las puertas pequeñas parezcan muros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'évitement transforme les petites portes en murs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
