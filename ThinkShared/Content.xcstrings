    "practice.022.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Един пропуск е случайност. Два — вече е маршрут."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal aussetzen ist ein Ausrutscher. Zweimal gibt die Richtung vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing once is weather. Missing twice is a route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltártelo una vez es un episodio; dos veces empieza a marcar un rumbo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu rates une fois, c'est la météo. Si tu rates deux fois, c'est un itinéraire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sbagli una volta, è il meteo. Se sbagli due volte, è un percorso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falhar uma vez é tempo ruim. Duas vezes já viram rota."
          }
        }
      }
    },
