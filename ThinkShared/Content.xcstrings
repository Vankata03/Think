    "practice.100.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Завърши деня, като спестиш на сутринта едно решение."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the day by reducing tomorrow's first decision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende den Tag, indem du die erste Entscheidung für morgen vereinfachst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina el día simplificando la primera decisión de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine ta journée en simplifiant la première décision de demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concludi la giornata semplificando la prima decisione di domani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina o dia simplificando a primeira decisão de amanhã."
          }
        }
      }
    },
    "practice.100.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво можеш да решиш тази вечер, за да облекчиш утрешната сутрин?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What choice could your tired evening self make for your morning self?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Entscheidung könntest du heute Abend, wenn du müde bist, für dein Ich am Morgen treffen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué decisión podría tomar tu yo cansado de la noche para tu yo de la mañana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel choix ton « toi » fatigué du soir pourrait-il faire pour ton « toi » du matin ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale scelta potrebbe fare la versione di te stanca della sera per quella di te che si sveglia al mattino?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que escolha o seu “eu” cansado da noite poderia fazer pelo seu “eu” da manhã?"
          }
        }
      }
    },
    "practice.002.v2.line": {
