        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which moment today most needs your full presence?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué momento de hoy necesita más tu plena atención?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel moment de cette journée a le plus besoin que tu y sois pleinement présent ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è il momento di oggi che richiede maggiormente la tua piena presenza?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual momento de hoje precisa mais da sua atenção total?"
          }
        }
