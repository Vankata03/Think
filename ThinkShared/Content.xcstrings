    "practice.026.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тогава започни от малките неща."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
