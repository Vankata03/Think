    "practice.014.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако искаш нещо да стане навик — просто го прави."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du zur Gewohnheit machen willst: Tu es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generally then if you would make anything a habit, do it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En general, si quieres convertir algo en un hábito, hazlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En gros, si tu veux prendre une habitude, lance-toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In generale, quindi, se vuoi trasformare qualcosa in un’abitudine, fallo."
