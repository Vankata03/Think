          }
        }
      }
    },
    "path.clear-thinking.step.6.title": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A fair disagreement"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Честно несъгласие"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine faire Meinungsverschiedenheit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un desacuerdo justo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un désaccord équitable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un disaccordo leale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma discordância justa"
          }
        }
      }
    },
    "path.clear-thinking.step.6.lesson": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Understanding a view does not require agreement. A fair summary gives the other person a position they could recognize, without inventing their motives."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разбирането на една гледна точка не изисква съгласие. Честното обобщение дава на другия човек позиция, която би разпознал, без да измисля мотивите му."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Sichtweise zu verstehen erfordert keine Zustimmung. Eine faire Zusammenfassung gibt der anderen Person eine Position, die sie wiedererkennen könnte, ohne ihre Motive zu erfinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entender un punto de vista no exige estar de acuerdo. Un resumen justo le da a la otra persona una posición que podría reconocer, sin inventar sus motivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprendre un point de vue n'exige pas d'être d'accord. Un résumé équitable donne à l'autre personne une position qu'elle pourrait reconnaître, sans lui inventer des motivations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprendere un punto di vista non richiede di condividerlo. Un riassunto leale offre all'altra persona una posizione in cui potrebbe riconoscersi, senza inventarne i motivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entender um ponto de vista não exige concordar com ele. Um resumo justo dá à outra pessoa uma posição que ela poderia reconhecer, sem inventar seus motivos."
          }
        }
      }
    },
    "path.clear-thinking.step.6.task": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Save a fair three-sentence summary of a disagreement, then add one question you could ask with curiosity."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запазете честно обобщение на несъгласие в три изречения, след което добавете един въпрос, който бихте могли да зададете с любопитство."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichere eine faire Zusammenfassung einer Meinungsverschiedenheit in drei Sätzen und füge dann eine Frage hinzu, die du mit Neugier stellen könntest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda un resumen justo de un desacuerdo en tres frases y luego añade una pregunta que podrías hacer con curiosidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrez un résumé équitable d'un désaccord en trois phrases, puis ajoutez une question que vous pourriez poser avec curiosité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salva un riassunto leale di un disaccordo in tre frasi, poi aggiungi una domanda che potresti porre con curiosità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salve um resumo justo de uma discordância em três frases e depois acrescente uma pergunta que você poderia fazer com curiosidade."
          }
        }
      }
    },
    "path.clear-thinking.step.6.smallerTask": {
      "extractionState": "manual",
      "comment": "Generated path copy. Editorial and translation review pending. Estimates count active task time; breaks are additional.",
      "localizations": {
