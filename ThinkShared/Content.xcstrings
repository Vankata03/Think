    "practice.001.line": {
      "comment": "Daily practice line. Keep concise and provocative.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вниманието ти вече изгражда живота ти. Въпросът е дали ти избра какъв да бъде."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufmerksamkeit baut bereits ein Leben. Die Frage ist nur, ob du es so gewählt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your attention is already building a life. The only question is whether you chose the design."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu atención ya está dando forma a tu vida. La única pregunta es si tú has elegido cómo será."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton attention façonne déjà ta vie. Reste à savoir si tu en as choisi le plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua attenzione sta già dando forma alla tua vita. L’unica domanda è: hai scelto tu come sarà?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua atenção já está construindo uma vida. A questão é se foi você quem escolheu o projeto."
          }
        }
      }
    },
    "practice.001.question": {
      "comment": "Reflection question paired with the daily line.",
      "extractionState": "stale",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво изгради вниманието ти вчера?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hat deine Aufmerksamkeit gestern aufgebaut?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What did your attention build yesterday?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué te centraste ayer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui a retenu ton attention hier ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ha catturato la tua attenzione ieri?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que a sua atenção construiu ontem?"
          }
        }
      }
    },
    "practice.002.action": {
