    "Your day. %lld of 3 done. Now %@." : {
      "comment" : "VoiceOver label of the day arc: acts done, then the current time. Phrased with a colon so the count needs no plural agreement.",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Твоят ден. Готово: %lld от 3. Сега е %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Tag. Erledigt: %lld von 3. Jetzt %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu día. Hecho: %lld de 3. Ahora %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ta journée. Fait : %lld sur 3. Il est %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tua giornata. Fatto: %lld di 3. Ora %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seu dia. Feito: %lld de 3. Agora %@."
          }
        }
      }
    },
    "Your day: a question in the morning, a move by afternoon, a retro in the evening." : {
      "comment" : "VoiceOver label of the day arc drawn as a picture on onboarding.",
