    "Your Think practice streak, on the watch face.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поредицата ти в Think, на циферблата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Think-Serie auf dem Zifferblatt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha de uso de Think, en la esfera del reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta série de séances Think, affichée sur le cadran de ta montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua serie di sessioni consecutive su Think, sul quadrante dell’orologio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sequência de dias de uso do Think, no mostrador do relógio."
          }
        }
      }
